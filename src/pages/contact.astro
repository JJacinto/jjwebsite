---
import Base from '../layouts/Base.astro';
---
<Base
  activePage="contact"
  navDark={false}
  showCta={false}
  showFooter={true}
  disablePageParticles={true}
  title="Contact — João Jacinto"
  description="Get in touch with João Jacinto — Senior Product Designer based in Aveiro, Portugal."
>

  <section class="contact cta-footer-wrap" id="contact-section">
    <canvas class="cta-footer-bg" id="contact-canvas" aria-hidden="true"></canvas>
    <div class="contact-inner reveal">
      <h1>Let's talk about<br>what you're building.</h1>
      <p class="contact-body">Product partnerships, design system work, or 0→1 builds in the AI era.<br>Those are where I do my best work. If that sounds like your project, get in touch.</p>

      <div class="contact-ctas">
        <button class="btn btn-accent" id="compose-open" type="button" data-umami-event="contact-get-in-touch" onclick="openComposeModal(0)">
          <span class="btn-icon"><svg viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z"/></svg></span>
          <span>Get in touch</span>
        </button>
        <a class="btn btn-ghost" data-umami-event="contact-book-call" href="https://www.cal.eu/joao-jacinto" target="_blank" rel="noopener noreferrer">
          <span class="btn-icon"><svg viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h480q33 0 56.5 23.5T720-720v180l160-160v440L720-420v180q0 33-23.5 56.5T640-160H160Zm0-80h480v-480H160v480Zm0 0v-480 480Z"/></svg></span>
          <span>Book a call</span>
        </a>
      </div>
      <p class="contact-response-time">I usually reply within 24h to 48h on weekdays</p>

      <div class="contact-info">
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">Email</div>
            <div class="contact-card-value">contact@joaojacinto.com</div>
          </div>
          <button class="btn btn-ghost contact-card-btn" data-umami-event="contact-email-copy" onclick="copyEmail(this)" aria-label="Copy email address">
            <span class="btn-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></span>
            <span id="emailHint">Copy</span>
          </button>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label-row">
              <div class="contact-card-label">Location</div>
              <div class="contact-card-sub" id="aveiro-clock" aria-live="polite">—</div>
            </div>
            <div class="contact-card-value">Aveiro, Portugal</div>
          </div>
          <a class="btn btn-ghost contact-card-btn" data-umami-event="contact-view-map" href="https://www.google.com/maps/@40.6405,-8.6538,13z" target="_blank" rel="noopener noreferrer" aria-label="View Aveiro on Google Maps">
            <span class="btn-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <span>View map</span>
          </a>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">Socials</div>
            <div class="contact-card-value">LinkedIn · X</div>
          </div>
          <div class="contact-card-actions">
            <a class="btn btn-ghost contact-card-btn contact-card-btn--icon" data-umami-event="contact-social-linkedin" href="https://www.linkedin.com/in/joaofranciscojacinto/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/></svg>
            </a>
            <a class="btn btn-ghost contact-card-btn contact-card-btn--icon" data-umami-event="contact-social-x" href="https://x.com/joao_jacinto_8" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>

<script is:inline>
function copyEmail(el) {
  navigator.clipboard?.writeText('contact@joaojacinto.com').then(() => {
    const hint = document.getElementById('emailHint');
    if (!hint) return;
    /* Save innerHTML so the per-char .sc-wrap structure survives the
       swap. textContent would collapse it into doubled characters
       (CCooppyy) because of the c1/c2 layered spans. */
    const original = hint.innerHTML;
    hint.textContent = 'Copied!';
    setTimeout(() => { hint.innerHTML = original; }, 2000);
  });
}

/* Live Aveiro clock — refreshes every minute, aligned to wall clock. */
(function () {
  const el = document.getElementById('aveiro-clock');
  if (!el) return;
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Lisbon',
    hour: '2-digit', minute: '2-digit', hour12: false
  });
  function tick() { el.textContent = fmt.format(new Date()) + ' local time'; }
  tick();
  const msToNextMinute = (60 - new Date().getSeconds()) * 1000;
  setTimeout(function () {
    tick();
    setInterval(tick, 60000);
  }, msToNextMinute);
})();

</script>
