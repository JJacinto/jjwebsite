---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { versioned } from '../lib/script-url';
---
<Base
  activePage="contact"
  navDark={false}
  showCta={false}
  showFooter={true}
  disablePageParticles={true}
  footerInPage={true}
  title="Contact — João Jacinto"
  description="Get in touch with João Jacinto — Senior Product Designer based in Aveiro, Portugal."
  titlePt="Contacto — João Jacinto"
  descriptionPt="Fala com o João Jacinto — Senior Product Designer em Aveiro, Portugal."
>

  <section class="contact contact--with-footer cta-footer-wrap" id="contact-section" data-space-root>
    <canvas class="cta-footer-bg" id="contact-canvas" aria-hidden="true"></canvas>
    <canvas class="hero-space" data-hero-space data-space-auto aria-hidden="true"></canvas>
    <canvas class="contact-binary" aria-hidden="true"></canvas>
    <div class="contact-inner reveal">
      <h1 data-pt="Vamos falar sobre<br>o que andas a construir.">Let's talk about<br>what you're building.</h1>
      <p class="contact-body" data-pt="Faço o meu melhor trabalho onde a complexidade não se consegue eliminar. Conta-me onde o teu produto se complica.">I do my best work where the complexity can't be removed. Tell me where yours gets tangled.</p>

      <div class="contact-ctas">
        <button class="btn btn-accent" id="compose-open" type="button" data-umami-event="contact-get-in-touch" onclick="openComposeModal(0)">
          <span class="btn-icon"><svg viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z"/></svg></span>
          <span data-pt="Falar comigo">Get in touch</span>
        </button>
        <a class="btn btn-ghost" data-umami-event="contact-book-call" href="https://www.cal.eu/joao-jacinto" target="_blank" rel="noopener noreferrer">
          <span class="btn-icon"><svg viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h480q33 0 56.5 23.5T720-720v180l160-160v440L720-420v180q0 33-23.5 56.5T640-160H160Zm0-80h480v-480H160v480Zm0 0v-480 480Z"/></svg></span>
          <span data-pt="Marcar chamada">Book a call</span>
        </a>
      </div>

      <div class="contact-hours">
        <div class="contact-hours-pair">
          <span class="contact-hours-who"><canvas id="hours-planet-aveiro" width="78" height="78" aria-hidden="true"></canvas><span>Aveiro <b id="hours-time-aveiro">--:--</b></span></span>
          <span class="contact-hours-link" aria-hidden="true"></span>
          <span class="contact-hours-who"><span><b id="hours-time-you">--:--</b> <span data-pt="Tu">You</span></span><canvas id="hours-planet-you" width="78" height="78" aria-hidden="true"></canvas></span>
        </div>
        <p class="contact-hours-text" id="hours-text" aria-live="polite">I usually reply within a day or two on weekdays.</p>
      </div>

      <div class="contact-row">
        <span class="contact-row-email">contact@joaojacinto.com</span>
        <button class="btn btn-ghost contact-card-btn" data-umami-event="contact-email-copy" onclick="copyEmail(this)" aria-label="Copy email address" data-pt-aria-label="Copiar endereço de email">
          <span class="btn-icon">
            <svg class="copy-icon-default" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="copy-icon-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span id="emailHint" data-pt="Copiar">Copy</span>
        </button>
        <span class="contact-row-sep" aria-hidden="true"></span>
        <a class="btn btn-ghost contact-card-btn contact-card-btn--icon" data-umami-event="contact-social-linkedin" href="https://www.linkedin.com/in/joaofranciscojacinto/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/></svg>
        </a>
        <a class="btn btn-ghost contact-card-btn contact-card-btn--icon" data-umami-event="contact-social-x" href="https://x.com/joao_jacinto_8" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>
    </div>

    <div class="contact-readout" id="contact-readout" aria-hidden="true"></div>
    <Footer />
  </section>

</Base>

<script is:inline src={versioned('/scripts/contact-binary.js')} defer></script>
<script is:inline>
function copyEmail(el) {
  navigator.clipboard?.writeText('contact@joaojacinto.com').then(() => {
    const hint = document.getElementById('emailHint');
    if (!hint) return;
    /* Save innerHTML so the per-char .sc-wrap structure survives the
       swap. textContent would collapse it into doubled characters
       (CCooppyy) because of the c1/c2 layered spans. */
    const original = hint.innerHTML;
    hint.textContent = (window.jjLang && window.jjLang() === 'pt') ? 'Copiado!' : 'Copied!';
    /* Swap the copy SVG out for a checkmark for the same 2s window
       — the icon transition reinforces the success state alongside
       the label change. */
    const def = el.querySelector('.copy-icon-default');
    const ok  = el.querySelector('.copy-icon-success');
    if (def) def.style.display = 'none';
    if (ok)  ok.style.display  = '';
    setTimeout(() => {
      hint.innerHTML = original;
      if (def) def.style.display = '';
      if (ok)  ok.style.display  = 'none';
    }, 2000);
  });
}

/* Shared hours: two small planets lit by the Aveiro clock and the visitor's
   own clock, and one sentence that says when to expect a reply and how the
   two days overlap. It reads the visitor's timezone only, no location.
   Refreshes every minute, aligned to the wall clock. */
(function () {
  var elAveiro = document.getElementById('hours-time-aveiro');
  var elYou = document.getElementById('hours-time-you');
  var cvAveiro = document.getElementById('hours-planet-aveiro');
  var cvYou = document.getElementById('hours-planet-you');
  var elText = document.getElementById('hours-text');
  if (!elAveiro || !elYou || !elText) return;
  var parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Lisbon', weekday: 'short',
    hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
  });
  var isPt = function () { return !!(window.jjLang && window.jjLang() === 'pt'); };

  /* A small moon-phase disc: the lit side follows the hour of day. */
  function planet(pc, h, lit) {
    if (!pc || !pc.getContext) return;
    var cs = getComputedStyle(pc);
    var dark = cs.getPropertyValue('--planet-dark').trim() || '#2c2937';
    var rim = cs.getPropertyValue('--planet-rim').trim() || 'rgba(128,128,128,0.4)';
    var f = (1 + Math.cos(2 * Math.PI * (h - 12) / 24)) / 2;
    var c = pc.getContext('2d'), S = pc.width, r = S / 2 - 4;
    c.clearRect(0, 0, S, S); c.save(); c.translate(S / 2, S / 2);
    /* The night side and the rim are the lit colour, dimmed, so the disc
       reads on every theme without a surface token of its own. */
    c.beginPath(); c.arc(0, 0, r, 0, 6.2832); c.clip();
    c.fillStyle = lit; c.beginPath(); c.arc(0, 0, r, -Math.PI / 2, Math.PI / 2, h >= 12); c.fill();
    if (f <= 0.5) c.globalCompositeOperation = 'destination-out';
    c.beginPath(); c.ellipse(0, 0, Math.abs(1 - 2 * f) * r, r, 0, 0, 6.2832); c.fill();
    c.globalCompositeOperation = 'destination-over';
    c.globalAlpha = 0.2; c.beginPath(); c.arc(0, 0, r, 0, 6.2832); c.fill();
    c.restore();
    c.globalAlpha = 0.6; c.beginPath(); c.arc(S / 2, S / 2, r, 0, 6.2832); c.strokeStyle = lit; c.lineWidth = 2; c.stroke(); c.globalAlpha = 1;
  }
  function hhmm(m) { m = ((Math.round(m) % 1440) + 1440) % 1440; return ('0' + Math.floor(m / 60)).slice(-2) + ':' + ('0' + (m % 60)).slice(-2); }
  function token(el, name, fb) { return (el && getComputedStyle(el).getPropertyValue(name).trim()) || fb; }

  function tick() {
    var p = {};
    parts.formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
    var now = new Date();
    var lis = parseInt(p.hour, 10) * 60 + parseInt(p.minute, 10);
    var loc = now.getHours() * 60 + now.getMinutes();
    var diff = loc - lis; if (diff > 720) diff -= 1440; if (diff <= -720) diff += 1440;
    diff = Math.round(diff / 15) * 15;

    elAveiro.textContent = hhmm(lis);
    elYou.textContent = hhmm(loc);
    planet(cvAveiro, lis / 60, token(cvAveiro, '--planet-lit', '#9c9cf5'));
    planet(cvYou, loc / 60, token(cvYou, '--planet-lit', '#f0ede8'));

    var pt = isPt();
    var hour = parseInt(p.hour, 10), wd = p.weekday, weekend = wd === 'Sat' || wd === 'Sun', reply;
    if (hour >= 1 && hour < 9) reply = pt ? 'Estou a dormir, respondo de manhã.' : "I'm asleep, so I'll reply in the morning.";
    else if (weekend) reply = pt ? 'Aqui é fim de semana, por isso a resposta fica para segunda.' : "It's the weekend here, so expect a reply on Monday.";
    else if (hour >= 9 && hour < 18) reply = pt ? 'Estou a trabalhar, por isso deves ter resposta hoje.' : "I'm at my desk, so expect a reply today.";
    else if (wd === 'Fri') reply = pt ? 'Já fechei a semana, por isso a resposta fica para segunda.' : "I'm done for the week, so expect a reply on Monday.";
    else reply = pt ? 'Já acabei por hoje, por isso a resposta fica para amanhã.' : "I'm done for the day, so expect a reply tomorrow.";

    /* My desk hours (09:00 to 18:00 Aveiro) on the visitor's clock, cut to their 08:00 to 22:00. */
    var best = 0, bs = 0, be = 0;
    [-1440, 0, 1440].forEach(function (sh) {
      var s = Math.max(540 + diff + sh, 480), e = Math.min(1080 + diff + sh, 1320);
      if (e - s > best) { best = e - s; bs = s; be = e; }
    });
    var overlap;
    if (diff === 0) overlap = pt ? ' Estamos no mesmo fuso, e eu trabalho das 09:00 às 18:00.' : " We're on the same clock, and I'm at my desk from 09:00 to 18:00.";
    else if (best >= 30) overlap = pt ? ' Os nossos dias cruzam-se das ' + hhmm(bs) + ' às ' + hhmm(be) + ', na tua hora.' : ' Our days overlap from ' + hhmm(bs) + ' to ' + hhmm(be) + ' your time.';
    else overlap = pt ? ' Os nossos dias quase não se cruzam, por isso uma mensagem funciona melhor do que uma chamada.' : ' Our days barely overlap, so a message works better than a call.';
    elText.textContent = reply + overlap;
  }
  tick();
  document.addEventListener('jj:langchange', tick);
  /* The planets read their colours from the theme, so repaint when it changes. */
  if (window.MutationObserver) {
    new MutationObserver(tick).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-contrast'] });
  }
  var msToNextMinute = (60 - new Date().getSeconds()) * 1000;
  setTimeout(function () {
    tick();
    setInterval(tick, 60000);
  }, msToNextMinute);
})();

</script>
