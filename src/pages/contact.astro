---
import Base from '../layouts/Base.astro';
---
<Base
  activePage="contact"
  navDark={true}
  showFooter={false}
  title="Contact — João Jacinto"
  description="Get in touch with João Jacinto — Senior Product Designer based in Aveiro, Portugal."
>

  <section class="contact" id="contact-section">
    <canvas id="contact-canvas"></canvas>
    <div class="contact-inner reveal">
      <span class="eyebrow">Say hello</span>
      <h1>Thanks for<br>the visit.</h1>
      <div class="contact-subtitle">Let's make something<br>great together.</div>
      <p class="contact-body">Whether it's a product challenge, a collaboration, or just a good conversation — I'm always open to hearing from you.</p>

      <div class="contact-ctas">
        <a class="btn btn-accent" id="compose-open" href="mailto:contact@joaojacinto.com?subject=Hello">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12v9H2z"/><path d="M2 4l6 5 6-5"/></svg></span>
          <span>Send a message</span>
        </a>
        <a class="btn btn-dark-outline" id="contact-linkedin-btn" href="https://linkedin.com/in/joaofranciscojacinto/" target="_blank" rel="noopener noreferrer">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          <span>LinkedIn ↗</span>
        </a>
      </div>

      <div class="contact-info">
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">Email</div>
            <div class="contact-card-value">contact@joaojacinto.com</div>
          </div>
          <button class="contact-card-action" onclick="copyEmail(this)" aria-label="Copy email address">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span id="emailHint">Copy</span>
          </button>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">LinkedIn</div>
            <div class="contact-card-value">joaofranciscojacinto</div>
          </div>
          <a class="contact-card-action" href="https://linkedin.com/in/joaofranciscojacinto/" target="_blank" rel="noopener noreferrer" aria-label="Open LinkedIn profile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            <span>Open</span>
          </a>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label-row">
              <div class="contact-card-label">Location</div>
              <div class="contact-card-sub">UTC+0/+1</div>
            </div>
            <div class="contact-card-value">Aveiro, Portugal</div>
          </div>
          <a class="contact-card-action" href="https://www.google.com/maps/@40.6405,-8.6538,13z" target="_blank" rel="noopener noreferrer" aria-label="View Aveiro on Google Maps">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>View map</span>
          </a>
        </div>
      </div>
    </div>
    <div id="compose-root"></div>
  </section>

</Base>

<script is:inline>
function copyEmail(el) {
  navigator.clipboard?.writeText('contact@joaojacinto.com').then(() => {
    const hint = document.getElementById('emailHint');
    if (!hint) return;
    const original = hint.textContent;
    hint.textContent = 'Copied!';
    setTimeout(() => { hint.textContent = original; }, 2000);
  });
}

/* Constellation canvas */
const CONTACT_MODES = [
  { name:'sphere',    rotSpeed: 0.00025, rotDir: 1,  lumBase:20, lumRange:18, wobble:false },
  { name:'disc',      rotSpeed: 0.00060, rotDir: 1,  lumBase:26, lumRange:26, wobble:false },
  { name:'scatter',   rotSpeed: 0.00008, rotDir: 1,  lumBase:13, lumRange:11, wobble:false },
  { name:'dense',     rotSpeed: 0.00180, rotDir: 1,  lumBase:34, lumRange:38, wobble:false },
  { name:'torus',     rotSpeed: 0.00040, rotDir: 1,  lumBase:18, lumRange:20, wobble:true  },
  { name:'expanded',  rotSpeed: 0.00015, rotDir:-1,  lumBase:11, lumRange: 8, wobble:false },
  { name:'elongated', rotSpeed: 0.00055, rotDir: 1,  lumBase:24, lumRange:30, wobble:false },
];
let _contactRAF = null;

(function initContactCanvas() {
  const canvas = document.getElementById('contact-canvas');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  let W, H, dpr;

  function resize() {
    dpr = window.devicePixelRatio || 1;
    W = canvas.offsetWidth; H = canvas.offsetHeight;
    canvas.width  = W * dpr; canvas.height = H * dpr;
    ctx.scale(dpr, dpr);
  }
  resize();

  const onResize = () => { ctx.setTransform(1,0,0,1,0,0); resize(); };
  window.addEventListener('resize', onResize);

  const R = Math.min(window.innerHeight * 0.40, window.innerWidth * 0.32, 280);

  const s = {
    mouseX:-999, mouseY:-999, prevMX:0, prevMY:0,
    velX:0, velY:0, smoothVX:0, smoothVY:0,
    rotX:0.28, rotY:0, rotVX:0, rotVY:0.0001,
    t:0, ripples:[], modeIdx:0,
    hoverColorProgress:0, hoverCR:61, hoverCG:61, hoverCB:181, hoverColor:null,
    targetRotSpeed:0.00025, currentRotSpeed:0.00025,
    targetLumBase:20, currentLumBase:20,
    targetLumRange:18, currentLumRange:18,
    wobble:false,
  };

  const N = 380;
  const pts = Array.from({ length: N }, (_, i) => {
    const theta = Math.acos(1 - 2*(i+0.5)/N);
    const phi   = Math.PI*(1+Math.sqrt(5))*i;
    const jT = (Math.random()-0.5)*0.55;
    const jP = (Math.random()-0.5)*0.9;
    const rr = R * (0.55 + Math.random()*0.75);
    const tt = Math.max(0.05, Math.min(Math.PI-0.05, theta+jT));
    const ox = rr*Math.sin(tt)*Math.cos(phi+jP);
    const oy = rr*Math.sin(tt)*Math.sin(phi+jP);
    const oz = rr*Math.cos(tt);
    const ta = phi % (Math.PI*2), torusR = R*0.80, tubeR = R*0.38;
    return {
      ox,oy,oz, sx:ox, sy:oy, sz:oz,
      scX:(Math.random()-0.5)*R*2.4, scY:(Math.random()-0.5)*R*2.4, scZ:(Math.random()-0.5)*R*2.4,
      toX:(torusR+tubeR*Math.cos(theta))*Math.cos(ta),
      toY:tubeR*Math.sin(theta),
      toZ:(torusR+tubeR*Math.cos(theta))*Math.sin(ta),
      dotR:0.9+Math.random()*1.1,
      twinkle:Math.random()*Math.PI*2, twinkleSpeed:0.012+Math.random()*0.022,
      dispR:0, dispV:0,
      lerpSpeed:0.018+Math.random()*0.018,
      _tx:ox, _ty:oy, _tz:oz,
    };
  });

  function getTarget(p, mode) {
    if (mode==='disc')     return [p.ox*1.1,  p.oy*0.10, p.oz*1.1];
    if (mode==='scatter')  return [p.scX*0.7, p.scY*0.7, p.scZ*0.7];
    if (mode==='dense')    return [p.ox*0.38, p.oy*0.38, p.oz*0.38];
    if (mode==='torus')    return [p.toX,     p.toY,     p.toZ];
    if (mode==='expanded') return [p.ox*1.75, p.oy*1.75, p.oz*1.75];
    if (mode==='elongated')return [p.ox*1.2,  p.oy*0.22, p.oz*1.2];
    return [p.ox, p.oy, p.oz];
  }

  function triggerMode(cx2, cy2) {
    let next;
    do { next = Math.floor(Math.random()*CONTACT_MODES.length); }
    while (next === s.modeIdx && CONTACT_MODES.length > 1);
    s.modeIdx = next;
    const m = CONTACT_MODES[next];
    s.targetRotSpeed = m.rotSpeed * m.rotDir;
    s.targetLumBase  = m.lumBase;
    s.targetLumRange = m.lumRange;
    s.wobble = m.wobble;
    pts.forEach(p => { const [tx,ty,tz]=getTarget(p,m.name); p._tx=tx; p._ty=ty; p._tz=tz; });
    if (cx2 !== undefined) {
      s.ripples.push({ sx:cx2, sy:cy2, t:0 });
      if (s.ripples.length > 3) s.ripples.shift();
    }
  }

  const onMouseMove = (e) => {
    const rect = canvas.getBoundingClientRect();
    s.velX = (e.clientX-rect.left) - s.prevMX;
    s.velY = (e.clientY-rect.top)  - s.prevMY;
    s.prevMX = e.clientX-rect.left;
    s.prevMY = e.clientY-rect.top;
    s.mouseX = e.clientX-rect.left;
    s.mouseY = e.clientY-rect.top;
  };
  window.addEventListener('mousemove', onMouseMove);

  const contactSection = document.getElementById('contact-section');
  const onPageClick = (e) => {
    const rect = canvas.getBoundingClientRect();
    triggerMode(e.clientX-rect.left, e.clientY-rect.top);
  };
  if (contactSection) contactSection.addEventListener('click', onPageClick);

  const emailBtn = document.getElementById('compose-open');
  const linkedinBtn = document.getElementById('contact-linkedin-btn');
  if (emailBtn) {
    emailBtn.addEventListener('mouseenter', () => { s.hoverColor={cr:61,cg:61,cb:181}; triggerMode(); });
    emailBtn.addEventListener('mouseleave', () => { s.hoverColor=null; triggerMode(); });
  }
  if (linkedinBtn) {
    linkedinBtn.addEventListener('mouseenter', () => { s.hoverColor={cr:240,cg:237,cb:232}; triggerMode(); });
    linkedinBtn.addEventListener('mouseleave', () => { s.hoverColor=null; triggerMode(); });
  }

  function rotXY(px,py,pz,rx,ry) {
    const y1=py*Math.cos(rx)-pz*Math.sin(rx), z1=py*Math.sin(rx)+pz*Math.cos(rx);
    const x2=px*Math.cos(ry)+z1*Math.sin(ry), z2=-px*Math.sin(ry)+z1*Math.cos(ry);
    return [x2,y1,z2];
  }
  function project(x,y,z,cx,cy) { const sc=420/(420+z); return [cx+x*sc, cy+y*sc, sc]; }

  const RS=0.65, RW=120, RM=320, RA=7;

  function draw() {
    ctx.clearRect(0,0,W,H);
    const cx=W*0.50, cy=H*0.50;
    s.t++;

    s.currentRotSpeed += (s.targetRotSpeed-s.currentRotSpeed)*0.012;
    s.currentLumBase  += (s.targetLumBase-s.currentLumBase)*0.018;
    s.currentLumRange += (s.targetLumRange-s.currentLumRange)*0.018;

    s.smoothVX = s.smoothVX*0.94 + s.velX*0.06;
    s.smoothVY = s.smoothVY*0.94 + s.velY*0.06;
    s.velX*=0.8; s.velY*=0.8;
    s.rotVX += s.smoothVX*0.0000015; s.rotVY += s.smoothVY*0.0000015;
    s.rotVX*=0.986; s.rotVY*=0.986;
    s.rotY += s.currentRotSpeed + s.rotVY;
    s.rotX += s.rotVX;
    if (s.mouseX>0) s.rotX += (((s.mouseY/Math.max(H,1))-0.5)*0.55 - s.rotX)*0.0025;
    if (s.wobble) s.rotX += Math.sin(s.t*0.018)*0.0008;

    s.ripples = s.ripples.filter(r=>r.t<RM);
    s.ripples.forEach(r=>r.t++);

    if (s.hoverColor) {
      s.hoverColorProgress = Math.min(1, s.hoverColorProgress+0.022);
      s.hoverCR=s.hoverColor.cr; s.hoverCG=s.hoverColor.cg; s.hoverCB=s.hoverColor.cb;
    } else {
      s.hoverColorProgress = Math.max(0, s.hoverColorProgress-0.018);
    }

    pts.forEach(p => {
      p.sx += (p._tx-p.sx)*p.lerpSpeed;
      p.sy += (p._ty-p.sy)*p.lerpSpeed;
      p.sz += (p._tz-p.sz)*p.lerpSpeed;
      p.dispV*=0.88; p.dispR=p.dispR*0.88+p.dispV;
      p.twinkle+=p.twinkleSpeed;
    });

    const proj = pts.map((p,pi) => {
      const len=Math.sqrt(p.sx*p.sx+p.sy*p.sy+p.sz*p.sz)||1;
      const wx=p.sx+p.sx/len*p.dispR, wy=p.sy+p.sy/len*p.dispR, wz=p.sz+p.sz/len*p.dispR;
      const [rx,ry,rz]=rotXY(wx,wy,wz,s.rotX,s.rotY);
      const [sx2,sy2,sc]=project(rx,ry,rz,cx,cy);
      const depth=Math.max(0,(sc-0.55)/0.9);
      return { sx:sx2, sy:sy2, sc, depth, alpha:0.22+depth*0.52+Math.sin(p.twinkle)*0.10,
               r:p.dotR*(0.35+depth*0.65)*sc, rz, pi };
    });

    s.ripples.forEach(rpl => {
      const wf=rpl.t*RS, decay=Math.pow(1-rpl.t/RM,1.8);
      proj.forEach(p => {
        const dx=p.sx-rpl.sx, dy=p.sy-rpl.sy, dist=Math.sqrt(dx*dx+dy*dy);
        const diff=dist-wf;
        if (Math.abs(diff)<RW) { pts[p.pi].dispV += Math.cos(diff/RW*Math.PI*0.5)*RA*decay*0.04; }
      });
    });

    if (!s.hoverColor) {
      for (let i=0;i<proj.length;i++) for (let j=i+1;j<proj.length;j++) {
        const dx=proj[i].sx-proj[j].sx, dy=proj[i].sy-proj[j].sy, d2=dx*dx+dy*dy;
        if (d2<68*68) {
          const prog=1-Math.sqrt(d2)/68, da=(proj[i].depth+proj[j].depth)*0.5;
          ctx.beginPath(); ctx.moveTo(proj[i].sx,proj[i].sy); ctx.lineTo(proj[j].sx,proj[j].sy);
          ctx.strokeStyle=`rgba(100,100,100,${prog*da*0.035})`; ctx.lineWidth=0.5; ctx.stroke();
        }
      }
    }

    [...proj].sort((a,b)=>a.rz-b.rz).forEach(p => {
      if (p.r<0.3||p.alpha<0.03) return;
      const lum=Math.round(s.currentLumBase+p.depth*s.currentLumRange);
      let cr=lum, cg=lum, cb=lum;
      if (s.hoverColorProgress>0) {
        const hp=s.hoverColorProgress;
        cr=Math.round(lum+(s.hoverCR-lum)*hp);
        cg=Math.round(lum+(s.hoverCG-lum)*hp);
        cb=Math.round(lum+(s.hoverCB-lum)*hp);
      }
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, Math.max(0.1,Math.min(p.r,2.6)), 0, Math.PI*2);
      ctx.fillStyle=`rgba(${cr},${cg},${cb},${p.alpha})`;
      ctx.fill();
    });

    const g=Math.round(s.hoverColorProgress*12);
    canvas.style.filter = g>0 ? `drop-shadow(0 0 ${g}px rgba(${s.hoverCR},${s.hoverCG},${s.hoverCB},0.35))` : '';

    _contactRAF = requestAnimationFrame(draw);
  }

  draw();
})();

/* Compose modal */
(function () {
  const INTENTS = [
    {
      label: 'Custom message',
      subject: 'Hello João',
      body: 'Hi João,\n\n[your message]\n\nThanks,\n'
    },
    {
      label: 'Ask for a code review',
      subject: 'Code review request',
      body: "Hi João,\n\nI'm working on [project] and would value a fresh pair of eyes. Specifically, I'd love your read on:\n\n– [thing 1]\n– [thing 2]\n\nRepo / Figma: [link]\n\nThanks,\n"
    },
    {
      label: 'Mentor me',
      subject: 'Mentorship — quick intro',
      body: "Hi João,\n\nI'm a [role / years of experience] working on [domain]. I've been following your work on [thing] and would love 30 minutes to ask you about [specific question].\n\nHappy to work around your schedule.\n\nThanks,\n"
    },
    {
      label: 'Work together',
      subject: "Project — let's talk",
      body: "Hi João,\n\nWe're building [product / company] and are looking for help with [problem]. Timeline: [when]. Budget range: [if known].\n\nWould you be open to a short call?\n\nThanks,\n"
    },
    {
      label: 'Just saying hi',
      subject: 'Hello from [your name]',
      body: 'Hi João,\n\nFound your site via [where]. Wanted to say [thing you wanted to say]. No agenda — just appreciated the work.\n\n'
    }
  ];

  let mounted   = false;
  let intentIdx = 0;
  let dirtySubj = false;
  let dirtyBody = false;

  const autoGrow = (el) => {
    if (!el) return;
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 264) + 'px';
  };

  const updateSendLabel = () => {
    const btn  = document.getElementById('compose-send');
    const subj = document.getElementById('compose-subject');
    if (btn && subj) btn.setAttribute('aria-label', `Open in email — ${subj.value}`);
  };

  const applyIntent = (idx) => {
    const { subject, body } = INTENTS[idx];
    const subjEl = document.getElementById('compose-subject');
    const bodyEl = document.getElementById('compose-body');
    if (!dirtySubj && subjEl) subjEl.value = subject;
    if (!dirtyBody && bodyEl) { bodyEl.value = body; autoGrow(bodyEl); }
    updateSendLabel();
  };

  const buildMailto = () => {
    const subj = document.getElementById('compose-subject')?.value ?? '';
    const body = document.getElementById('compose-body')?.value ?? '';
    const addr = ['contact', '\x40', 'joaojacinto.com'].join('');
    return `mailto:${addr}?subject=${encodeURIComponent(subj)}&body=${encodeURIComponent(body)}`;
  };

  const getHTML = () => {
    const chipsHTML = INTENTS.map((intent, i) =>
      `<button class="intent-chip" role="radio" aria-checked="${i === 0 ? 'true' : 'false'}" tabindex="${i === 0 ? 0 : -1}" data-idx="${i}" type="button">${intent.label}</button>`
    ).join('');
    return `
<div class="compose-backdrop" id="compose-backdrop" role="presentation" aria-hidden="true">
  <div class="compose-modal" id="compose-modal" role="dialog" aria-modal="true"
       aria-labelledby="compose-heading" aria-describedby="compose-eyebrow">
    <div class="compose-header">
      <span class="eyebrow" id="compose-eyebrow">Compose a message</span>
      <h2 id="compose-heading">What brings you here?</h2>
    </div>
    <div class="intent-chips" role="radiogroup" aria-label="Message intent">${chipsHTML}</div>
    <div class="compose-field">
      <div class="compose-field-label-row">
        <label class="eyebrow" for="compose-subject">Subject</label>
        <button class="compose-reset" id="reset-subject" type="button" aria-label="Reset subject to template">Reset to template</button>
      </div>
      <input class="compose-input" id="compose-subject" type="text" autocomplete="off" value="">
    </div>
    <div class="compose-field">
      <div class="compose-field-label-row">
        <label class="eyebrow" for="compose-body">Message</label>
        <button class="compose-reset" id="reset-body" type="button" aria-label="Reset message to template">Reset to template</button>
      </div>
      <textarea class="compose-textarea" id="compose-body" rows="6" autocomplete="off"></textarea>
    </div>
    <div class="compose-footer">
      <p class="compose-caption">Opens in your email client. No data leaves this page until you hit send in your inbox.</p>
      <div class="compose-footer-actions">
        <button class="btn btn-dark-outline" id="compose-cancel" type="button"><span>Cancel</span></button>
        <button class="btn btn-accent" id="compose-send" type="button" aria-label="Open in email">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12v9H2z"/><path d="M2 4l6 5 6-5"/></svg></span>
          <span>Open in email</span>
        </button>
      </div>
    </div>
  </div>
</div>`;
  };

  const closeModal = () => {
    const bd = document.getElementById('compose-backdrop');
    if (!bd) return;
    bd.classList.remove('is-open');
    bd.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    document.getElementById('compose-open')?.focus();
  };

  const bindEvents = () => {
    const bd       = document.getElementById('compose-backdrop');
    const modal    = document.getElementById('compose-modal');
    const chips    = Array.from(document.querySelectorAll('.intent-chip'));
    const subjEl   = document.getElementById('compose-subject');
    const bodyEl   = document.getElementById('compose-body');
    const resetS   = document.getElementById('reset-subject');
    const resetB   = document.getElementById('reset-body');
    const cancelBtn = document.getElementById('compose-cancel');
    const sendBtn  = document.getElementById('compose-send');

    applyIntent(0);
    autoGrow(bodyEl);

    bd.addEventListener('click', (e) => { if (e.target === bd) closeModal(); });

    const selectIntent = (idx) => {
      intentIdx = idx;
      chips.forEach((c, i) => {
        c.setAttribute('aria-checked', String(i === idx));
        c.setAttribute('tabindex', i === idx ? '0' : '-1');
      });
      applyIntent(idx);
    };

    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => selectIntent(i));
      chip.addEventListener('keydown', (e) => {
        const len = chips.length;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = (i + 1) % len;
          selectIntent(next); chips[next].focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = (i - 1 + len) % len;
          selectIntent(prev); chips[prev].focus();
        }
      });
    });

    subjEl.addEventListener('input', () => {
      dirtySubj = true;
      resetS.classList.add('is-visible');
      updateSendLabel();
    });

    bodyEl.addEventListener('input', () => {
      dirtyBody = true;
      resetB.classList.add('is-visible');
      autoGrow(bodyEl);
    });

    resetS.addEventListener('click', () => {
      subjEl.value = INTENTS[intentIdx].subject;
      dirtySubj = false;
      resetS.classList.remove('is-visible');
      updateSendLabel();
      subjEl.focus();
    });

    resetB.addEventListener('click', () => {
      bodyEl.value = INTENTS[intentIdx].body;
      dirtyBody = false;
      resetB.classList.remove('is-visible');
      autoGrow(bodyEl);
      bodyEl.focus();
    });

    cancelBtn.addEventListener('click', closeModal);
    sendBtn.addEventListener('click', () => { window.location.href = buildMailto(); });

    const getFocusable = () => Array.from(
      modal.querySelectorAll('button:not([disabled]):not([tabindex="-1"]), input, textarea')
    ).filter(el => getComputedStyle(el).display !== 'none');

    modal.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { closeModal(); return; }
      if (e.key !== 'Tab') return;
      const focusable = getFocusable();
      if (!focusable.length) return;
      const first = focusable[0], last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
  };

  const openModal = () => {
    if (!mounted) {
      const root = document.getElementById('compose-root');
      if (!root) return;
      root.innerHTML = getHTML();
      mounted = true;
      bindEvents();
    }
    const bd = document.getElementById('compose-backdrop');
    if (!bd) return;
    bd.removeAttribute('aria-hidden');
    bd.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    bd.querySelector('.intent-chip[aria-checked="true"]')?.focus();
  };

  document.getElementById('compose-open')?.addEventListener('click', (e) => {
    e.preventDefault();
    openModal();
  });
}());
</script>
