---
import Base from '../layouts/Base.astro';
---
<Base
  activePage="contact"
  navDark={true}
  showCta={false}
  showFooter={true}
  title="Contact — João Jacinto"
  description="Get in touch with João Jacinto — Senior Product Designer based in Aveiro, Portugal."
>

  <section class="contact" id="contact-section">
    <canvas id="contact-canvas"></canvas>
    <div class="contact-inner reveal">
      <h1>Let's talk about<br>what you're building.</h1>
      <p class="contact-body">Product partnerships, design system work, or 0→1 builds in the AI era.<br>Those are where I do my best work. If that sounds like your project, get in touch.</p>

      <div class="contact-ctas">
        <button class="btn btn-accent" id="compose-open" type="button" onclick="openComposeModal(0)">
          <span class="btn-icon"><svg viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z"/></svg></span>
          <span>Get in touch</span>
        </button>
        <a class="btn btn-dark-outline" href="https://www.cal.eu/joao-jacinto" target="_blank" rel="noopener noreferrer">
          <span class="btn-icon"><svg viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h480q33 0 56.5 23.5T720-720v180l160-160v440L720-420v180q0 33-23.5 56.5T640-160H160Zm0-80h480v-480H160v480Zm0 0v-480 480Z"/></svg></span>
          <span>Book a call</span>
        </a>
      </div>
      <p class="contact-response-time">I usually reply within 24h to 48h on weekdays</p>

      <div class="contact-info">
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">Email</div>
            <div class="contact-card-value">contact@joaojacinto.com</div>
          </div>
          <button class="btn btn-dark-outline contact-card-btn" onclick="copyEmail(this)" aria-label="Copy email address">
            <span class="btn-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></span>
            <span id="emailHint">Copy</span>
          </button>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label-row">
              <div class="contact-card-label">Location</div>
              <div class="contact-card-sub" id="aveiro-clock" aria-live="polite">—</div>
            </div>
            <div class="contact-card-value">Aveiro, Portugal</div>
          </div>
          <a class="btn btn-dark-outline contact-card-btn" href="https://www.google.com/maps/@40.6405,-8.6538,13z" target="_blank" rel="noopener noreferrer" aria-label="View Aveiro on Google Maps">
            <span class="btn-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <span>View map</span>
          </a>
        </div>
        <div class="contact-card">
          <div class="contact-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </div>
          <div class="contact-card-body">
            <div class="contact-card-label">Socials</div>
            <div class="contact-card-value">LinkedIn · X</div>
          </div>
          <div class="contact-card-actions">
            <a class="btn btn-dark-outline contact-card-btn contact-card-btn--icon" href="https://www.linkedin.com/in/joaofranciscojacinto/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/></svg>
            </a>
            <a class="btn btn-dark-outline contact-card-btn contact-card-btn--icon" href="https://x.com/joao_jacinto_8" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>

<script is:inline>
function copyEmail(el) {
  navigator.clipboard?.writeText('contact@joaojacinto.com').then(() => {
    const hint = document.getElementById('emailHint');
    if (!hint) return;
    const original = hint.textContent;
    hint.textContent = 'Copied!';
    setTimeout(() => { hint.textContent = original; }, 2000);
  });
}

/* Live Aveiro clock — refreshes every minute, aligned to wall clock. */
(function () {
  const el = document.getElementById('aveiro-clock');
  if (!el) return;
  const fmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Lisbon',
    hour: '2-digit', minute: '2-digit', hour12: false
  });
  function tick() { el.textContent = fmt.format(new Date()) + ' local time'; }
  tick();
  const msToNextMinute = (60 - new Date().getSeconds()) * 1000;
  setTimeout(function () {
    tick();
    setInterval(tick, 60000);
  }, msToNextMinute);
})();

/* ── Contact canvas ──────────────────────────────────────────── */
let _contactRAF = null;

(function initContactCanvas() {
  const canvas = document.getElementById('contact-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, dpr;

  function resize() {
    dpr = window.devicePixelRatio || 1;
    W = canvas.offsetWidth; H = canvas.offsetHeight;
    canvas.width  = W * dpr; canvas.height = H * dpr;
    ctx.scale(dpr, dpr);
  }
  resize();
  window.addEventListener('resize', () => { ctx.setTransform(1,0,0,1,0,0); resize(); });

  const R = Math.min(window.innerHeight * 0.40, window.innerWidth * 0.32, 280);

  /* sample filled pixel positions from an offscreen canvas draw function */
  function sample(drawFn) {
    const oc = document.createElement('canvas');
    oc.width  = Math.max(100, W);
    oc.height = Math.max(100, H);
    const octx = oc.getContext('2d');
    drawFn(octx, oc.width, oc.height);
    const data = octx.getImageData(0, 0, oc.width, oc.height).data;
    const out = [];
    for (let y = 0; y < oc.height; y += 2) {
      for (let x = 0; x < oc.width; x += 2) {
        if (data[(y * oc.width + x) * 4 + 3] > 50) {
          out.push([x - oc.width / 2, y - oc.height / 2]);
        }
      }
    }
    return out;
  }

  /* Material Symbols paths (viewBox 0 -960 960 960) — drawn via Path2D and
     normalized into the offscreen canvas. */
  const MAT_CHAT = 'M80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z';
  const MAT_CALL = 'M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h480q33 0 56.5 23.5T720-720v180l160-160v440L720-420v180q0 33-23.5 56.5T640-160H160Zm0-80h480v-480H160v480Zm0 0v-480 480Z';

  function drawMaterial(octx, cw, ch, pathData, scaleFactor) {
    const S = Math.min(cw, ch) * (scaleFactor || 0.55);
    const cx = cw / 2, cy = ch / 2;
    octx.save();
    octx.fillStyle = '#fff';
    /* Material viewBox is 0 -960 960 960 — center at (480, -480). */
    octx.translate(cx - S / 2, cy + S / 2);
    octx.scale(S / 960, S / 960);
    octx.fill(new Path2D(pathData), 'evenodd');
    octx.restore();
  }

  /* "Get in touch" → Material chat-bubble icon. */
  const jPts     = sample((octx, cw, ch) => drawMaterial(octx, cw, ch, MAT_CHAT, 0.55));
  /* "Book a 30-min call" → Material call/handset icon. */
  const phonePts = sample((octx, cw, ch) => drawMaterial(octx, cw, ch, MAT_CALL, 0.55));

  const s = {
    mouseX:-999, mouseY:-999, prevMX:0, prevMY:0,
    velX:0, velY:0, smoothVX:0, smoothVY:0,
    rotX:0.04, rotY:0, rotVX:0, rotVY:0.0001,
    t:0, ripples:[],
    hoverColorProgress:0, hoverCR:61, hoverCG:91, hoverCB:220, hoverColor:null,
    targetRotSpeed:0.00008, currentRotSpeed:0.00008,
    targetLumBase:72, currentLumBase:72,
    targetLumRange:80, currentLumRange:80,
    wobble:false,
    activeMode:'nebula',
    isDragging:false, dragStartX:0, dragStartY:0,
  };

  function randN() {
    const u = Math.max(1e-10, Math.random());
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * Math.random());
  }

  const N = 380;
  const pts = Array.from({ length: N }, (_, i) => {
    const theta = Math.acos(1 - 2*(i+0.5)/N);
    const phi   = Math.PI*(1+Math.sqrt(5))*i;
    const jT = (Math.random()-0.5)*0.55;
    const jP = (Math.random()-0.5)*0.9;
    const rr = R * (0.55 + Math.random()*0.75);
    const tt = Math.max(0.05, Math.min(Math.PI-0.05, theta+jT));
    const ox = rr*Math.sin(tt)*Math.cos(phi+jP);
    const oy = rr*Math.sin(tt)*Math.sin(phi+jP);
    const oz = rr*Math.cos(tt);
    const ta = phi % (Math.PI*2), torusR = R*0.80, tubeR = R*0.38;

    const a = Math.random() * Math.PI * 2;
    const r2 = Math.sqrt(Math.random());
    const nbX = r2 * Math.cos(a) * W * 0.44;
    const nbY = r2 * Math.sin(a) * H * 0.12;
    const nbZ = randN() * 45;

    return {
      ox,oy,oz, nbX,nbY,nbZ,
      lJX:0, lJY:0,
      lPX:0, lPY:0,
      sx:nbX, sy:nbY, sz:nbZ,
      scX:(Math.random()-0.5)*R*2.4, scY:(Math.random()-0.5)*R*2.4, scZ:(Math.random()-0.5)*R*2.4,
      toX:(torusR+tubeR*Math.cos(theta))*Math.cos(ta),
      toY:tubeR*Math.sin(theta),
      toZ:(torusR+tubeR*Math.cos(theta))*Math.sin(ta),
      dotR:1.2+Math.random()*2.0,
      twinkle:Math.random()*Math.PI*2, twinkleSpeed:0.012+Math.random()*0.022,
      dispR:0, dispV:0,
      dispX:0, dispY:0, dvX:0, dvY:0,
      lerpSpeed:0.018+Math.random()*0.018,
      _tx:nbX, _ty:nbY, _tz:nbZ,
    };
  });

  pts.forEach(p => {
    if (jPts.length)     { const jp = jPts[Math.floor(Math.random()*jPts.length)];     p.lJX=jp[0]; p.lJY=jp[1]; }
    if (phonePts.length) { const pp = phonePts[Math.floor(Math.random()*phonePts.length)]; p.lPX=pp[0]; p.lPY=pp[1]; }
  });

  function getTarget(p, mode) {
    if (mode==='nebula')    return [p.nbX,     p.nbY,     p.nbZ    ];
    if (mode==='letter-j')  return [p.lJX,     p.lJY,     0        ];
    if (mode==='phone')     return [p.lPX,     p.lPY,     0        ];
    if (mode==='disc')      return [p.ox*1.1,  p.oy*0.10, p.oz*1.1 ];
    if (mode==='scatter')   return [p.scX*0.7, p.scY*0.7, p.scZ*0.7];
    if (mode==='dense')     return [p.ox*0.38, p.oy*0.38, p.oz*0.38];
    if (mode==='torus')     return [p.toX,     p.toY,     p.toZ    ];
    if (mode==='expanded')  return [p.ox*1.75, p.oy*1.75, p.oz*1.75];
    if (mode==='elongated') return [p.ox*1.2,  p.oy*0.22, p.oz*1.2 ];
    return [p.ox, p.oy, p.oz];
  }

  function applyMode(name, cx2, cy2) {
    s.activeMode = name;
    if (name === 'nebula') {
      s.targetRotSpeed = 0.00008; s.targetLumBase = 72; s.targetLumRange = 80; s.wobble = false;
    } else if (name === 'letter-j' || name === 'phone') {
      s.targetRotSpeed = 0.00004; s.targetLumBase = 100; s.targetLumRange = 60; s.wobble = false;
      pts.forEach(p => { p.dispX=0; p.dispY=0; p.dvX=0; p.dvY=0; });
    }
    pts.forEach(p => { const [tx,ty,tz] = getTarget(p, name); p._tx=tx; p._ty=ty; p._tz=tz; });
    if (cx2 !== undefined) {
      s.ripples.push({ sx:cx2, sy:cy2, t:0 });
      if (s.ripples.length > 3) s.ripples.shift();
    }
  }

  window.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    s.velX = (e.clientX-rect.left) - s.prevMX;
    s.velY = (e.clientY-rect.top)  - s.prevMY;
    s.prevMX = e.clientX-rect.left;
    s.prevMY = e.clientY-rect.top;
    s.mouseX = e.clientX-rect.left;
    s.mouseY = e.clientY-rect.top;
  });

  window.addEventListener('mousedown', e => {
    if (s.activeMode !== 'nebula') return;
    if (e.target.closest('a,button')) return;
    s.isDragging = true;
    const rect = canvas.getBoundingClientRect();
    s.dragStartX = e.clientX - rect.left;
    s.dragStartY = e.clientY - rect.top;
  });

  window.addEventListener('mouseup', () => {
    if (!s.isDragging) return;
    s.isDragging = false;
    const ddx = s.mouseX - s.dragStartX;
    const ddy = s.mouseY - s.dragStartY;
    const dist = Math.sqrt(ddx*ddx + ddy*ddy);
    if (dist < 8) return;
    const sx = -ddx/dist, sy = -ddy/dist;
    const power = Math.min(dist/40, 3) * 14;
    pts.forEach(p => {
      if (Math.sqrt(p.dispX*p.dispX + p.dispY*p.dispY) > 4) {
        p.dvX += sx * power;
        p.dvY += sy * power;
      }
    });
  });

  const emailBtn = document.getElementById('compose-open');
  if (emailBtn) {
    emailBtn.addEventListener('mouseenter', () => { s.hoverColor={cr:61,cg:91,cb:220}; applyMode('letter-j');  });
    emailBtn.addEventListener('mouseleave', () => { s.hoverColor=null;                  applyMode('nebula');    });
  }
  const callBtn = document.querySelector('.contact-ctas .btn-dark-outline');
  if (callBtn) {
    callBtn.addEventListener('mouseenter', () => { s.hoverColor={cr:235,cg:240,cb:255}; applyMode('phone');  });
    callBtn.addEventListener('mouseleave', () => { s.hoverColor=null;                    applyMode('nebula'); });
  }

  function rotXY(px,py,pz,rx,ry) {
    const y1=py*Math.cos(rx)-pz*Math.sin(rx), z1=py*Math.sin(rx)+pz*Math.cos(rx);
    const x2=px*Math.cos(ry)+z1*Math.sin(ry), z2=-px*Math.sin(ry)+z1*Math.cos(ry);
    return [x2,y1,z2];
  }
  function project(x,y,z,cx,cy) { const sc=420/(420+z); return [cx+x*sc, cy+y*sc, sc]; }

  const RS=0.65, RW=120, RM=320, RA=7;

  function draw() {
    ctx.clearRect(0,0,W,H);
    const cx=W*0.50, cy=H*0.50;
    s.t++;

    s.currentRotSpeed += (s.targetRotSpeed-s.currentRotSpeed)*0.012;
    s.currentLumBase  += (s.targetLumBase-s.currentLumBase)*0.018;
    s.currentLumRange += (s.targetLumRange-s.currentLumRange)*0.018;

    s.smoothVX = s.smoothVX*0.94 + s.velX*0.06;
    s.smoothVY = s.smoothVY*0.94 + s.velY*0.06;
    s.velX*=0.8; s.velY*=0.8;

    const inLetterMode = s.activeMode==='letter-j' || s.activeMode==='phone';
    if (inLetterMode) {
      s.rotVX*=0.88; s.rotVY*=0.88;
      s.rotY*=0.97;
      s.rotX += (0 - s.rotX) * 0.04;
    } else {
      s.rotVX += s.smoothVX*0.0000015; s.rotVY += s.smoothVY*0.0000015;
      s.rotVX*=0.986; s.rotVY*=0.986;
      s.rotY += s.currentRotSpeed + s.rotVY;
      s.rotX += s.rotVX;
      if (s.mouseX>0) s.rotX += (((s.mouseY/Math.max(H,1))-0.5)*0.55 - s.rotX)*0.0025;
      if (s.wobble) s.rotX += Math.sin(s.t*0.018)*0.0008;
    }

    s.ripples = s.ripples.filter(r=>r.t<RM);
    s.ripples.forEach(r=>r.t++);

    if (s.hoverColor) {
      s.hoverColorProgress = Math.min(1, s.hoverColorProgress+0.022);
      s.hoverCR=s.hoverColor.cr; s.hoverCG=s.hoverColor.cg; s.hoverCB=s.hoverColor.cb;
    } else {
      s.hoverColorProgress = Math.max(0, s.hoverColorProgress-0.018);
    }

    pts.forEach(p => {
      p.sx += (p._tx-p.sx)*p.lerpSpeed;
      p.sy += (p._ty-p.sy)*p.lerpSpeed;
      p.sz += (p._tz-p.sz)*p.lerpSpeed;
      p.dispV*=0.88; p.dispR=p.dispR*0.88+p.dispV;
      p.twinkle+=p.twinkleSpeed;
      p.dvX += -p.dispX*0.008; p.dvY += -p.dispY*0.008;
      p.dvX *= 0.80;            p.dvY *= 0.80;
      p.dispX += p.dvX;         p.dispY += p.dvY;
    });

    const proj = pts.map((p,pi) => {
      const len=Math.sqrt(p.sx*p.sx+p.sy*p.sy+p.sz*p.sz)||1;
      const wx=p.sx+p.sx/len*p.dispR, wy=p.sy+p.sy/len*p.dispR, wz=p.sz+p.sz/len*p.dispR;
      const [rx,ry,rz]=rotXY(wx,wy,wz,s.rotX,s.rotY);
      const [sx2,sy2,sc]=project(rx,ry,rz,cx,cy);
      const depth=Math.max(0,(sc-0.55)/0.9);
      const baseAlpha = 0.22+depth*0.52+Math.sin(p.twinkle)*0.10;
      return { sx:sx2, sy:sy2, sc, depth,
               alpha: inLetterMode ? Math.min(baseAlpha*1.15+0.12, 0.78) : baseAlpha,
               r:p.dotR*(0.35+depth*0.65)*sc, rz, pi };
    });

    if (s.activeMode === 'nebula' && s.mouseX > 0) {
      const spd = Math.min(Math.sqrt(s.smoothVX*s.smoothVX + s.smoothVY*s.smoothVY), 35);
      if (s.isDragging) {
        const DR = 220;
        proj.forEach(pp => {
          const dx = pp.sx - s.mouseX, dy = pp.sy - s.mouseY;
          const d2 = dx*dx + dy*dy;
          if (d2 < DR*DR) {
            const falloff = 1 - Math.sqrt(d2)/DR;
            pts[pp.pi].dvX += s.smoothVX * falloff * falloff * 0.08;
            pts[pp.pi].dvY += s.smoothVY * falloff * falloff * 0.08;
          }
        });
      } else if (spd > 1) {
        const IR = 180;
        proj.forEach(pp => {
          const dx = pp.sx - s.mouseX, dy = pp.sy - s.mouseY;
          const d2 = dx*dx + dy*dy;
          if (d2 < IR*IR && d2 > 0.1) {
            const d = Math.sqrt(d2);
            const falloff = 1 - d/IR;
            pts[pp.pi].dvX += (dx/d) * falloff * falloff * spd * 0.06;
            pts[pp.pi].dvY += (dy/d) * falloff * falloff * spd * 0.06;
          }
        });
      }
    }

    proj.forEach(pp => { pp.sx += pts[pp.pi].dispX; pp.sy += pts[pp.pi].dispY; });

    s.ripples.forEach(rpl => {
      const wf=rpl.t*RS, decay=Math.pow(1-rpl.t/RM,1.8);
      proj.forEach(p => {
        const dx=p.sx-rpl.sx, dy=p.sy-rpl.sy, dist=Math.sqrt(dx*dx+dy*dy);
        const diff=dist-wf;
        if (Math.abs(diff)<RW) { pts[p.pi].dispV += Math.cos(diff/RW*Math.PI*0.5)*RA*decay*0.04; }
      });
    });

    if (!s.hoverColor) {
      for (let i=0;i<proj.length;i++) for (let j=i+1;j<proj.length;j++) {
        const dx=proj[i].sx-proj[j].sx, dy=proj[i].sy-proj[j].sy, d2=dx*dx+dy*dy;
        if (d2<68*68) {
          const prog=1-Math.sqrt(d2)/68, da=(proj[i].depth+proj[j].depth)*0.5;
          ctx.beginPath(); ctx.moveTo(proj[i].sx,proj[i].sy); ctx.lineTo(proj[j].sx,proj[j].sy);
          ctx.strokeStyle=`rgba(130,130,130,${prog*da*0.10})`; ctx.lineWidth=0.6; ctx.stroke();
        }
      }
    }

    [...proj].sort((a,b)=>a.rz-b.rz).forEach(p => {
      if (p.r<0.3||p.alpha<0.03) return;
      const lum=Math.round(s.currentLumBase+p.depth*s.currentLumRange);
      let cr=lum, cg=lum, cb=lum;
      if (s.hoverColorProgress>0) {
        const hp=s.hoverColorProgress;
        cr=Math.round(lum+(s.hoverCR-lum)*hp);
        cg=Math.round(lum+(s.hoverCG-lum)*hp);
        cb=Math.round(lum+(s.hoverCB-lum)*hp);
      }
      ctx.beginPath();
      ctx.arc(p.sx, p.sy, Math.max(0.1, Math.min(p.r * (inLetterMode ? 1.6 : 1.0), inLetterMode ? 4.0 : 3.5)), 0, Math.PI*2);
      ctx.fillStyle=`rgba(${cr},${cg},${cb},${p.alpha})`;
      ctx.fill();
    });

    const maxGlow = inLetterMode ? 28 : 12;
    const g = Math.round(s.hoverColorProgress * maxGlow);
    canvas.style.filter = g>0 ? `drop-shadow(0 0 ${g}px rgba(${s.hoverCR},${s.hoverCG},${s.hoverCB},0.35))` : '';

    _contactRAF = requestAnimationFrame(draw);
  }

  draw();
})();
</script>
