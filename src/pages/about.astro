</Base>

<script is:inline>
/* About story, told as a planet clearing its orbit. A comet draws a
   glowing tangle (the problem), the tangle collapses into bodies, the
   bodies settle into orbits round a star, four are thrown out, the
   three left on the main orbit merge into one planet, and that orbit
   shrinks into a single switch with the planet as its knob.
   Flipping it turns the paper sketch into the finished, dark
   product state, which is also the SVG's resting markup. Click the
   stage to skip; Replay runs it again. */
(function () {
  const story = document.querySelector('[data-about-story]');
  if (!story || !story.animate) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const stage = story.querySelector('.about-story-stage');
  const $ = (s) => stage.querySelector(s);
  const $$ = (s) => Array.from(stage.querySelectorAll(s));
  const pt = (v) => v.split(',').map(Number);
  const tangle = $('.st-tangle'), pill = $('.st-pill'), ball = $('.st-ball'), sun = $('.st-sun');
  const replay = $('.about-story-replay');
  const RAD = Math.PI / 180, TAU = Math.PI * 2;
  const orbits = $$('.st-orbit').map((el) => ({
    el,
    rx: +el.getAttribute('rx'), ry: +el.getAttribute('ry'),
    rot: (+el.dataset.rot || 0) * RAD,
    w: +el.dataset.w,
    main: el.hasAttribute('data-main'),
  }));
  const steps = Array.from(story.querySelectorAll('.about-story-steps li'));
  const nodes = $$('.st-node').map((el) => ({
    el,
    s: pt(el.dataset.s),
    o: +el.dataset.o,
    a: +el.dataset.a * RAD,
    end: 0,                       /* the angle it leaves its orbit at, set in play() */
    cut: el.hasAttribute('data-cut'),
    slash: el.querySelector('.st-slash'),
  }));
  const cut = nodes.filter((n) => n.cut);
  const keep = nodes.filter((n) => !n.cut);

  const css = getComputedStyle(document.documentElement);
  const ease = (name, fallback) => (css.getPropertyValue(name) || '').trim() || fallback;
  const EMPH   = ease('--motion-easing-emphasized', 'cubic-bezier(0.22,1,0.36,1)');
  const STD    = ease('--motion-easing-standard', 'cubic-bezier(0.4,0,0.2,1)');
  const EXIT   = ease('--motion-easing-exit', 'cubic-bezier(0.4,0,1,1)');
  const ENTER  = ease('--motion-easing-enter', 'cubic-bezier(0,0,0.2,1)');
  const SPRING = ease('--motion-easing-spring', 'cubic-bezier(0.34,1.56,0.64,1)');

  const C = [240, 170];           /* centre of the stage */
  const OFF = [208, 170], ON = [272, 170]; /* knob positions in the switch */
  const T = (p, s) => 'translate(' + p[0] + 'px,' + p[1] + 'px) scale(' + s + ')';
  const a = (el, frames, opts) => el.animate(frames, Object.assign({ fill: 'forwards', easing: EMPH }, opts));
  const set = (el, props) => el.animate([props, props], { duration: 1, fill: 'forwards' });
  /* A point on an orbit, the direction of travel there, and keyframes
     for a run along it from one angle to another. */
  const on = (o, ang) => {
    const x = o.rx * Math.cos(ang), y = o.ry * Math.sin(ang), c = Math.cos(o.rot), s = Math.sin(o.rot);
    return [C[0] + x * c - y * s, C[1] + x * s + y * c];
  };
  const heading = (o, ang) => {
    const x = -o.rx * Math.sin(ang), y = o.ry * Math.cos(ang), c = Math.cos(o.rot), s = Math.sin(o.rot);
    const dx = x * c - y * s, dy = x * s + y * c, d = (Math.hypot(dx, dy) || 1) * (o.w < 0 ? -1 : 1);
    return [dx / d, dy / d];
  };
  const arc = (o, from, to) => {
    const n = Math.max(2, Math.ceil(Math.abs(to - from) / 0.12)), frames = [];
    for (let i = 0; i <= n; i++) frames.push({ opacity: 1, transform: T(on(o, from + (to - from) * i / n), 1), easing: 'linear' });
    return frames;
  };

  /* Dust: steps 1 and 2, on a canvas over the SVG and in its coordinates.
     start() sends a comet along the tangle's path; it leaves a glowing
     line behind it and sheds sparks that hang around the line. split()
     breaks the line into its sparks and pulls each one into its nearest
     piece; stop() clears the canvas. The tangle is drawn GROW times the
     size of the SVG path, so it spills past the stage. */
  const dust = (function () {
    const cv = $('.st-dust'), ctx = cv && cv.getContext && cv.getContext('2d');
    if (!ctx || !tangle.getTotalLength) return { start() {}, split() {}, stop() {} };
    const PAD = 0.35, N = 420, LUT = 520, GROW = 1.5;
    const FLY_IN = 0.25, TRACE = 1.55, FLY_OUT = 0.3;   /* seconds */
    const clamp01 = (x) => Math.max(0, Math.min(1, x));
    const len = tangle.getTotalLength(), lut = [];
    for (let i = 0; i <= LUT; i++) {
      const p = tangle.getPointAtLength(len * i / LUT);
      lut.push(C[0] + (p.x - 242) * GROW, C[1] + 2 + (p.y - 186) * GROW);
    }
    const at = (u) => {
      u = clamp01(u) * LUT;
      const i = Math.min(LUT - 1, u | 0), f = u - i;
      return [lut[i * 2] + (lut[i * 2 + 2] - lut[i * 2]) * f, lut[i * 2 + 1] + (lut[i * 2 + 3] - lut[i * 2 + 1]) * f];
    };
    /* Unit tangents at both ends, for the comet's way in and out. */
    const unit = (a, b) => { const dx = b[0] - a[0], dy = b[1] - a[1], d = Math.hypot(dx, dy) || 1; return [dx / d, dy / d]; };
    const P0 = at(0), P1 = at(1), T0 = unit(P0, at(0.01)), T1 = unit(at(0.99), P1);

    const P = [];
    for (let i = 0; i < N; i++) {
      const u = (i + Math.random()) / N, home = at(u);
      const ang = Math.random() * Math.PI * 2, far = 2 + 34 * Math.pow(Math.random(), 3);
      let k = 0, best = Infinity;
      nodes.forEach((n, j) => {
        const d = (n.s[0] - home[0]) * (n.s[0] - home[0]) + (n.s[1] - home[1]) * (n.s[1] - home[1]);
        if (d < best) { best = d; k = j; }
      });
      P.push({
        u, k, born: -1,
        dx: Math.cos(ang) * far, dy: Math.sin(ang) * far,
        ph: Math.random() * Math.PI * 2, sp: 0.8 + Math.random() * 1.6,
        r: 0.9 + Math.random() * 1.3, a: 0.55 + Math.random() * 0.45,
        accent: Math.random() < 0.3, d2: Math.random() * 0.22,
      });
    }
    let raf = 0, t0 = 0, splitAt = 0, w = 0, h = 0, k = 0, ink = '', brand = '', brand0 = '';
    function size() {
      const cw = stage.clientWidth, ch = stage.clientHeight, dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (cw === w && ch === h && dpr === k) return;
      w = cw; h = ch; k = dpr;
      cv.width = Math.round(w * (1 + PAD * 2) * k);
      cv.height = Math.round(h * (1 + PAD * 2) * k);
    }
    function trace(from, to) {
      const a = Math.max(0, Math.round(from * LUT)), b = Math.min(LUT, Math.round(to * LUT));
      ctx.beginPath(); ctx.moveTo(lut[a * 2], lut[a * 2 + 1]);
      for (let j = a + 1; j <= b; j++) ctx.lineTo(lut[j * 2], lut[j * 2 + 1]);
    }
    function frame(now) {
      raf = 0;
      size();
      const t = (now - t0) / 1000, ts = splitAt ? (now - splitAt) / 1000 : -1, sc = w / 480;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, cv.width, cv.height);
      if (ts > 0.9) return;
      ctx.setTransform(k * sc, 0, 0, k * sc, w * PAD * k, h * PAD * k);
      ctx.lineJoin = ctx.lineCap = 'round';

      /* How far along the path the comet is: steady, eased a little at both ends. */
      const lin = clamp01((t - FLY_IN) / TRACE);
      const head = 0.6 * lin + 0.4 * lin * lin * (3 - 2 * lin);
      const line = ts < 0 ? 1 : Math.max(0, 1 - ts / 0.35);   /* the line goes as the sparks leave */

      /* The glowing line: two soft accent strokes, then a bright core. */
      if (head > 0 && line > 0) {
        trace(0, head);
        ctx.strokeStyle = brand;
        ctx.globalAlpha = 0.1 * line; ctx.lineWidth = 16; ctx.stroke();
        ctx.globalAlpha = 0.24 * line; ctx.lineWidth = 7; ctx.stroke();
        ctx.shadowColor = brand; ctx.shadowBlur = 14 * k;
        ctx.strokeStyle = ink;
        ctx.globalAlpha = line * (0.9 + 0.1 * Math.sin(t * 3.2)); ctx.lineWidth = 2.6; ctx.stroke();
        ctx.shadowBlur = 0;
        /* Hotter just behind the comet. */
        if (lin < 1) { trace(head - 0.07, head); ctx.globalAlpha = 0.9; ctx.lineWidth = 4.4; ctx.stroke(); }
      }

      /* Sparks: born as the comet passes, thrown off the line, then they hover. */
      for (let i = 0; i < N; i++) {
        const p = P[i];
        if (p.born < 0) { if (head < p.u || lin <= 0) continue; p.born = t; }
        const age = t - p.born, out = 1 - Math.exp(-4 * age);
        const home = at(p.u + 0.008 * Math.sin(t * p.sp + p.ph));
        let x = home[0] + p.dx * out, y = home[1] + p.dy * out;
        let alpha = p.a * (0.3 + 0.7 * Math.exp(-1.4 * age)), r = p.r * (1 + 0.8 * Math.exp(-5 * age));
        if (ts >= 0) {
          let q = clamp01((ts - p.d2) / 0.45);
          q = q < 0.5 ? 4 * q * q * q : 1 - Math.pow(-2 * q + 2, 3) / 2;
          const n = nodes[p.k].s;
          x += (n[0] - x) * q; y += (n[1] - y) * q;
          alpha = (alpha + (p.a - alpha) * Math.min(1, ts / 0.15)) * (1 - q * q * q);
          r *= 1 - 0.4 * q;
        }
        ctx.globalAlpha = alpha;
        ctx.fillStyle = p.accent ? brand : ink;
        ctx.beginPath(); ctx.arc(x, y, r / Math.max(sc, 0.6), 0, Math.PI * 2); ctx.fill();
      }

      /* The comet: flies in along the first tangent, runs the path, flies out. */
      if (ts < 0) {
        let pos = null, dir = T0, seen = 1, tail = 0;
        if (t < FLY_IN) {
          const q = t / FLY_IN;
          pos = [P0[0] - T0[0] * 150 * (1 - q), P0[1] - T0[1] * 150 * (1 - q)]; seen = q; tail = 70;
        } else if (lin < 1) {
          pos = at(head);
        } else {
          const q = (t - FLY_IN - TRACE) / FLY_OUT;
          if (q < 1) { pos = [P1[0] + T1[0] * 170 * q, P1[1] + T1[1] * 170 * q]; dir = T1; seen = 1 - q; tail = 70 * (1 - q); }
        }
        if (pos) {
          if (tail) {
            const g = ctx.createLinearGradient(pos[0], pos[1], pos[0] - dir[0] * tail, pos[1] - dir[1] * tail);
            g.addColorStop(0, ink); g.addColorStop(0.4, brand); g.addColorStop(1, brand0);
            ctx.globalAlpha = seen; ctx.strokeStyle = g; ctx.lineWidth = 3.4;
            ctx.beginPath(); ctx.moveTo(pos[0], pos[1]); ctx.lineTo(pos[0] - dir[0] * tail, pos[1] - dir[1] * tail); ctx.stroke();
          }
          const glow = ctx.createRadialGradient(pos[0], pos[1], 0, pos[0], pos[1], 42);
          glow.addColorStop(0, brand); glow.addColorStop(1, brand0);
          ctx.globalAlpha = 0.7 * seen; ctx.fillStyle = glow;
          ctx.beginPath(); ctx.arc(pos[0], pos[1], 42, 0, Math.PI * 2); ctx.fill();
          ctx.globalAlpha = seen; ctx.fillStyle = ink;
          ctx.beginPath(); ctx.arc(pos[0], pos[1], 5, 0, Math.PI * 2); ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      cancelAnimationFrame(raf); raf = 0;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, cv.width, cv.height);
    }
    return {
      start() {
        stop();
        ink = getComputedStyle(stage).color;
        brand = getComputedStyle(cv).color;
        /* The accent at zero alpha, for gradients that fade to nothing. */
        brand0 = /^rgb\(/.test(brand) ? brand.replace('rgb(', 'rgba(').replace(')', ', 0)') : 'rgba(128,128,240,0)';
        P.forEach((p) => { p.born = -1; });
        t0 = performance.now(); splitAt = 0;
        raf = requestAnimationFrame(frame);
      },
      split() { splitAt = performance.now(); },
      stop,
    };
  })();

  let run = 0;
  let playing = false;
  let timers = [];
  const wait = (ms) => new Promise((resolve) => { timers.push(setTimeout(resolve, ms)); });

  function clear() {
    timers.forEach(clearTimeout);
    timers = [];
    story.getAnimations({ subtree: true }).forEach((x) => x.cancel());
    dust.stop();
  }
  function step(i) {
    steps.forEach((li, n) => {
      li.classList.toggle('is-active', n === i);
      li.classList.toggle('is-done', n < i);
    });
  }
  /* Back to the resting markup: the finished state. */
  function settle() {
    run++;
    playing = false;
    clear();
    stage.classList.remove('is-paper');
    story.classList.remove('is-playing');
    steps.forEach((li) => li.classList.remove('is-active', 'is-done'));
    replay.hidden = false;
    /* Chromium can keep cancelled fill-forwards values on SVG children
       (stray dots and the row left on the final frame, mostly at phone
       widths). Write the final frame as inline styles so it can't. */
    [tangle, sun].concat(orbits.map((o) => o.el), nodes.map((n) => n.el)).forEach((el) => { el.style.opacity = '0'; });
    pill.style.opacity = '1';
    pill.style.transform = 'none';
    ball.style.transform = 'translate(' + ON[0] + 'px,' + ON[1] + 'px)';
  }

  async function play() {
    clear();
    const me = ++run;
    const live = () => me === run;
    playing = true;
    story.classList.add('is-playing');
    stage.classList.add('is-paper');
    stage.querySelectorAll('svg *').forEach((el) => el.removeAttribute('style'));

    set(pill, { opacity: 0 });
    set(ball, { transform: T(C, 0) });
    nodes.forEach((n) => set(n.el, { opacity: 0, transform: T(n.s, 0) }));
    stage.classList.remove('is-pending');

    /* 1. Take the tangle as it is: a comet draws the mess as a glowing line. */
    step(0);
    dust.start();
    await wait(2500); if (!live()) return;

    /* 2. Break it into its parts: the mess collapses into the nodes,
       each one growing where its particles land. */
    step(1);
    dust.split();
    nodes.forEach((n, i) => a(n.el,
      [{ opacity: 1, transform: T(n.s, 0) }, { opacity: 1, transform: T(n.s, 1) }],
      { duration: 550, delay: 300 + i * 40, easing: SPRING }));
    await wait(1400); if (!live()) return;

    /* 3. Find what orbits what: a star lights up and every body
       finds its orbit. Each body's whole flight is scheduled here (the
       approach, its laps and, for the ones that get cut, the moment it
       is thrown out), so the legs join up without a jump. */
    step(2);
    const MAP = 1900, CUT = 1250;
    a(sun, [{ opacity: 0, transform: 'scale(0)' }, { opacity: 1, transform: 'scale(1)' }], { duration: 500, easing: SPRING });
    orbits.forEach((o, i) => a(o.el,
      [{ opacity: 0, transform: 'scale(0.7)' }, { opacity: o.main ? 0.75 : 0.4, transform: 'scale(1)' }],
      { duration: 600, delay: 150 + i * 90 }));
    nodes.forEach((n, i) => {
      const o = orbits[n.o], begin = 650 + i * 30, ci = cut.indexOf(n);
      const leave = ci < 0 ? MAP + CUT : MAP + 560 + ci * 60;
      n.end = n.a + o.w * (leave - begin) / 1000;
      a(n.el, [{ opacity: 1, transform: T(n.s, 1) }, { opacity: 1, transform: T(on(o, n.a), 1) }], { duration: 650, delay: i * 30 });
      a(n.el, arc(o, n.a, n.end), { duration: leave - begin, delay: begin, easing: 'linear' });
      if (ci >= 0) {
        const p = on(o, n.end), d = heading(o, n.end);
        a(n.slash, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 160, delay: MAP + ci * 110, easing: STD });
        a(n.el,
          [{ opacity: 1, transform: T(p, 1) }, { opacity: 0, transform: T([p[0] + d[0] * 220, p[1] + d[1] * 220], 0.6) }],
          { duration: 520, delay: leave, easing: EXIT });
      }
    });
    /* An orbit goes once the last body on it has left. */
    orbits.forEach((o, oi) => {
      if (o.main) return;
      const last = Math.max.apply(null, cut.map((n, ci) => (n.o === oi ? ci : -1)));
      a(o.el, [{ opacity: 0.4 }, { opacity: 0 }], { duration: 350, delay: MAP + 560 + Math.max(0, last) * 60 + 200, easing: STD });
    });
    await wait(MAP); if (!live()) return;

    /* 4. Clear the orbit of what nobody would miss: the marked bodies are struck
       through, then fly off along their own heading, and their orbits
       go with them. All of it was scheduled in step 3, on one clock,
       so a strike can never arrive after its body has left. */
    step(3);
    await wait(CUT); if (!live()) return;
    /* The three left share one orbit. They run together and merge into
       one planet at its left end, where the switch's knob will sit. */
    const main = orbits.filter((o) => o.main)[0], HOME = Math.PI, AT = on(main, HOME);
    keep.forEach((n) => {
      let d = (HOME - n.end) % TAU;
      if (d > Math.PI) d -= TAU; else if (d < -Math.PI) d += TAU;
      a(n.el, arc(main, n.end, n.end + d), { duration: 700 });
      a(n.el, [{ opacity: 1, transform: T(AT, 1) }, { opacity: 0, transform: T(AT, 0.6) }], { duration: 250, delay: 650, easing: STD });
    });
    a(ball, [{ transform: T(AT, 0) }, { transform: T(AT, 0.6) }], { duration: 400, delay: 600, easing: SPRING });
    await wait(1250); if (!live()) return;

    /* 5. Launch the one step that's left: the orbit shrinks into the
       switch's outline and the planet rides it in as the knob. */
    step(4);
    a(main.el, [{ opacity: 0.75, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.4)' }], { duration: 450 });
    a(sun, [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0)' }], { duration: 300, easing: STD });
    a(pill, [{ opacity: 0, transform: 'scale(2.5)' }, { opacity: 1, transform: 'scale(1)' }], { duration: 450 });
    a(ball, [{ transform: T(AT, 0.6) }, { transform: T(OFF, 1) }], { duration: 450 });
    await wait(950); if (!live()) return;

    /* Switch on: the sketch flips to the finished state in one frame. */
    stage.classList.remove('is-paper');
    a(ball, [{ transform: T(OFF, 1) }, { transform: T(ON, 1) }], { duration: 280, easing: SPRING });
    /* The "40 steps → 1" label is hidden by .is-playing and fades in
       via CSS when settle() removes that class. A WAAPI fill on SVG
       text left its opacity stale after cancel() in Chromium. */
    await wait(600); if (!live()) return;
    settle();
  }

  stage.addEventListener('click', (e) => {
    if (e.target === replay) return;
    if (playing) settle();
  });
  replay.addEventListener('click', play);

  /* Show the empty paper card from the first paint, so the finished
     state never flashes before the story starts. */
  story.classList.add('is-playing');
  stage.classList.add('is-paper', 'is-pending');
  setTimeout(play, 300);
})();
</script>

<script is:inline>
/* About page behaviour: count-ups, in-view hooks. (The X-ray switch lives in
   components/XraySwitch.astro.) */
(function () {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wrap = document.querySelector('.about-wrap');
  if (!wrap) return;
  wrap.classList.add('js');

  /* ---- Polaroids: tap (or Enter) brings one to the front; tap it again,
     tap elsewhere or press Escape to put it back. Hover does the same on
     a mouse, in CSS. ---- */
  const stack = wrap.querySelector('[data-polaroids]');
  if (stack) {
    const cards = Array.from(stack.querySelectorAll('.polaroid'));
    const focusOn = (card) => {
      const on = card && !card.classList.contains('is-focus');
      cards.forEach((c) => c.classList.toggle('is-focus', on && c === card));
      stack.classList.toggle('has-focus', on);
    };
    stack.addEventListener('click', (e) => focusOn(e.target.closest('.polaroid')));
    stack.addEventListener('keydown', (e) => {
      const card = e.target.closest('.polaroid');
      if (card && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); focusOn(card); }
      if (e.key === 'Escape') focusOn(null);
    });
    document.addEventListener('click', (e) => { if (!stack.contains(e.target)) focusOn(null); });
  }

  /* ---- How I work: Before / Now switch. Opens on "before", flips to
     "now" once the first card is in view, unless the visitor got to the
     switch first. Reduced motion stays on "now" and only flips on click. ---- */
  const loopEl = wrap.querySelector('[data-loop]');
  if (loopEl) {
    const btns = Array.from(loopEl.querySelectorAll('[data-loop-mode]'));
    let touched = false;
    const chips = Array.from(loopEl.querySelectorAll('.loop-tools li'));
    const shown = (li) => getComputedStyle(li).display !== 'none';
    const apply = (mode) => {
      loopEl.dataset.mode = mode;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.loopMode === mode)));
    };
    /* FLIP the chips: the ones leaving fall and fade from where they were,
       the ones staying slide down to their new spot, new ones pop in. */
    const setMode = (mode, animate = true) => {
      if (reduce || !animate || loopEl.dataset.mode === mode) { apply(mode); return; }
      chips.forEach((li) => { li.getAnimations().forEach((an) => an.finish()); });
      const first = new Map(chips.filter(shown).map((li) => [li, li.getBoundingClientRect()]));
      apply(mode);
      let enterN = 0;
      chips.forEach((li) => {
        const was = first.get(li);
        const is = shown(li);
        if (was && is) {
          const now = li.getBoundingClientRect();
          const dx = was.left - now.left, dy = was.top - now.top;
          if (dx || dy) li.animate(
            [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
            { duration: 520, delay: 140, easing: 'cubic-bezier(.2,.9,.25,1.15)', fill: 'backwards' });
        } else if (was) {
          const box = li.parentElement.getBoundingClientRect();
          li.classList.add('loop-leaving');
          Object.assign(li.style, { left: `${was.left - box.left}px`, top: `${was.top - box.top}px`, width: `${was.width}px` });
          li.animate(
            [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(18px) scale(0.85)' }],
            { duration: 280, easing: 'cubic-bezier(.4,0,1,1)' }
          ).finished.catch(() => {}).then(() => {
            li.classList.remove('loop-leaving');
            li.style.left = li.style.top = li.style.width = '';
          });
        } else if (is) {
          li.animate(
            [{ opacity: 0, transform: 'scale(0.6)' }, { opacity: 1, transform: 'none' }],
            { duration: 420, delay: 380 + enterN++ * 60, easing: 'cubic-bezier(.2,.9,.25,1.3)', fill: 'backwards' });
        }
      });
    };
    btns.forEach((b) => b.addEventListener('click', () => { touched = true; setMode(b.dataset.loopMode); }));
    const first = loopEl.querySelector('.loop-card');
    if (!reduce && first && 'IntersectionObserver' in window) {
      setMode('before', false);
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((en) => en.isIntersecting)) return;
        io.disconnect();
        setTimeout(() => { if (!touched) setMode('now'); }, 1400);
      }, { threshold: 0.6 });
      io.observe(first);
    }
  }

  /* ---- Count-ups: [data-count] with data-from / data-to ---- */
  const counters = Array.from(wrap.querySelectorAll('[data-count]'));
  const lang = () => (window.jjLang ? window.jjLang() : 'en');
  const fmt = (el, v) => {
    const pt = lang() === 'pt';
    const dec = Number(el.dataset.decimals || 0);
    const body = el.dataset.format === 'grouped'
      ? Math.round(v).toLocaleString(pt ? 'pt-PT' : 'en-US')
      : (pt ? v.toFixed(dec).replace('.', ',') : v.toFixed(dec));
    return body + (el.dataset.suffix || '');
  };
  /* Each counter remembers its current value (el._v) so a language switch
     can redraw it in the other number format, mid-animation or at rest. */
  counters.forEach((el) => { el._v = Number(el.dataset.to); });
  const redraw = () => counters.forEach((el) => { el.textContent = fmt(el, el._v); });
  document.addEventListener('jj:langchange', redraw);
  if (lang() === 'pt') redraw();
  function runCount(el) {
    const from = Number(el.dataset.from), to = Number(el.dataset.to);
    const dur = Number(el.dataset.duration || 1100);
    const start = performance.now();
    function frame(now) {
      const t = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el._v = from + (to - from) * eased;
      el.textContent = fmt(el, el._v);
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        io.unobserve(en.target);
        runCount(en.target);
      });
    }, { threshold: 0.6 });
    counters.forEach((el) => { el._v = Number(el.dataset.from); el.textContent = fmt(el, el._v); io.observe(el); });
  }

  /* ---- In-view hooks: [data-inview] gets .in once; [data-live] toggles .is-live ---- */
  if ('IntersectionObserver' in window) {
    const once = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        en.target.classList.add('in');
        once.unobserve(en.target);
      });
    }, { threshold: 0.3 });
    wrap.querySelectorAll('[data-inview]').forEach((el) => once.observe(el));

    const live = new IntersectionObserver((entries) => {
      entries.forEach((en) => en.target.classList.toggle('is-live', en.isIntersecting));
    }, { threshold: 0.2 });
    wrap.querySelectorAll('[data-live]').forEach((el) => live.observe(el));
  } else {
    wrap.querySelectorAll('[data-inview]').forEach((el) => el.classList.add('in'));
  }
})();
</script>
