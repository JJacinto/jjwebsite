---
import Base from '../layouts/Base.astro';
import XraySwitch from '../components/XraySwitch.astro';
import Journey from '../components/about/Journey.astro';

/* Equaliser bars for the "Now producing" card. Heights are fixed here so
   the markup is deterministic: --lo/--hi are the scaleY range, --d the
   cycle time, --i the delay seed. Static end state is --hi. */
const bars = Array.from({ length: 24 }, (_, i) => {
  const hi = 0.35 + ((i * 37) % 61) / 100;
  const lo = 0.12 + ((i * 17) % 23) / 100;
  const d = 700 + ((i * 53) % 9) * 70;
  return { i, hi: Math.min(hi, 1).toFixed(2), lo: lo.toFixed(2), d };
});

const photos = [
  { src: '/assets/images/photo-astronaut.webp', cap: 'Trained for zero gravity. Employed for zero margin.', capPt: 'Treinado para gravidade zero. Contratado para margem zero.', k: -2, rot: -6 },
  { src: '/assets/images/photo-guitar.webp', cap: 'Practicing quietly. The neighbors disagree.', capPt: 'A praticar baixinho. Os vizinhos discordam.', k: -1, rot: 3 },
  { src: '/assets/images/photo-tickets.webp', cap: 'Itinerary: aspirational. Carry-on: overpacked.', capPt: 'Itinerário: ambicioso. Bagagem de mão: a rebentar pelas costuras.', k: 0, rot: -2 },
  { src: '/assets/images/photo-vr.webp', cap: '911 in VR. EV in the garage. Identity crisis.', capPt: 'Um 911 em VR. Um elétrico na garagem. Crise de identidade.', k: 1, rot: 5 },
  { src: '/assets/images/photo-padel.webp', cap: 'Smash intent. Lob outcome.', capPt: 'Intenção de smash. Resultado: lob.', k: 2, rot: -4 },
];

/* How I work. `body` and `tools` are the stack before LLMs; `now` and
   `plus` are what the same step looks like today (the same three
   chips on every card). The section's switch flips between the two. */
const plus = ['MCPs', 'Skills', 'Plugins'];
const loop = [
  { n: '01', name: 'Talk', namePt: 'Conversa', bodyPt: 'Começo pela conversa, não pelo Figma. Os piores erros que vi começaram num ecrã em branco.', nowPt: 'Continua a ser uma conversa. A thread no Slack passa a ser o brief.', body: "I start in conversation, not in Figma. The worst mistakes I've seen began on a blank canvas.", tools: ['Slack', 'FigJam', 'Dovetail', 'Maze'], drop: ['FigJam', 'Dovetail', 'Maze'],
    now: 'Still a conversation. The Slack thread becomes the brief.' },
  { n: '02', name: 'Map', namePt: 'Mapear', bodyPt: 'Primeiro o sistema, depois os ecrãs: como as coisas se relacionam, que regras dependem de quais.', nowPt: 'O mesmo raciocínio. Os MCPs ligam as ferramentas, e o mapa vem do sistema real.', body: 'System first, screens second: how things relate, which rules depend on which.', tools: ['FigJam', 'Notion'], drop: ['FigJam'],
    now: 'Same thinking. MCPs link the tools, so the map comes from the real system.' },
  { n: '03', name: 'Cut', namePt: 'Cortar', bodyPt: 'Depois corto o que ninguém daria por falta. A complexidade que tem de ficar, torno-a visível.', nowPt: 'Cortar continua a ser comigo. As skills verificam cada passagem com as mesmas regras.', body: 'Then I cut whatever nobody would miss. The complexity that has to stay, I make visible.', tools: ['Figma', 'Jitter', 'Retune.dev'], drop: ['Figma', 'Jitter'],
    now: 'The cutting is still mine. Skills check every pass against the same rules.' },
  { n: '04', name: 'Ship', namePt: 'Lançar', bodyPt: 'O Figma é o contrato. Se o developer abre o ficheiro e nada o surpreende, fiz o meu trabalho.', nowPt: 'O Figma continua a ser o contrato. Os plugins e o Claude Code tratam do handoff repetível. Eu revejo.', body: "Figma is the contract. If the dev opens the file and nothing surprises them, I've done my job.", tools: ['Figma', 'Linear', 'Loom', 'Slack'], drop: ['Figma', 'Loom'],
    now: 'Figma is still the contract. Plugins and Claude Code handle the repeat work of handoff. I review it.' },
  { n: '05', name: 'Measure', namePt: 'Medir', bodyPt: 'Lançar não é acabar. É aqui que vejo se tinha razão. Quase nunca por inteiro. Isto é o ciclo.', nowPt: 'As automações trazem-me os números todas as semanas. Vejo mais cedo onde errei. Isto é o ciclo.', body: "Shipped isn't done. This is where I find out if I was right. Rarely entirely. That's the loop.", tools: ['Fullstory', 'Mixpanel', 'Looker'], drop: ['Fullstory'],
    now: "Automations bring me the numbers every week, so I see where I was wrong sooner. That's the loop." },
];
---
<Base
  activePage="about"
  title="About — João Jacinto"
  titlePt="Sobre — João Jacinto"
  description="I design products that make complicated things easier for the people who use them. Senior Product Designer based in Aveiro, Portugal."
  descriptionPt="Desenho produtos que tornam as coisas complicadas mais fáceis para quem as usa. Senior Product Designer em Aveiro, Portugal."
  showCta={true}
>

  <div class="about-wrap">
    <!-- X-ray grid: the 12-column grid of the 1140px container. Only
         visible while the X-ray switch is on. -->
    <div class="xray-grid" aria-hidden="true">
      <div class="xray-grid-inner">
        <span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="container">

      <!-- Story hero: a tangle is pulled apart, mapped, cut down and
           shipped as one step. The SVG's resting markup is the final
           frame, so no-JS and reduced-motion visitors see the outcome
           and all five steps. The script at the bottom of this file
           plays it once on load. -->
      <section class="about-story about-section" data-about-story data-xray data-xray-gap="128">
        <aside class="xray-note" data-xray-note data-pt="A história passa uma vez e fica parada no último fotograma. Movimento reduzido ou sem JavaScript? Vê-se logo o último fotograma.">The story plays once, then rests on its last frame. Reduced motion or no JavaScript? You get the last frame straight away.</aside>

        <div class="about-story-head">
          <p class="about-intro">
            <img class="about-intro-avatar" src="/assets/images/photo.webp" alt="João Jacinto" width="40" height="40">
            <span data-pt="João Jacinto · Senior Product Designer na Anchorage Digital · Aveiro, Portugal">João Jacinto · Senior Product Designer at Anchorage Digital · Aveiro, Portugal</span>
          </p>
          <h1 class="about-story-title" data-pt="Transformo problemas emaranhados em produtos em que ninguém precisa de pensar.">I turn tangled problems into products people don't have to think about.</h1>
        </div>

        <div class="about-story-stage" aria-hidden="true">
          <svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">
            <path class="st-tangle" pathLength="1" d="M92,196C120,96 236,70 286,128C332,182 250,262 190,222C128,180 196,86 276,98C366,112 398,214 330,258C262,302 150,280 150,206C150,138 236,118 276,160C312,198 286,250 240,244C196,238 190,186 228,170C262,156 300,186 284,214C330,236 380,206 392,160"/>

            <g class="st-edges">
              <line class="st-edge" data-keep pathLength="1" x1="240" y1="80" x2="160" y2="170"/>
              <line class="st-edge" pathLength="1" x1="240" y1="80" x2="320" y2="170"/>
              <line class="st-edge" data-keep pathLength="1" x1="160" y1="170" x2="110" y2="260"/>
              <line class="st-edge" pathLength="1" x1="160" y1="170" x2="210" y2="260"/>
              <line class="st-edge" pathLength="1" x1="320" y1="170" x2="270" y2="260"/>
              <line class="st-edge" pathLength="1" x1="320" y1="170" x2="370" y2="260"/>
            </g>
            <line class="st-row" x1="180" y1="170" x2="300" y2="170"/>

            <!-- data-s = scattered position, data-m = mapped position,
                 data-r = position in the final row (kept nodes only). -->
            <g class="st-nodes">
              <g class="st-node" data-s="236,150" data-m="240,80"  data-r="180,170"><circle r="8"/></g>
              <g class="st-node" data-s="96,188"  data-m="160,170" data-r="240,170"><circle r="8"/></g>
              <g class="st-node" data-s="372,172" data-m="320,170" data-cut><circle r="8"/><path class="st-slash" pathLength="1" d="M-13,11L13,-11"/></g>
              <g class="st-node" data-s="132,84"  data-m="110,260" data-r="300,170"><circle r="8"/></g>
              <g class="st-node" data-s="178,286" data-m="210,260" data-cut><circle r="8"/><path class="st-slash" pathLength="1" d="M-13,11L13,-11"/></g>
              <g class="st-node" data-s="300,292" data-m="270,260" data-cut><circle r="8"/><path class="st-slash" pathLength="1" d="M-13,11L13,-11"/></g>
              <g class="st-node" data-s="330,72"  data-m="370,260" data-cut><circle r="8"/><path class="st-slash" pathLength="1" d="M-13,11L13,-11"/></g>
            </g>

            <rect class="st-pill" x="180" y="142" width="120" height="56" rx="28"/>
            <circle class="st-ball" r="20"/>
            <text class="st-result" x="240" y="250" text-anchor="middle" data-pt="40 passos → 1">40 steps → 1</text>
          </svg>
          <button class="about-story-replay" type="button" hidden data-umami-event="about-story-replay" data-pt="Repetir">Replay</button>
        </div>

        <div class="about-story-copy">
          <ol class="about-story-steps">
            <li data-pt="Pegar no emaranhado tal como está.">Take the tangle as it is.</li>
            <li data-pt="Desfazê-lo em peças.">Pull it apart into pieces.</li>
            <li data-pt="Mapear a relação entre as peças.">Map how the pieces relate.</li>
            <li data-pt="Cortar o que ninguém daria por falta.">Cut what nobody would miss.</li>
            <li data-pt="Lançar o único passo que sobra.">Ship the one step that's left.</li>
          </ol>
          <p class="about-story-note" data-pt="Esta é a história do redesenho das políticas e permissões na Anchorage Digital.">That's the story of the policies and permissions redesign at Anchorage Digital.</p>

          <XraySwitch wrap=".about-wrap" />
        </div>
      </section>

      <!-- How I work -->
      <!-- The markup rests on "now", so no-JS and reduced-motion visitors
           get today's stack. With JS it opens on "before" and flips to
           "now" once the cards are in view; the switch flips it back. -->
      <section id="loop" class="about-section loop" data-loop data-mode="now" data-live data-xray data-xray-gap="128" aria-labelledby="loop-title">
        <aside class="xray-note" data-xray-note data-pt="Os mesmos cinco passos dos dois lados do interruptor. Só mudam as ferramentas e o que corre por baixo delas.">Same five steps on both sides of the switch. Only the tools change, and what runs underneath them.</aside>

        <div class="about-head">
          <span class="eyebrow reveal" data-pt="Como trabalho">How I work</span>
          <h2 id="loop-title" class="about-head-narrow reveal reveal-d1" data-pt="Encontrar a menor versão do problema real. Depois construir a menor versão de uma resposta a sério.">Find the smallest version of the real problem. Then build the smallest version of a real answer.</h2>
        </div>

        <div class="loop-switch reveal reveal-d2">
          <div class="loop-seg" role="group" aria-label="Which stack to show" data-pt-aria-label="Que stack mostrar">
            <span class="loop-seg-thumb" aria-hidden="true"></span>
            <button type="button" data-loop-mode="before" aria-pressed="false" data-umami-event="about-stack-before" data-pt="Antes">Before</button>
            <button type="button" data-loop-mode="now" aria-pressed="true" data-umami-event="about-stack-now" data-pt="Agora">Now</button>
          </div>
          <p class="loop-caption" aria-live="polite">
            <span data-when="before" data-pt="A minha stack antes dos LLMs. Cada passo à mão.">My stack before LLMs. Every step by hand.</span>
            <span data-when="now" data-pt="A minha stack agora. Os mesmos cinco passos, com o trabalho braçal automatizado.">My stack now. Same five steps, with the legwork automated.</span>
          </p>
        </div>

        <div class="loop-track">
          <span class="loop-line" data-inview aria-hidden="true"></span>
          <ol class="loop-row">
            {loop.map((s, i) => (
              <li class={`loop-card reveal reveal-d${Math.min(i + 1, 4)}`} style={`--i:${i}`}>
                <span class="loop-num">{s.n}</span>
                <h3 class="loop-name" data-pt={s.namePt}>{s.name}</h3>
                <div class="loop-bodies">
                  <p class="loop-body" data-when="before" data-pt={s.bodyPt}>{s.body}</p>
                  <p class="loop-body" data-when="now" data-pt={s.nowPt}>{s.now}</p>
                </div>
                <ul class="loop-tools">
                  {s.tools.map((t) => <li class={s.drop?.includes(t) ? 'loop-drop' : undefined} data-when={s.drop?.includes(t) ? 'before' : undefined}>{t}</li>)}
                  {plus.map((p) => <li class="loop-plus" data-when="now">{p}</li>)}
                </ul>
                <span class="loop-feed" aria-hidden="true"></span>
              </li>
            ))}
          </ol>

          <div class="loop-bus reveal reveal-d4">
            <span class="loop-bus-label" data-pt="Feito por">Run by</span>
            <ul class="loop-runners">
              <li class="loop-runner" data-pt="Eu">Me</li>
              <li class="loop-runner" data-when="now" style="--i:1">Claude Code</li>
              <li class="loop-runner" data-when="now" style="--i:2">Gemini</li>
              <li class="loop-runner loop-runner--home" data-when="now" style="--i:3">
                <svg class="loop-home" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path d="M2 7.5 8 2.5l6 5V14H2z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                  <circle class="loop-home-led" cx="8" cy="10.2" r="1.6"/>
                </svg>
                <span data-pt="LLMs locais">Local LLMs</span> <small data-pt="em casa">at home</small>
              </li>
            </ul>
            <p class="loop-repeat"><span aria-hidden="true">↺</span> <span data-pt="repetir">repeat</span></p>
          </div>
        </div>

        <p class="loop-foot reveal" data-pt="O Claude Code e o Gemini fazem a maior parte do trabalho pesado. Parte corre em modelos locais, numa máquina que tenho em casa. As ferramentas mudam de poucos em poucos anos. O hábito não.">Claude Code and Gemini do most of the lifting. Some of it runs on local models, on a machine I keep at home. The tools change every few years. The habit doesn't.</p>
      </section>

      <!-- Principles -->
      <section class="about-section principles" data-xray data-xray-gap="128" aria-labelledby="principles-title">
        <aside class="xray-note" data-xray-note data-pt="Cada cartão faz o que diz. Basta passar o rato por cima ou chegar lá com o Tab.">Each card does what it says. Hover it, or tab to it.</aside>

        <div class="about-head">
          <span class="eyebrow reveal" data-pt="Princípios">Principles</span>
          <h2 id="principles-title" class="about-head-narrow reveal reveal-d1" data-pt="Quatro regras a que volto sempre.">Four rules I keep coming back to.</h2>
        </div>

        <!-- One card per step of the loop above: Talk (and Measure),
             Map, Cut, Ship. -->
        <div class="p-grid">
          <article class="p-card reveal reveal-d1" tabindex="0">
            <div class="p-demo" aria-hidden="true">
              <span class="tap-hint"></span>
              <div class="d3-stage">
                <span class="d3-line"></span>
                <span class="d3-dot d3-dot--me"><i></i><em data-pt="eu">me</em></span>
                <span class="d3-dot d3-dot--them"><i></i><em data-pt="eles">them</em></span>
              </div>
            </div>
            <h3 class="p-title" data-pt="Ficar perto de quem usa.">Stay close to the people using it.</h3>
            <p class="p-body" data-pt="Começo pelas palavras deles e volto aos números deles. O que dizem decide o próximo passo, não o último slide da apresentação.">I start with their words and come back to their numbers. What they say shapes the next decision, not the last slide of the deck.</p>
          </article>

          <article class="p-card reveal reveal-d2" tabindex="0">
            <div class="p-demo p-demo--grid" aria-hidden="true">
              <span class="tap-hint"></span>
              <div class="d1-grid"></div>
              <div class="d1-mock">
                <i class="d1-bar d1-bar--a"></i>
                <b class="d1-gap" data-v="16"></b>
                <i class="d1-bar d1-bar--b"></i>
                <b class="d1-gap d1-gap--lg" data-v="24"></b>
                <i class="d1-btn"></i>
              </div>
            </div>
            <h3 class="p-title" data-pt="Tornar o invisível visível.">Make the invisible visible.</h3>
            <p class="p-body" data-pt="Se uma regra decide o que acontece, tem de estar no ecrã. Permissões, limites e dependências não devem viver na cabeça de alguém.">If a rule decides what happens, it belongs on the screen. Permissions, limits and dependencies shouldn't live in someone's head.</p>
          </article>

          <article class="p-card reveal reveal-d1" tabindex="0">
            <div class="p-demo" aria-hidden="true">
              <span class="tap-hint"></span>
              <div class="d2-form">
                <span class="d2-field"><i></i><b></b></span>
                <span class="d2-field d2-field--cut"><i></i><b></b></span>
                <span class="d2-field d2-field--cut"><i></i><b></b></span>
                <span class="d2-field"><i></i><b></b></span>
                <span class="d2-field d2-field--cut"><i></i><b></b></span>
                <span class="d2-field d2-field--cut"><i></i><b></b></span>
              </div>
              <span class="d2-count" data-pt="6 campos → 2">6 fields → 2</span>
            </div>
            <h3 class="p-title" data-pt="Cada passo tem de merecer o lugar.">Every step earns its place.</h3>
            <p class="p-body" data-pt="Se ninguém dá por falta, sai. O que tem de ficar, torno visível.">If nobody would miss it, it goes. What has to stay, I make visible.</p>
          </article>

          <article class="p-card reveal reveal-d2" tabindex="0">
            <div class="p-demo" aria-hidden="true">
              <span class="tap-hint"></span>
              <div class="d4-thread">
                <div class="d4-msg d4-msg--me"><p><b data-pt="Seg">Mon</b> <span data-pt="Rascunho no ar, ainda tosco.">Rough draft's up, on purpose.</span></p></div>
                <div class="d4-msg d4-msg--me d4-msg--later"><p><b data-pt="Ter">Tue</b> <span data-pt="Sem o passo 3. Porquê: menos erros.">Cut step 3. Why: fewer errors.</span></p></div>
                <div class="d4-msg d4-msg--them d4-msg--later"><p data-pt="E os admins?">What about admins?</p></div>
                <span class="d4-typing"><i></i><i></i><i></i></span>
              </div>
            </div>
            <h3 class="p-title" data-pt="Não deixar surpresas.">Leave no surprises.</h3>
            <p class="p-body" data-pt="O trabalho anda mais depressa, por isso falo cedo e muitas vezes: o rascunho, a decisão, o porquê. Ninguém descobre só na revisão, e contestar ainda sai barato.">Work moves faster now, so I share early and often: the rough draft, the decision, the why. Nobody finds out at the review, and pushing back is still cheap.</p>
          </article>
        </div>
      </section>

      <!-- Journey -->
      <section class="about-section journey" data-xray data-xray-gap="128" aria-labelledby="journey-title">
        <aside class="xray-note" data-xray-note data-pt="Linha contínua para a carreira, tracejada para os anos em que ainda estava a aprender. Um número só onde houver um honesto.">Solid line for the career, dashed for the years I was still learning. A number only where there's an honest one.</aside>

        <div class="about-head">
          <span class="eyebrow reveal" data-pt="Percurso">Journey</span>
          <h2 id="journey-title" class="reveal reveal-d1" data-pt="Um fio condutor desde os 13 anos.">One thread since I was 13.</h2>
        </div>

        <Journey />
      </section>

      <!-- Off the clock -->
      <section class="about-section board" data-xray data-xray-gap="128" aria-labelledby="board-title">
        <aside class="xray-note" data-xray-note data-pt="As fotos têm 192px. Pequenas de propósito: esta parte é sobre a pessoa, não sobre o portefólio.">The photos are 192px. Small on purpose: this part is about the person, not the portfolio.</aside>

        <div class="about-head">
          <span class="eyebrow reveal" data-pt="Fora do horário">Off the clock</span>
          <h2 id="board-title" class="reveal reveal-d1" data-pt="Quando não estou a desenhar.">When I'm not designing.</h2>
        </div>

        <div class="board-grid">
          <div class="b-card b-photos reveal">
            <div class="polaroids" role="group" aria-label="Photos" data-pt-aria-label="Fotografias" data-polaroids>
              {photos.map((p) => (
                <figure class="polaroid" tabindex="0" style={`--k:${p.k};--rot:${p.rot}deg`}>
                  <img src={p.src} alt="" width="192" height="192" loading="lazy">
                  <figcaption data-pt={p.capPt}>{p.cap}</figcaption>
                </figure>
              ))}
            </div>
            <span class="tap-hint" aria-hidden="true"></span>
          </div>

          <div class="b-card b-music reveal reveal-d1" data-live>
            <span class="eyebrow b-label" data-pt="A produzir">Producing</span>
            <a class="b-title" data-umami-event="about-music" href="https://music.youtube.com/watch?v=80hpbDstlhc&list=OLAK5uy_mex7K9FoXhQBxg8yKviL81Avmz9Xfh4WI" target="_blank" rel="noopener noreferrer">Boreal Haze</a>
            <div class="eq" aria-hidden="true">
              {bars.map((b) => <span style={`--i:${b.i};--hi:${b.hi};--lo:${b.lo};--d:${b.d}ms`}></span>)}
            </div>
            <p class="b-sub"><span data-pt="A ouvir">Listening to</span> <a href="https://music.youtube.com/playlist?list=OLAK5uy_mT0JOV9xVWCyrOWBjjfpjAF-0LfyxGVW8" target="_blank" rel="noopener noreferrer">Vulfmon</a>, <a href="https://music.youtube.com/watch?v=I8NzXaIQY54" target="_blank" rel="noopener noreferrer">Oli Howe</a></p>
          </div>

          <div class="b-card b-read reveal reveal-d2">
            <span class="eyebrow b-label" data-pt="A ler">Reading</span>
            <div class="b-read-row">
              <div class="book" aria-hidden="true"><span>Crucial</span><span>Conver&shy;sations</span></div>
              <div class="b-read-text">
                <a class="b-title b-title--sm" href="https://www.amazon.es/dp/1260474186" target="_blank" rel="noopener noreferrer">Crucial Conversations</a>
                <p class="b-sub">Patterson, Grenny, McMillan &amp; Switzler</p>
              </div>
            </div>
          </div>

          <div class="b-card b-build reveal reveal-d3">
            <span class="eyebrow b-label" data-pt="A construir">Building</span>
            <ul class="b-projects">
              <li><a href="https://www.anchorage.com" target="_blank" rel="noopener noreferrer">Anchorage Digital</a><span data-pt="O emprego">Day job</span></li>
              <li data-pt="Mod do Home Assistant<span>A nossa casa inteligente</span>">Home Assistant mod<span>Our smart home</span></li>
              <li data-pt="Servidor de IA local<span>LLMs + um agente soberano</span>">Local AI server<span>LLMs + a sovereign agent</span></li>
              <li class="is-live" data-pt="joaojacinto.com<span>Estás nele</span>">joaojacinto.com<span>You're on it</span></li>
            </ul>
          </div>

          <div class="b-card b-into reveal reveal-d1">
            <span class="eyebrow b-label" data-pt="Também gosto de">Also into</span>
            <ul class="chips">
              <li data-pt="Bateria">Drums</li><li data-pt="Produção musical">Music production</li><li data-pt="Construir com IA">Building with AI</li><li>RPGs</li><li data-pt="Corridas em VR">VR racing</li><li>Premier League</li><li data-pt="Impressão 3D">3D printing</li>
            </ul>
          </div>

          <div class="b-card b-desk reveal reveal-d2">
            <span class="eyebrow b-label" data-pt="Na secretária">At the desk</span>
            <p class="b-desk-text">Steelcase Leap v2 · Odyssey G9 · Logitech MX · Deltahub Carpio</p>
          </div>
        </div>
      </section>

    </div>

    <!-- Floating copy of the X-ray switch: shows once the hero switch has
         scrolled out of view. -->
    <XraySwitch float wrap=".about-wrap" />
  </div>

</Base>

<script is:inline>
/* About story. One ball (the problem) drops onto a tangle, breaks into
   pieces, the pieces get mapped, four are cut, the three left merge
   back into the ball, and the ball becomes the knob of a single
   switch. Flipping it turns the paper sketch into the finished, dark
   product state, which is also the SVG's resting markup. Click the
   stage to skip; Replay runs it again. */
(function () {
  const story = document.querySelector('[data-about-story]');
  if (!story || !story.animate) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  const stage = story.querySelector('.about-story-stage');
  const $ = (s) => stage.querySelector(s);
  const $$ = (s) => Array.from(stage.querySelectorAll(s));
  const pt = (v) => v.split(',').map(Number);
  const tangle = $('.st-tangle'), pill = $('.st-pill'), ball = $('.st-ball'), row = $('.st-row');
  const replay = $('.about-story-replay');
  const edges = $$('.st-edge');
  const steps = Array.from(story.querySelectorAll('.about-story-steps li'));
  const nodes = $$('.st-node').map((el) => ({
    el,
    s: pt(el.dataset.s),
    m: pt(el.dataset.m),
    r: el.dataset.r ? pt(el.dataset.r) : null,
    cut: el.hasAttribute('data-cut'),
    slash: el.querySelector('.st-slash'),
  }));
  const cut = nodes.filter((n) => n.cut);
  const keep = nodes.filter((n) => !n.cut);

  const css = getComputedStyle(document.documentElement);
  const ease = (name, fallback) => (css.getPropertyValue(name) || '').trim() || fallback;
  const EMPH   = ease('--motion-easing-emphasized', 'cubic-bezier(0.22,1,0.36,1)');
  const STD    = ease('--motion-easing-standard', 'cubic-bezier(0.4,0,0.2,1)');
  const EXIT   = ease('--motion-easing-exit', 'cubic-bezier(0.4,0,1,1)');
  const ENTER  = ease('--motion-easing-enter', 'cubic-bezier(0,0,0.2,1)');
  const SPRING = ease('--motion-easing-spring', 'cubic-bezier(0.34,1.56,0.64,1)');

  const C = [240, 170];           /* centre of the stage */
  const OFF = [208, 170], ON = [272, 170]; /* knob positions in the switch */
  const T = (p, s) => 'translate(' + p[0] + 'px,' + p[1] + 'px) scale(' + s + ')';
  const a = (el, frames, opts) => el.animate(frames, Object.assign({ fill: 'forwards', easing: EMPH }, opts));
  const set = (el, props) => el.animate([props, props], { duration: 1, fill: 'forwards' });

  let run = 0;
  let playing = false;
  let timers = [];
  const wait = (ms) => new Promise((resolve) => { timers.push(setTimeout(resolve, ms)); });

  function clear() {
    timers.forEach(clearTimeout);
    timers = [];
    story.getAnimations({ subtree: true }).forEach((x) => x.cancel());
  }
  function step(i) {
    steps.forEach((li, n) => {
      li.classList.toggle('is-active', n === i);
      li.classList.toggle('is-done', n < i);
    });
  }
  /* Back to the resting markup: the finished state. */
  function settle() {
    run++;
    playing = false;
    clear();
    stage.classList.remove('is-paper');
    story.classList.remove('is-playing');
    steps.forEach((li) => li.classList.remove('is-active', 'is-done'));
    replay.hidden = false;
    /* Chromium can keep cancelled fill-forwards values on SVG children
       (stray dots and the row left on the final frame, mostly at phone
       widths). Write the final frame as inline styles so it can't. */
    [tangle, row].concat(edges, nodes.map((n) => n.el)).forEach((el) => { el.style.opacity = '0'; });
    pill.style.opacity = '1';
    pill.style.transform = 'none';
    ball.style.transform = 'translate(' + ON[0] + 'px,' + ON[1] + 'px)';
  }

  async function play() {
    clear();
    const me = ++run;
    const live = () => me === run;
    playing = true;
    story.classList.add('is-playing');
    stage.classList.add('is-paper');
    stage.querySelectorAll('svg *').forEach((el) => el.removeAttribute('style'));

    set(pill, { opacity: 0 });
    set(ball, { transform: T([240, -30], 0.45) });
    nodes.forEach((n) => set(n.el, { opacity: 0, transform: T(C, 0) }));
    stage.classList.remove('is-pending');

    /* 1. Take the tangle as it is. */
    step(0);
    a(tangle, [{ opacity: 1, strokeDashoffset: 1 }, { opacity: 1, strokeDashoffset: 0 }], { duration: 1000, easing: STD });
    a(ball, [
      { transform: T([240, -30], 0.45), easing: EXIT },
      { transform: T(C, 0.45), offset: 0.55, easing: ENTER },
      { transform: T([240, 142], 0.45), offset: 0.78, easing: EXIT },
      { transform: T(C, 0.45) },
    ], { duration: 800, delay: 500, easing: 'linear' });
    await wait(1700); if (!live()) return;

    /* 2. Pull it apart into pieces. */
    step(1);
    a(tangle, [{ opacity: 1 }, { opacity: 0 }], { duration: 350, easing: STD });
    a(ball, [{ transform: T(C, 0.45) }, { transform: T(C, 0) }], { duration: 220, easing: EXIT });
    nodes.forEach((n, i) => a(n.el,
      [{ opacity: 1, transform: T(C, 0) }, { opacity: 1, transform: T(n.s, 1) }],
      { duration: 600, delay: 120 + i * 45, easing: SPRING }));
    await wait(1300); if (!live()) return;

    /* 3. Map how the pieces relate. */
    step(2);
    nodes.forEach((n, i) => a(n.el,
      [{ opacity: 1, transform: T(n.s, 1) }, { opacity: 1, transform: T(n.m, 1) }],
      { duration: 650, delay: i * 30 }));
    edges.forEach((e, i) => a(e,
      [{ opacity: 1, strokeDashoffset: 1 }, { opacity: 1, strokeDashoffset: 0 }],
      { duration: 380, delay: 450 + i * 70, easing: STD }));
    await wait(1700); if (!live()) return;

    /* 4. Cut what nobody would miss. */
    step(3);
    cut.forEach((n, i) => {
      a(n.slash, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 160, delay: i * 110, easing: STD });
      a(n.el,
        [{ opacity: 1, transform: T(n.m, 1) + ' rotate(0deg)' },
         { opacity: 0, transform: T([n.m[0], n.m[1] + 150], 1) + ' rotate(25deg)' }],
        { duration: 520, delay: 560 + i * 60, easing: EXIT });
    });
    edges.filter((e) => !e.hasAttribute('data-keep')).forEach((e) =>
      a(e, [{ opacity: 1 }, { opacity: 0 }], { duration: 200, delay: 560, easing: STD }));
    await wait(1250); if (!live()) return;
    keep.forEach((n) => a(n.el,
      [{ opacity: 1, transform: T(n.m, 1) }, { opacity: 1, transform: T(n.r, 1) }], { duration: 550 }));
    edges.filter((e) => e.hasAttribute('data-keep')).forEach((e) =>
      a(e, [{ opacity: 1 }, { opacity: 0 }], { duration: 150, easing: STD }));
    a(row, [{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 300, easing: STD });
    await wait(1000); if (!live()) return;

    /* 5. Ship the one step that's left. */
    step(4);
    keep.forEach((n) => a(n.el,
      [{ opacity: 1, transform: T(n.r, 1) }, { opacity: 0, transform: T(C, 0.6) }], { duration: 380 }));
    a(row, [{ opacity: 1 }, { opacity: 0 }], { duration: 200, easing: STD });
    a(ball, [{ transform: T(C, 0) }, { transform: T(C, 0.6) }], { duration: 380, delay: 150, easing: SPRING });
    await wait(600); if (!live()) return;
    a(pill, [{ opacity: 0, transform: 'scale(0.7)' }, { opacity: 1, transform: 'scale(1)' }], { duration: 450 });
    a(ball, [{ transform: T(C, 0.6) }, { transform: T(OFF, 1) }], { duration: 450 });
    await wait(800); if (!live()) return;

    /* Switch on: the sketch flips to the finished state in one frame. */
    stage.classList.remove('is-paper');
    a(ball, [{ transform: T(OFF, 1) }, { transform: T(ON, 1) }], { duration: 280, easing: SPRING });
    /* The "40 steps → 1" label is hidden by .is-playing and fades in
       via CSS when settle() removes that class. A WAAPI fill on SVG
       text left its opacity stale after cancel() in Chromium. */
    await wait(600); if (!live()) return;
    settle();
  }

  stage.addEventListener('click', (e) => {
    if (e.target === replay) return;
    if (playing) settle();
  });
  replay.addEventListener('click', play);

  /* Show the empty paper card from the first paint, so the finished
     state never flashes before the story starts. */
  story.classList.add('is-playing');
  stage.classList.add('is-paper', 'is-pending');
  setTimeout(play, 300);
})();
</script>

<script is:inline>
/* About page behaviour: count-ups, in-view hooks. (The X-ray switch lives in
   components/XraySwitch.astro.) */
(function () {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wrap = document.querySelector('.about-wrap');
  if (!wrap) return;
  wrap.classList.add('js');

  /* ---- Polaroids: tap (or Enter) brings one to the front; tap it again,
     tap elsewhere or press Escape to put it back. Hover does the same on
     a mouse, in CSS. ---- */
  const stack = wrap.querySelector('[data-polaroids]');
  if (stack) {
    const cards = Array.from(stack.querySelectorAll('.polaroid'));
    const focusOn = (card) => {
      const on = card && !card.classList.contains('is-focus');
      cards.forEach((c) => c.classList.toggle('is-focus', on && c === card));
      stack.classList.toggle('has-focus', on);
    };
    stack.addEventListener('click', (e) => focusOn(e.target.closest('.polaroid')));
    stack.addEventListener('keydown', (e) => {
      const card = e.target.closest('.polaroid');
      if (card && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); focusOn(card); }
      if (e.key === 'Escape') focusOn(null);
    });
    document.addEventListener('click', (e) => { if (!stack.contains(e.target)) focusOn(null); });
  }

  /* ---- How I work: Before / Now switch. Opens on "before", flips to
     "now" once the first card is in view, unless the visitor got to the
     switch first. Reduced motion stays on "now" and only flips on click. ---- */
  const loopEl = wrap.querySelector('[data-loop]');
  if (loopEl) {
    const btns = Array.from(loopEl.querySelectorAll('[data-loop-mode]'));
    let touched = false;
    const setMode = (mode) => {
      loopEl.dataset.mode = mode;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.loopMode === mode)));
    };
    btns.forEach((b) => b.addEventListener('click', () => { touched = true; setMode(b.dataset.loopMode); }));
    const first = loopEl.querySelector('.loop-card');
    if (!reduce && first && 'IntersectionObserver' in window) {
      setMode('before');
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((en) => en.isIntersecting)) return;
        io.disconnect();
        setTimeout(() => { if (!touched) setMode('now'); }, 1400);
      }, { threshold: 0.6 });
      io.observe(first);
    }
  }

  /* ---- Count-ups: [data-count] with data-from / data-to ---- */
  const counters = Array.from(wrap.querySelectorAll('[data-count]'));
  const lang = () => (window.jjLang ? window.jjLang() : 'en');
  const fmt = (el, v) => {
    const pt = lang() === 'pt';
    const dec = Number(el.dataset.decimals || 0);
    const body = el.dataset.format === 'grouped'
      ? Math.round(v).toLocaleString(pt ? 'pt-PT' : 'en-US')
      : (pt ? v.toFixed(dec).replace('.', ',') : v.toFixed(dec));
    return body + (el.dataset.suffix || '');
  };
  /* Each counter remembers its current value (el._v) so a language switch
     can redraw it in the other number format, mid-animation or at rest. */
  counters.forEach((el) => { el._v = Number(el.dataset.to); });
  const redraw = () => counters.forEach((el) => { el.textContent = fmt(el, el._v); });
  document.addEventListener('jj:langchange', redraw);
  if (lang() === 'pt') redraw();
  function runCount(el) {
    const from = Number(el.dataset.from), to = Number(el.dataset.to);
    const dur = Number(el.dataset.duration || 1100);
    const start = performance.now();
    function frame(now) {
      const t = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el._v = from + (to - from) * eased;
      el.textContent = fmt(el, el._v);
      if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        io.unobserve(en.target);
        runCount(en.target);
      });
    }, { threshold: 0.6 });
    counters.forEach((el) => { el._v = Number(el.dataset.from); el.textContent = fmt(el, el._v); io.observe(el); });
  }

  /* ---- In-view hooks: [data-inview] gets .in once; [data-live] toggles .is-live ---- */
  if ('IntersectionObserver' in window) {
    const once = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        en.target.classList.add('in');
        once.unobserve(en.target);
      });
    }, { threshold: 0.3 });
    wrap.querySelectorAll('[data-inview]').forEach((el) => once.observe(el));

    const live = new IntersectionObserver((entries) => {
      entries.forEach((en) => en.target.classList.toggle('is-live', en.isIntersecting));
    }, { threshold: 0.2 });
    wrap.querySelectorAll('[data-live]').forEach((el) => live.observe(el));
  } else {
    wrap.querySelectorAll('[data-inview]').forEach((el) => el.classList.add('in'));
  }
})();
</script>
