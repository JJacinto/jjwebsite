---
import Base from '../layouts/Base.astro';

/* My Stack — Triple Diamond model.
   Edit `phases` and `alwaysOn` below; markup maps over them.
   Tool names intentionally repeat across phases (Dovetail, Obsidian, Claude)
   with phase-specific reasons — this is signal, not noise. Don't dedupe. */

const phases = [
  {
    id: "discover",
    title: "Discover & Define",
    descriptor: "Understanding the problem before solving it.",
    tools: [
      /* PLACEHOLDER reasons for Figjam + Maze — review wording before publishing. */
      { name: "Figjam",    why: "Where I drag stakeholders before anyone opens Figma" },
      { name: "Maze",      why: "When I need signal in a day, not a research sprint" },
      { name: "Dovetail",  why: "The only way I've found to keep research from rotting in Notion" },
    ],
  },
  {
    id: "develop",
    title: "Develop & Deliver",
    descriptor: "Turning the problem into something shippable.",
    tools: [
      { name: "Figma",      why: "Components, specs, and the thing devs actually open" },
      { name: "Jitter",     why: "Stills lie about how an interaction feels" },
      { name: "Retune.dev", why: "My visual layer when I'm coding the portfolio you're reading" },
    ],
  },
  {
    id: "deploy",
    title: "Deploy & Learn",
    descriptor: "Measuring what shipped, deciding what's next.",
    /* PLACEHOLDER reasons for Fullstory / Mixpanel / Looker — review before publishing. */
    tools: [
      { name: "Fullstory", why: "Session replays catch the bugs analytics won't" },
      { name: "Mixpanel",  why: "Funnel and event tracking to measure what shipped" },
      { name: "Looker",    why: "Dashboards for the metrics that matter after launch" },
    ],
  },
];

const alwaysOn = [
  {
    id: "comms",
    title: "Working with people",
    /* PLACEHOLDER reasons — replace before publishing. Defaults per spec. */
    tools: [
      { name: "Slack",  why: "Async team comms" },
      { name: "Loom",   why: "Replaces unnecessary 30-min meetings" },
      { name: "Linear", why: "Tracking work across teams" },
      { name: "Notion", why: "Shared docs and meeting notes across teams" },
    ],
  },
  {
    id: "system",
    title: "Daily drivers",
    /* PLACEHOLDER reason for Obsidian — review before publishing. */
    tools: [
      { name: "Raycast",   why: "Windows, launching, snippets" },
      { name: "Wisprflow", why: "Faster than typing for 1st drafts" },
      { name: "Claude",    why: "Pair-thinking, writing, reviews" },
      { name: "Gemini",    why: "Second opinion after Claude's" },
    ],
  },
  {
    id: "capture",
    title: "Hardware that earned its spot",
    /* PLACEHOLDER reasons — review and tune the one-liners before publishing. */
    tools: [
      { name: "Steelcase Leap v2",   why: "Where I sit 8+ hours a day" },
      { name: "Odyssey G9",          why: "One screen, every window" },
      { name: "Logitech MX Keys",    why: "Low-profile, quiet, multi-device" },
      { name: "HEDDphone D1",        why: "Monitoring, calls, and music" },
    ],
  },
];
---
<Base
  activePage="about"
  title="About — João Jacinto"
  description="I design products that make things genuinely easier for the people who use them. Senior Product Designer based in Aveiro, Portugal."
  showCta={true}
>

  <div class="about-wrap">
    <div class="marquee about-marquee">
      <div class="marquee-track">
        <span>ABOUT ME</span><span>·</span><span>SOBRE MIM</span><span>·</span>
        <span>ABOUT ME</span><span>·</span><span>SOBRE MIM</span><span>·</span>
        <span>ABOUT ME</span><span>·</span><span>SOBRE MIM</span><span>·</span>
      </div>
    </div>

    <div class="container">

      <section class="why-grid reveal">
        <div>
          <h2>I turn tangled problems into products people don't have to think about.</h2>
        </div>
        <div>
          <p>I design for the moments where complexity is non-negotiable — products built on dense rule sets, layered permissions, or workflows that have to hold up under real operational weight. My approach is to systems-think first and design second: map the relationships, expose the logic, then strip away everything that isn't load-bearing.</p>
          <p>None of that works without staying close to the people using the product — learning from them, sitting with their feedback, and letting it shape the next decision. The goal is always the same: the person using the product should feel like the hard part was solved before they arrived. I work async by default, write things down, and share context early so the rest of the team isn't left chasing it.</p>
        </div>
      </section>

      <hr class="section-divider">

      <section class="about-me">
        <div class="about-grid">
          <div class="about-col reveal reveal-d1">
            <h3>Type</h3>
            <ul>
              <li>MBTI: <a href="https://www.16personalities.com/intj-personality" target="_blank" rel="noopener noreferrer">INTJ-A</a></li>
              <li>Enneagram: <a href="https://www.enneagraminstitute.com/type-5/" target="_blank" rel="noopener noreferrer">Type 5</a></li>
              <li>DISC: <a href="https://www.discprofile.com/disc-styles/steadiness/sc-disc-personality" target="_blank" rel="noopener noreferrer">SC-SC</a></li>
            </ul>
          </div>
          <div class="about-col reveal reveal-d2">
            <h3>Principles</h3>
            <ul>
              <li>Make the invisible visible</li>
              <li>Cut what isn't load-bearing</li>
              <li>Stay close to the people using it</li>
              <li>Optimise for the next designer</li>
              <li>Strong opinions, written down</li>
            </ul>
          </div>
          <div class="about-col reveal reveal-d3">
            <h3>Passions</h3>
            <ul>
              <li>Product Design</li>
              <li>Music production, drums</li>
              <li>Building with AI</li>
              <li>Gaming</li>
              <li>Football, Padel tennis</li>
            </ul>
          </div>
        </div>
      </section>

      <hr class="section-divider">

      <h2 class="stack-title reveal">My journey</h2>

      <div class="timeline">
      <section class="journey">
        <div class="journey-row reveal">
          <div class="journey-year">2024–now</div>
          <div>
            <div class="journey-title">
              <span class="journey-role">Member of Product Design Team (Senior IC)</span>
              <a class="journey-co" data-umami-event="about-company" data-umami-event-co="anchorage" href="https://www.anchorage.com" target="_blank" rel="noopener noreferrer">at Anchorage Digital</a>
            </div>
            <p class="journey-desc">Crypto/web3 infrastructure for institutional clients — Core Experience</p>
            <ul class="journey-achievements">
              <li class="journey-achievement">Redesigned the policies and permissions system — collapsed a 40-step admin flow into a single configuration step</li>
            </ul>
          </div>
        </div>
        <div class="journey-row reveal">
          <div class="journey-year">2022–2024</div>
          <div>
            <div class="journey-title">
              <span class="journey-role">Senior → Staff Product Designer</span>
              <a class="journey-co" data-umami-event="about-company" data-umami-event-co="streamyard" href="https://streamyard.com" target="_blank" rel="noopener noreferrer">at StreamYard</a>
            </div>
            <p class="journey-desc">Live streaming SaaS. Webinars product UX, research ops, and the design system.</p>
            <ul class="journey-achievements">
              <li class="journey-achievement">Tripled weekly webinar volume after shipping the customisation feature</li>
            </ul>
          </div>
        </div>
        <div class="journey-row reveal">
          <div class="journey-year">2021–2022</div>
          <div>
            <div class="journey-title">
              <span class="journey-role">Senior Product Designer</span>
              <a class="journey-co" data-umami-event="about-company" data-umami-event-co="talkdesk" href="https://www.talkdesk.com" target="_blank" rel="noopener noreferrer">at Talkdesk</a>
            </div>
            <p class="journey-desc">AI trainer for customer support — pre-LLM era.</p>
            <ul class="journey-achievements">
              <li class="journey-achievement">Redesigned the human-in-the-loop labeling tool that CX teams used to train conversational AI models — pre-LLM era</li>
            </ul>
          </div>
        </div>
        <div class="journey-row reveal">
          <div class="journey-year">2017–2021</div>
          <div>
            <div class="journey-title">
              <span class="journey-role">Product Designer</span>
              <a class="journey-co" data-umami-event="about-company" data-umami-event-co="namecheap" href="https://www.namecheap.com" target="_blank" rel="noopener noreferrer">at Namecheap</a>
            </div>
            <p class="journey-desc">Domains & hosting. Internal support tooling, iterating with 200+ agents daily.</p>
            <ul class="journey-achievements">
              <li class="journey-achievement">Hit 97.4% positive feedback within 4 months of launching the new chat &amp; support experience</li>
            </ul>
          </div>
        </div>
        <div class="journey-row reveal">
          <div class="journey-year">2015–2017</div>
          <div>
            <div class="journey-title">
              <span class="journey-role">UX/UI Designer</span>
              <a class="journey-co" data-umami-event="about-company" data-umami-event-co="beubi" href="https://github.com/beubi" target="_blank" rel="noopener noreferrer">at Be.Ubi</a>
            </div>
            <p class="journey-desc">3D printing software, plus a land registry system for a Portuguese municipality.</p>
            <ul class="journey-achievements">
              <li class="journey-achievement">Rebuilt the 3D printing software after embedding with the team and running client interviews</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="influences">
        <span class="eyebrow reveal">Roots &amp; Influences</span>
        <div class="influences-layout reveal reveal-d1">

          <div class="influences-narrative">
            <p>The line between design and engineering has always been a tool for me, not a fence.</p>
            <p>I was doing digital branding for friends at 13 — logos, profile graphics, whatever they needed — before I'd even thought of it as design. By 15 I was shipping front-end code: themes for Hi5 and MySpace, some pulling 50,000+ concurrent users. That loop of making something, watching people use it, and learning from what breaks set the pattern early.</p>
            <p>IT engineering taught me how products work; multimedia design was where I learned how they communicate. I pivoted because the second half was the one I couldn't stop thinking about — but I've kept both halves active. A decade across enterprise SaaS, crypto, live streaming, and AI tooling later, the engineering half still shapes how I design: I scope what's buildable, talk tradeoffs in engineers' language, and ship the real interaction when a mock can't carry the argument. With AI in the loop, that fluency matters more, not less — prompting a model to build something is still an engineering conversation, just at a higher level.</p>
          </div>

          <div class="influences-right" style="display:none">
            <div class="influences-block">
              <h3>Resources I learn from</h3>
              <div class="avatar-grid">
                <a class="avatar-item" href="https://www.nngroup.com" target="_blank" rel="noopener noreferrer" aria-label="Nielsen Norman Group">
                  <img src="/assets/influences/nngroup.png" alt="Nielsen Norman Group" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://stratechery.com" target="_blank" rel="noopener noreferrer" aria-label="Stratechery">
                  <img src="/assets/influences/stratechery.png" alt="Stratechery" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://www.lennysnewsletter.com" target="_blank" rel="noopener noreferrer" aria-label="Lenny's Newsletter">
                  <img src="/assets/influences/lennys.png" alt="Lenny's Newsletter" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://paulgraham.com/essays.html" target="_blank" rel="noopener noreferrer" aria-label="Paul Graham Essays">
                  <img src="/assets/influences/paulgraham.png" alt="Paul Graham Essays" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://www.figma.com/blog/" target="_blank" rel="noopener noreferrer" aria-label="Figma Blog">
                  <img src="/assets/influences/figma.png" alt="Figma Blog" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://linear.app/blog" target="_blank" rel="noopener noreferrer" aria-label="Linear Blog">
                  <img src="/assets/influences/linear.png" alt="Linear Blog" width="200" height="200" loading="lazy">
                </a>
              </div>
            </div>

            <div class="influences-block">
              <h3>People who shape how I think</h3>
              <div class="avatar-grid">
                <a class="avatar-item" href="https://en.wikipedia.org/wiki/Dieter_Rams" target="_blank" rel="noopener noreferrer" aria-label="Dieter Rams">
                  <img src="/assets/influences/dieter-rams.jpg" alt="Dieter Rams" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://jnd.org" target="_blank" rel="noopener noreferrer" aria-label="Don Norman">
                  <img src="/assets/influences/don-norman.jpg" alt="Don Norman" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://www.juliezhuo.com" target="_blank" rel="noopener noreferrer" aria-label="Julie Zhuo">
                  <img src="/assets/influences/julie-zhuo.jpg" alt="Julie Zhuo" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://en.wikipedia.org/wiki/Jony_Ive" target="_blank" rel="noopener noreferrer" aria-label="Jony Ive">
                  <img src="/assets/influences/jony-ive.jpg" alt="Jony Ive" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://en.wikipedia.org/wiki/Paul_Rand" target="_blank" rel="noopener noreferrer" aria-label="Paul Rand">
                  <img src="/assets/influences/paul-rand.jpg" alt="Paul Rand" width="200" height="200" loading="lazy">
                </a>
                <a class="avatar-item" href="https://en.wikipedia.org/wiki/John_Maeda" target="_blank" rel="noopener noreferrer" aria-label="John Maeda">
                  <img src="/assets/influences/john-maeda.jpg" alt="John Maeda" width="200" height="200" loading="lazy">
                </a>
              </div>
            </div>
          </div>

        </div>
      </section>
      </div>

      <hr class="section-divider">

      <h2 class="stack-title reveal">My Process and Tools</h2>

      <section class="stack reveal" aria-label="My Stack">

        <div class="phase-list">
          {phases.map((phase) => (
            <div class="phase-row">
              <div class="phase-meta">
                <h3 class="phase-title">{phase.title}</h3>
                <p class="phase-descriptor"><em>{phase.descriptor}</em></p>
              </div>
              <dl class="phase-tools">
                {phase.tools.map((t) => (
                  <div class="phase-item">
                    <dt>{t.name}</dt>
                    <dd>{t.why}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>

        <div class="always-on">
          <p class="always-on-intro"><em>Everything else</em></p>
          <div class="always-on-grid">
            {alwaysOn.map((group) => (
              <div class="always-on-group">
                <h3 class="always-on-title">{group.title}</h3>
                <dl class="always-on-tools">
                  {group.tools.map((t) => (
                    <div class="always-on-item">
                      <dt>{t.name}</dt>
                      <dd>{t.why}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </div>

      </section>

    </div>
  </div>

  <script is:inline>
    /* Phase timeline — fill the diamond marker once a phase has scrolled past
       the upper portion of the viewport. Mirrors the journey timeline above. */
    (function () {
      const phases = document.querySelectorAll('.phase-row');
      if (!phases.length) return;
      function update() {
        /* Fill only once the phase has fully scrolled past — i.e. its bottom
           edge is above the nav bar. While scrolling through the phase
           itself, the lozenge stays unfilled. */
        const trigger = 80;
        phases.forEach((p) => {
          const rect = p.getBoundingClientRect();
          p.classList.toggle('phase-passed', rect.bottom < trigger);
        });
      }
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    })();
  </script>

</Base>
