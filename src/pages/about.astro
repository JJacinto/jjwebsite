            <div class="b-play-host" aria-hidden="true"><div data-play-host></div></div>
            <script is:inline>
              (() => {
                const btn = document.querySelector('[data-play]');
                if (!btn) return;
                const card = btn.closest('.b-music');
                let player = null, pending = false;
                const set = (on) => { btn.setAttribute('aria-pressed', String(on)); card.classList.toggle('is-playing', on); };
                const build = () => {
                  player = new YT.Player(card.querySelector('[data-play-host]'), {
                    host: 'https://www.youtube-nocookie.com',
                    width: 1, height: 1,
                    videoId: btn.dataset.video,
                    playerVars: { start: +btn.dataset.start, autoplay: 1, controls: 0, playsinline: 1, rel: 0 },
                    events: {
                      onReady: (e) => e.target.playVideo(),
                      onStateChange: (e) => set(e.data === YT.PlayerState.PLAYING || e.data === YT.PlayerState.BUFFERING),
                    },
                  });
                };
                btn.addEventListener('click', () => {
                  if (player && player.getPlayerState) {
                    const s = player.getPlayerState();
                    if (s === YT.PlayerState.PLAYING || s === YT.PlayerState.BUFFERING) { player.pauseVideo(); set(false); }
                    else {
                      if (s === YT.PlayerState.ENDED) player.seekTo(+btn.dataset.start, true);
                      player.playVideo(); set(true);
                    }
                    return;
                  }
                  if (pending) return;
                  pending = true; set(true);
                  if (window.YT && window.YT.Player) return build();
                  const prev = window.onYouTubeIframeAPIReady;
                  window.onYouTubeIframeAPIReady = () => { prev && prev(); build(); };
                  const s = document.createElement('script');
                  s.src = 'https://www.youtube.com/iframe_api';
                  s.onerror = () => { pending = false; set(false); };
                  document.head.appendChild(s);
                });
              })();
            </script>
