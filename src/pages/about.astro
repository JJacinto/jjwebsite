---
import Base from '../layouts/Base.astro';
import XraySwitch from '../components/XraySwitch.astro';
import Journey from '../components/about/Journey.astro';

/* Equaliser bars for the "Now producing" card. Heights are fixed here so
   the markup is deterministic: --lo/--hi are the scaleY range, --d the
   cycle time, --i the delay seed. Static end state is --hi. */
const bars = Array.from({ length: 24 }, (_, i) => {
  const hi = 0.35 + ((i * 37) % 61) / 100;
  const lo = 0.12 + ((i * 17) % 23) / 100;
  const d = 700 + ((i * 53) % 9) * 70;
  return { i, hi: Math.min(hi, 1).toFixed(2), lo: lo.toFixed(2), d };
});

const photos = [
  { src: '/assets/images/photo-astronaut.webp', cap: 'Trained for zero gravity. Employed for zero margin.', capPt: 'Treinado para gravidade zero. Contratado para margem zero.', k: -2, rot: -6 },
  { src: '/assets/images/photo-padel.webp', cap: 'Smash intent. Lob outcome.', capPt: 'Intenção de smash. Resultado: lob.', k: -1, rot: 3 },
  { src: '/assets/images/photo-tickets.webp', cap: 'Itinerary: aspirational. Carry-on: overpacked.', capPt: 'Itinerário: ambicioso. Bagagem de mão: a rebentar pelas costuras.', k: 0, rot: -2 },
  { src: '/assets/images/photo-vr.webp', cap: '911 in VR. EV in the garage. Identity crisis.', capPt: 'Um 911 em VR. Um elétrico na garagem. Crise de identidade.', k: 1, rot: 5 },
  { src: '/assets/images/photo-guitar.webp', cap: 'Practicing quietly. The neighbors disagree.', capPt: 'A praticar baixinho. Os vizinhos discordam.', k: 2, rot: 4 },
];

/* Line-art scenes for the photos card, one per photo, in the same order.
   Drawn in a 480 x 440 box, all inside its top strip (y 12 to 118), which
   the open photos leave free. */
/* Nordschleife outline: the "Nürburgring Nordschleife" route from
   OpenStreetMap (© OpenStreetMap contributors, ODbL), simplified to 139
   points and fitted to a 130 x 104 box, in driving direction. */
const ringPath = 'M81.9 75.9L60 89.8L55.1 95.6L53.6 98.3L51.5 100.4L50.6 102L49 102.1L47.4 103.1L45.4 101.7L43.1 99.2L42.3 99.7L40.7 102.4L37.9 103.9L36.6 103.9L32.8 102.3L30.3 102.1L29.1 102.5L28.4 102.4L27.4 101.6L26.6 100.1L25.3 99.1L24.7 97.8L20.9 96.8L20.1 94.7L13.9 90.2L9.2 84.4L8.9 81.6L10.1 78.5L10.6 74.4L9.8 68.8L5.9 59.6L4.2 57.8L0.4 55.9L0 55.2L0.2 54.3L0.8 53.8L6 51.4L8.7 49.3L13.8 44.4L15.8 40.2L15.9 37.1L17.7 35.2L17.1 33.7L17.1 33.1L20.8 30L25.2 25.5L26.6 23.4L27 21.9L26 18.5L25.4 18.2L23.6 18L21 16.3L20.7 15.6L21 14.8L23.5 13.5L25.2 12.1L25.7 10.1L27.1 8L28.5 7.2L30.2 7.5L33.8 9.9L34.5 11.2L35.1 11.5L36.2 10.3L37.6 10L41.5 9.7L45 10.3L46.2 8.5L46.3 6.3L50.6 4.4L57.1 2.8L60.7 0.2L61.9 0L62.6 0.6L62.9 1.8L62.9 7.8L63.4 10.1L65.1 12.4L66.8 13.6L71.1 15.4L75.2 15.3L80.2 15.9L83.7 16.9L87.5 19.3L90.7 20.7L92.3 20.4L94.4 19.3L98.7 16L104.7 14.9L105.4 15.6L105.2 16.8L99.9 20.9L99.7 21.6L100.3 22.1L100.9 21.9L101.5 20.7L103 19.5L106.6 18.3L109 17.9L110.9 16.5L112.5 14.3L112.5 11.9L113.8 9.9L114.5 9.5L120.4 11.4L122.3 13.5L124.9 14.2L127.1 16.8L127.3 18.2L126 22L127.2 23.3L129.7 24.3L130.1 28.3L129.2 29.1L125.1 28.9L124 29.3L123.3 30.9L121.8 32.9L121 34.9L121.2 40.4L120.9 41.2L119.7 42.4L116.8 43.5L114.6 46L112.6 49.6L108.8 52.2L102.5 54.2L100.7 54.4L99.8 54.1L97.8 52.6L97 52.4L93.4 54.6L93.1 55.7L94.4 57.1L99.6 59.3L100.9 62.1L100.6 64.4L99.5 65.5Z';
const rulerTicks = Array.from({ length: 23 }, (_, i) => `M${20 + i * 20} 5v${i % 5 === 0 ? 8 : 4}`).join('')
  + Array.from({ length: 6 }, (_, i) => `M5 ${20 + i * 20}h${i % 5 === 0 ? 8 : 4}`).join('');
const stars = Array.from({ length: 26 }, (_, i) => ({
  x: 24 + ((i * 137) % 436),
  y: 22 + ((i * 53) % 92),
  r: 0.8 + ((i * 7) % 4) * 0.3,
  tw: i % 3 === 0,
  d: ((i * 0.37) % 3).toFixed(2),
}));
const strings = [40, 50, 60, 70, 80, 90];
const frets = [262, 299, 334, 367, 398, 427, 454];

/* How I work. `body` and `tools` are the stack before LLMs; `now` and
   `plus` are what the same step looks like today (the same three
   chips on every card). The section's switch flips between the two. */
const plus = ['MCPs', 'Skills', 'Plugins'];
const loop = [
  { n: '01', name: 'Talk', namePt: 'Conversa', bodyPt: 'Começo pela conversa, não pelo Figma. Os piores erros que vi começaram num ecrã em branco.', nowPt: 'Continua a ser uma conversa. Uma mensagem, uma chamada, uma transcrição. Qualquer uma pode dar o brief.', body: "I start in conversation, not in Figma. The worst mistakes I've seen began on a blank canvas.", tools: ['Slack', 'FigJam', 'Dovetail', 'Maze'], drop: ['FigJam', 'Dovetail', 'Maze'],
    now: 'Still a conversation. A chat, a call, a transcript. Any of them can become the brief.' },
  { n: '02', name: 'Map', namePt: 'Mapear', bodyPt: 'Primeiro o sistema, depois os ecrãs: como as coisas se relacionam, que regras dependem de quais.', nowPt: 'Arrumar as ideias num quadro branco ainda vale mais do que qualquer prompt. Os MCPs ligam as ferramentas, e o mapa bate com o sistema real.', body: 'System first, screens second: how things relate, which rules depend on which.', tools: ['FigJam', 'Notion'], drop: [],
    now: 'Sorting my thoughts on a whiteboard still beats any prompt. MCPs link the tools, so the map matches the real system.' },
  { n: '03', name: 'Cut', namePt: 'Cortar', bodyPt: 'Depois corto o que ninguém daria por falta. A complexidade que tem de ficar, torno-a visível.', nowPt: 'Cortar continua a ser comigo. As skills verificam cada passagem com as mesmas regras.', body: 'Then I cut whatever nobody would miss. The complexity that has to stay, I make visible.', tools: ['Figma', 'Jitter', 'Retune.dev'], drop: ['Figma', 'Jitter'],
    now: 'The cutting is still mine. Skills check every pass against the same rules.' },
  { n: '04', name: 'Ship', namePt: 'Lançar', bodyPt: 'O Figma é o contrato. Se o developer abre o ficheiro e nada o surpreende, fiz o meu trabalho.', nowPt: 'O handoff não deve trazer surpresas. Os plugins e o Claude Code tratam do trabalho repetitivo. Eu revejo.', body: "Figma is the contract. If the dev opens the file and nothing surprises them, I've done my job.", tools: ['Figma', 'Linear', 'Loom', 'Slack'], drop: ['Figma', 'Loom'],
    now: 'The handoff should hold no surprises. Plugins and Claude Code handle the repeat work. I review it.' },
  { n: '05', name: 'Measure', namePt: 'Medir', bodyPt: 'Lançar não é acabar. É aqui que vejo se tinha razão. Quase nunca por inteiro. Isto é o ciclo.', nowPt: 'As automações trazem-me os números todas as semanas. Vejo mais cedo onde errei. Isto é o ciclo.', body: "Shipped isn't done. This is where I find out if I was right. Rarely entirely. That's the loop.", tools: ['Fullstory', 'Mixpanel', 'Looker'], drop: ['Fullstory'],
    now: "Automations bring me the numbers every week, so I see where I was wrong sooner. That's the loop." },
];
---
<Base
  activePage="about"
  breadcrumb={[{ name: 'About', namePt: 'Sobre', path: '/about/' }]}
  title="About — João Jacinto"
  titlePt="Sobre — João Jacinto"
  description="I design products that make complicated things easier for the people who use them. Senior Product Designer based in Aveiro, Portugal."
  descriptionPt="Desenho produtos que tornam as coisas complicadas mais fáceis para quem as usa. Senior Product Designer em Aveiro, Portugal."
  showCta={true}
>

  <div class="about-wrap">
    <!-- X-ray grid: the 12-column grid of the 1140px container. Only
         visible while the X-ray switch is on. -->
    <div class="xray-grid" aria-hidden="true">
      <div class="xray-grid-inner">
        <span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="container">

      <!-- Story hero, told as a planet clearing its orbit: a comet leaves
           a tangle, it breaks into bodies, they settle into orbits, the
           ones nobody would miss are thrown out, and the rest merge into
           one planet on one orbit, which becomes the switch. The SVG's resting markup is the final
           frame, so no-JS and reduced-motion visitors see the outcome
           and all five steps. The script at the bottom of this file
           plays it once on load. -->
      <section class="about-story about-section" data-about-story data-xray data-xray-gap="128">
        <aside class="xray-note" data-xray-note data-pt="A maioria das páginas Sobre abre com uma biografia. Esta abre com o método, mostrado no redesenho da Anchorage: um emaranhado, arrumado em órbitas, limpo até sobrar um passo. Passa uma vez; com movimento reduzido ou sem JavaScript vê-se logo o último fotograma.">Most About pages open with a bio. This one opens with the method, shown on the Anchorage redesign: a tangle, sorted into orbits, cleared down to one step. It plays once, and reduced motion or no JavaScript gets the last frame straight away.</aside>

        <div class="about-story-head">
          <p class="about-intro">
            <img class="about-intro-avatar" src="/assets/images/photo.webp" alt="João Jacinto" width="40" height="40">
            <span data-pt="João Jacinto · Design and Product Engineer na Anchorage Digital">João Jacinto · Design and Product Engineer at Anchorage Digital</span>
          </p>
          <h1 class="about-story-title" data-pt="Transformo emaranhados num só passo claro.">I turn tangles into one clear step.</h1>
        </div>

        <div class="about-story-stage" aria-hidden="true">
          <svg viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg">
            <path class="st-tangle" pathLength="1" d="M92,196C120,96 236,70 286,128C332,182 250,262 190,222C128,180 196,86 276,98C366,112 398,214 330,258C262,302 150,280 150,206C150,138 236,118 276,160C312,198 286,250 240,244C196,238 190,186 228,170C262,156 300,186 284,214C330,236 380,206 392,160"/>

            <!-- The system the pieces settle into: a star and four orbits.
                 data-main is the one that stays; data-w is how fast a body
                 runs it, in radians a second (negative runs it backwards). -->
            <circle class="st-sun" cx="240" cy="170" r="6"/>
            <g class="st-orbits">
              <g><ellipse class="st-orbit" data-main data-w="0.5" cx="240" cy="170" rx="150" ry="70"/></g>
              <g transform="rotate(-18 240 170)"><ellipse class="st-orbit" data-rot="-18" data-w="0.35" cx="240" cy="170" rx="190" ry="110"/></g>
              <g transform="rotate(25 240 170)"><ellipse class="st-orbit" data-rot="25" data-w="-0.45" cx="240" cy="170" rx="95" ry="150"/></g>
              <g><ellipse class="st-orbit" data-w="0.9" cx="240" cy="170" rx="80" ry="34"/></g>
            </g>

            <!-- data-s = scattered position, data-o = which orbit it joins,
                 data-a = where on it, in degrees. data-cut bodies are thrown
                 out; the rest share the main orbit and merge. -->
            <g class="st-nodes">
              <g class="st-node" data-s="236,150" data-o="0" data-a="108"><circle r="8"/></g>
              <g class="st-node" data-s="96,188"  data-o="0" data-a="228"><circle r="8"/></g>
              <g class="st-node" data-s="372,172" data-o="1" data-a="20" data-cut><circle r="8"/><path class="st-slash" pathLength="1" d="M-13,11L13,-11"/></g>
              <g class="st-node" data-s="132,84"  data-o="0" data-a="348"><circle r="8"/></g>
              <g class="st-node" data-s="178,286" data-o="2" data-a="200" data-cut><circle r="8"/><path class="st-slash" pathLength="1" d="M-13,11L13,-11"/></g>
              <g class="st-node" data-s="300,292" data-o="1" data-a="190" data-cut><circle r="8"/><path class="st-slash" pathLength="1" d="M-13,11L13,-11"/></g>
              <g class="st-node" data-s="330,72"  data-o="3" data-a="80" data-cut><circle r="8"/><path class="st-slash" pathLength="1" d="M-13,11L13,-11"/></g>
            </g>

            <rect class="st-pill" x="180" y="142" width="120" height="56" rx="28"/>
            <circle class="st-ball" r="20"/>
            <text class="st-result" x="240" y="250" text-anchor="middle" data-pt="40 passos → 1">40 steps → 1</text>
          </svg>
          <!-- The particles that gather into the tangle and then collapse
               into the pieces. Larger than the stage, so they arrive from
               outside it. -->
          <canvas class="st-dust"></canvas>
          <button class="about-story-replay" type="button" hidden data-umami-event="about-story-replay" data-pt="Repetir">Replay</button>
        </div>

        <div class="about-story-copy">
          <ol class="about-story-steps">
            <li data-pt="Pegar no emaranhado tal como está.">Take the tangle as it is.</li>
            <li data-pt="Desfazê-lo nas suas partes.">Break it into its parts.</li>
            <li data-pt="Ver o que orbita o quê.">Find what orbits what.</li>
            <li data-pt="Limpar a órbita do que ninguém daria por falta.">Clear the orbit of what nobody would miss.</li>
            <li data-pt="Lançar o único passo que sobra.">Launch the one step that's left.</li>
          </ol>
          <p class="about-story-note" data-pt="Esta é a história do redesenho das políticas e permissões na Anchorage Digital.">That's the story of the policies and permissions redesign at Anchorage Digital.</p>

          <!-- Anchorage 2026 Impact Award: recognition only, no figures. -->
          <figure class="about-award">
            <svg class="about-award-medal" viewBox="0 0 40 48" aria-hidden="true">
              <path class="about-award-ribbon" d="M12 2h7l-4 16h-7zM21 2h7l4 16h-7z"/>
              <circle class="about-award-disc" cx="20" cy="30" r="14"/>
              <circle class="about-award-ring" cx="20" cy="30" r="10"/>
              <path class="about-award-star" d="M20 23.5l1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z"/>
            </svg>
            <figcaption>
              <span class="about-award-title" data-pt="Impact Award 2026 · Anchorage Digital">2026 Impact Award · Anchorage Digital</span>
              <span class="about-award-text" data-pt="Atribuído por um impacto fora do comum nos objetivos e na cultura da empresa: por mexer, de forma consistente, nos objetivos mais ambiciosos, vivendo os pilares da cultura que nos definem.">Given for outsized impact on the company's goals and culture, for consistently moving the needle on its most ambitious goals while embodying the culture pillars that define it.</span>
            </figcaption>
          </figure>

          <XraySwitch wrap=".about-wrap" />
        </div>
      </section>

      <!-- How I work -->
      <!-- The markup rests on "now", so no-JS and reduced-motion visitors
           get today's stack. With JS it opens on "before" and flips to
           "now" once the cards are in view; the switch flips it back. -->
      <section id="loop" class="about-section loop" data-loop data-mode="now" data-live data-xray data-xray-gap="128" aria-labelledby="loop-title">
        <aside class="xray-note" data-xray-note data-pt="Quem contrata um designer hoje quer saber como trabalha com IA. O interruptor responde por comparação: os cinco passos ficam onde estão, mudam as ferramentas e quem as corre. Eu estou na linha «Feito por» dos dois lados.">Anyone hiring a designer now wants to know how they work with AI. The switch answers by comparison: the five steps stay where they are, the tools and who runs them change. I'm in the Run by row on both sides.</aside>

        <div class="about-head">
          <span class="eyebrow reveal" data-pt="Como trabalho">How I work</span>
          <h2 id="loop-title" class="about-head-narrow reveal reveal-d1" data-pt="Encontrar a menor versão do problema real. Depois construir a menor versão de uma resposta a sério.">Find the smallest version of the real problem. Then build the smallest version of a real answer.</h2>
        </div>

        <div class="loop-switch reveal reveal-d2">
          <div class="loop-seg" role="group" aria-label="Which stack to show" data-pt-aria-label="Que stack mostrar">
            <span class="loop-seg-thumb" aria-hidden="true"></span>
            <button type="button" data-loop-mode="before" aria-pressed="false" data-umami-event="about-stack-before" data-pt="Antes">Before</button>
            <button type="button" data-loop-mode="now" aria-pressed="true" data-umami-event="about-stack-now" data-pt="Agora">Now</button>
          </div>
          <p class="loop-caption" aria-live="polite">
            <span data-when="before" data-pt="A minha stack antes dos LLMs. Cada passo à mão.">My stack before LLMs. Every step by hand.</span>
            <span data-when="now" data-pt="A minha stack agora. Os mesmos cinco passos, com o trabalho braçal automatizado.">My stack now. Same five steps, with the legwork automated.</span>
          </p>
        </div>

        <div class="loop-track">
          <span class="loop-line" data-inview aria-hidden="true"></span>
          <ol class="loop-row">
            {loop.map((s, i) => (
              <li class={`loop-card reveal reveal-d${Math.min(i + 1, 4)}`} style={`--i:${i}`}>
                <span class="loop-num">{s.n}</span>
                <h3 class="loop-name" data-pt={s.namePt}>{s.name}</h3>
                <div class="loop-bodies">
                  <p class="loop-body" data-when="before" data-pt={s.bodyPt}>{s.body}</p>
                  <p class="loop-body" data-when="now" data-pt={s.nowPt}>{s.now}</p>
                </div>
                <ul class="loop-tools">
                  {s.tools.map((t) => <li class={s.drop?.includes(t) ? 'loop-drop' : undefined} data-when={s.drop?.includes(t) ? 'before' : undefined}>{t}</li>)}
                  {plus.map((p) => <li class="loop-plus" data-when="now">{p}</li>)}
                </ul>
                <span class="loop-feed" aria-hidden="true"></span>
              </li>
            ))}
          </ol>

          <div class="loop-bus reveal reveal-d4">
            <span class="loop-bus-label" data-pt="Feito por">Run by</span>
            <ul class="loop-runners">
              <li class="loop-runner" data-pt="Eu">Me</li>
              <li class="loop-runner" data-when="now" style="--i:1">Claude Code</li>
              <li class="loop-runner" data-when="now" style="--i:2">Gemini</li>
              <li class="loop-runner loop-runner--home" data-when="now" style="--i:3">
                <svg class="loop-home" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path d="M2 7.5 8 2.5l6 5V14H2z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                  <circle class="loop-home-led" cx="8" cy="10.2" r="1.6"/>
                </svg>
                <span data-pt="LLMs locais">Local LLMs</span> <small data-pt="em casa">at home</small>
              </li>
            </ul>
            <p class="loop-repeat"><span aria-hidden="true">↺</span> <span data-pt="repetir">repeat</span></p>
          </div>
        </div>

        <p class="loop-foot reveal" data-pt="O Claude Code e o Gemini fazem a maior parte do trabalho pesado. Parte corre em modelos locais, numa máquina que tenho em casa. As ferramentas mudam de poucos em poucos anos. O hábito não.">Claude Code and Gemini do most of the lifting. Some of it runs on local models, on a machine I keep at home. The tools change every few years. The habit doesn't.</p>
      </section>

      <!-- Principles -->
      <section class="about-section principles" data-xray data-xray-gap="128" aria-labelledby="principles-title">
        <aside class="xray-note" data-xray-note data-pt="Princípios são fáceis de escrever e difíceis de acreditar. São só quatro, cada um ligado a um passo do ciclo acima, e cada cartão põe a sua regra em prática quando passas o rato ou chegas lá com o Tab.">Principles are easy to write and hard to believe. There are only four, each tied to a step of the loop above, and each card acts out its own rule when you hover it or tab to it.</aside>

        <div class="about-head">
          <span class="eyebrow reveal" data-pt="Princípios">Principles</span>
          <h2 id="principles-title" class="about-head-narrow reveal reveal-d1" data-pt="Quatro regras a que volto sempre.">Four rules I keep coming back to.</h2>
        </div>

        <!-- One card per step of the loop above: Talk (and Measure),
             Map, Cut, Ship. -->
        <div class="p-grid">
          <article class="p-card reveal reveal-d1" tabindex="0">
            <div class="p-demo" aria-hidden="true">
              <span class="tap-hint"></span>
              <div class="d3-stage">
                <span class="d3-line"></span>
                <span class="d3-dot d3-dot--me"><i></i><em data-pt="eu">me</em></span>
                <span class="d3-dot d3-dot--them"><i></i><em data-pt="eles">them</em></span>
              </div>
            </div>
            <h3 class="p-title" data-pt="Ficar perto de quem usa.">Stay close to the people using it.</h3>
            <p class="p-body" data-pt="Começo pelas palavras deles e volto aos números deles. O que dizem decide o próximo passo, não o último slide da apresentação.">I start with their words and come back to their numbers. What they say shapes the next decision, not the last slide of the deck.</p>
          </article>

          <article class="p-card reveal reveal-d2" tabindex="0">
            <div class="p-demo p-demo--grid" aria-hidden="true">
              <span class="tap-hint"></span>
              <div class="d1-grid"></div>
              <div class="d1-mock">
                <i class="d1-bar d1-bar--a"></i>
                <b class="d1-gap" data-v="16"></b>
                <i class="d1-bar d1-bar--b"></i>
                <b class="d1-gap d1-gap--lg" data-v="24"></b>
                <i class="d1-btn"></i>
              </div>
            </div>
            <h3 class="p-title" data-pt="Tornar o invisível visível.">Make the invisible visible.</h3>
            <p class="p-body" data-pt="Se uma regra decide o que acontece, tem de estar no ecrã. Permissões, limites e dependências não devem viver na cabeça de alguém.">If a rule decides what happens, it belongs on the screen. Permissions, limits and dependencies shouldn't live in someone's head.</p>
          </article>

          <article class="p-card reveal reveal-d1" tabindex="0">
            <div class="p-demo" aria-hidden="true">
              <span class="tap-hint"></span>
              <div class="d2-form">
                <span class="d2-field"><i></i><b></b></span>
                <span class="d2-field d2-field--cut"><i></i><b></b></span>
                <span class="d2-field d2-field--cut"><i></i><b></b></span>
                <span class="d2-field"><i></i><b></b></span>
                <span class="d2-field d2-field--cut"><i></i><b></b></span>
                <span class="d2-field d2-field--cut"><i></i><b></b></span>
              </div>
              <span class="d2-count" data-pt="6 campos → 2">6 fields → 2</span>
            </div>
            <h3 class="p-title" data-pt="Cada passo tem de merecer o lugar.">Every step earns its place.</h3>
