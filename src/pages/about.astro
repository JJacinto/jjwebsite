              chips.forEach((btn) => btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const open = btn.getAttribute('aria-expanded') !== 'true';
                closeAll(btn);
                btn.setAttribute('aria-expanded', String(open));
                const panel = btn.nextElementSibling as HTMLElement;
                panel.hidden = !open;
                if (open) {
                  // Keep the panel inside the card: slide it left when the chip
                  // sits near the card's right edge (mostly on phones).
                  const li = btn.parentElement!.getBoundingClientRect();
                  const card = btn.closest('.b-card')!.getBoundingClientRect();
                  const pad = 12;
                  const maxLeft = card.right - pad - panel.offsetWidth;
                  const left = Math.max(card.left + pad, Math.min(li.left, maxLeft));
                  panel.style.setProperty('--shift', `${Math.round(left - li.left)}px`);
                }
              }));
