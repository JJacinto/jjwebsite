---
import Base from '../layouts/Base.astro';
import XraySwitch from '../components/XraySwitch.astro';
import WorkWall from '../components/home/WorkWall.astro';
---
<Base
  activePage="home"
  description="João Jacinto, senior product designer in Aveiro, Portugal. I design the parts users don't see, and I build what I design."
  titlePt="João Jacinto — Senior Product Designer"
  descriptionPt="João Jacinto, senior product designer em Aveiro, Portugal. Desenho as partes que os utilizadores não veem, e construo o que desenho."
  showCta={true}
  disablePageParticles={true}
>

  <div class="home-wrap">
    <!-- X-ray grid: the 12-column grid of the 1140px container. Only
         visible while the X-ray switch is on. -->
    <div class="xray-grid" aria-hidden="true">
      <div class="xray-grid-inner">
        <span></span><span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

  <!-- HERO -->
  <section class="hero" data-hero-intro>
    <!-- Decide the intro mode before first paint. Full intro once per
         session, the short version (from beat 9) on later visits, nothing
         at all for reduced motion. cut-pending hides the intro parts until
         hero-cut.js draws its first frame. Without JS the hero is simply
         visible. -->
    <script is:inline>
    (function(){try{var d=document.documentElement;if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;d.classList.add(sessionStorage.getItem('jj-intro')?'intro-short':'intro-run','cut-pending');}catch(e){}})();
    </script>
    <!-- Intro stage, drawn by /scripts/hero-cut.js. Fixed and full-viewport
         while it plays; the same canvas draws the X-ray cut lines. -->
    <canvas data-cut-canvas aria-hidden="true" data-words="EVERY|PART|EARNS ITS PLACE." data-pt-data-words="CADA|PARTE|MERECE O LUGAR." data-layers="surface|states|rules|data" data-pt-data-layers="superfície|estados|regras|dados" data-label="PARTS" data-pt-data-label="PARTES"></canvas>
    <div class="container hero-inner" data-xray>
      <aside class="xray-note" data-xray-note data-pt="Um título, uma promessa. A linha por baixo traz a prova, por isso o título pode ficar curto.">One headline, one promise. The line under it carries the proof, so the headline can stay short.</aside>
      <h1 class="hero-greeting" data-cut-rise data-pt="Olá, sou o João. Um product designer que constrói.">Hey, I'm João. A product designer who builds.</h1>
      <p class="hero-role" data-cut-line><span class="hero-line" data-pt="Desenho as partes que os utilizadores não veem.">I design the parts users don't see.</span></p>
      <p class="hero-sub" data-cut-rise data-pt="Para que as que veem pareçam inevitáveis. Dez anos em fintech, vídeo e ferramentas de suporte, e construo o que desenho.">So the parts they do see feel inevitable. Ten years across fintech, video and support tools, and I build what I design.</p>
      <div class="hero-ctas" data-cut-rise>
        <button class="btn btn-accent" type="button" data-umami-event="hero-hire" onclick="openComposeModal(3)">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12v9H2z"/><path d="M2 4l6 5 6-5"/></svg></span>
          <span data-pt="A contratar? Vamos falar">Hiring? Let's talk</span>
        </button>
        <a class="btn btn-ghost" data-umami-event="hero-view-work" href="#work">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          <span data-pt="Ver o trabalho">See the work</span>
        </a>
      </div>
      <div class="hero-xray" data-cut-rise>
        <XraySwitch wrap=".home-wrap" />
        <span class="hero-xray-hint" data-pt="ou prime <kbd>X</kbd>">or press <kbd>X</kbd></span>
        <button class="hero-replay" type="button" data-cut-replay data-pt="Rever intro">Replay intro</button>
      </div>
    </div>
  </section>
  <script src="/scripts/hero-cut.js" defer></script>

  <!-- WORK WALL -->
  <section class="home-work" id="work">
    <div class="container home-block" data-xray>
      <aside class="xray-note" data-xray-note data-pt="Cada tile é uma decisão, não uma captura de ecrã. Com o Raio-X ligado, todos mostram o que cortei.">Every tile is a decision, not a screenshot. Flip X-ray on and they all show what I cut.</aside>
      <div class="home-head" data-xray-gap="48">
        <p class="eyebrow home-eyebrow reveal" data-pt="Trabalho selecionado">Selected work</p>
        <h2 class="home-h2 reveal reveal-d1" data-pt="Cada resultado tem um corte por trás.">Every result has a cut behind it.</h2>
      </div>
      <WorkWall />
    </div>
  </section>

  <!-- BRANDS -->
  <section class="brands reveal">
    <div class="brands-xray" data-xray>
    <div class="container home-block">
      <aside class="xray-note" data-xray-note data-pt="Só logótipos, sem promessas. O trabalho acima diz o que fiz lá.">Logos only, no claims. The work above says what I did there.</aside>
      <p class="eyebrow brands-label" data-pt="Trabalhei com">Worked with</p>
    </div>
    <div class="brands-marquee">
      <div class="brands-track">
        <div class="brands-cycle">
          <a href="https://www.anchorage.com" data-umami-event="brand-anchorage" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/anchorage.avif" alt="Anchorage Digital" width="1024" height="232" loading="lazy"></a>
          <a href="https://streamyard.com" data-umami-event="brand-streamyard" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/streamyard.avif" alt="StreamYard" width="512" height="88" loading="lazy"></a>
          <a href="https://www.talkdesk.com" data-umami-event="brand-talkdesk" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/talkdesk.avif" alt="Talkdesk" width="512" height="117" loading="lazy"></a>
          <a href="https://www.namecheap.com" data-umami-event="brand-namecheap" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/namecheap.avif" alt="Namecheap" width="512" height="93" loading="lazy"></a>
          <a href="https://github.com/beubi" data-umami-event="brand-beubi" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/beubi.avif" alt="Be.Ubi" width="284" height="126" loading="lazy"></a>
        </div>
      </div>
    </div>
    </div>
  </section>
  <div id="brandsTooltip" class="brands-tooltip" aria-hidden="true" role="tooltip"></div>

  <!-- HOW I WORK -->
  <section class="home-how">
    <div class="container home-block" data-xray>
      <aside class="xray-note" data-xray-note data-pt="Três passos, não sete. Se não cabe num ecrã, não é um processo, é uma lista de desejos.">Three steps, not seven. If it doesn't fit on one screen, it isn't a process, it's a wish list.</aside>
      <div class="home-head" data-xray-gap="48">
        <p class="eyebrow home-eyebrow reveal" data-pt="Como trabalho">How I work</p>
        <h2 class="home-h2 reveal reveal-d1" data-pt="Três passos, por esta ordem.">Three steps, in this order.</h2>
      </div>
      <ol class="how-steps">
        <li class="how-step reveal reveal-d1">
          <div class="how-top"><span class="how-n">01</span><span class="how-maps" data-pt="Conversa · Mapear">Talk · Map</span></div>
          <h3 data-pt="Encontrar o problema real">Find the real problem</h3>
          <p data-pt="Na StreamYard, o roadmap vinha de chamadas de vendas e tickets de suporte. Por isso entrevistei organizadores que pagavam por ferramentas concorrentes.">At StreamYard the roadmap came from sales calls and support tickets. So I interviewed organisers who paid for competing tools.</p>
        </li>
        <li class="how-step reveal reveal-d2">
          <div class="how-top"><span class="how-n">02</span><span class="how-maps" data-pt="Cortar">Cut</span></div>
          <h3 data-pt="Cortar o que não merece o lugar">Cut what doesn't earn its place</h3>
          <p data-pt="Dispensei o page builder. Lançámos antes templates em que uma só cor define a paleta inteira.">I skipped the page builder. Templates where one colour makes the whole palette shipped instead.</p>
          <span class="how-chip" data-pt="Anchorage · <b>40 → 1</b> passo">Anchorage · <b>40 → 1</b> step</span>
        </li>
        <li class="how-step reveal reveal-d3">
          <div class="how-top"><span class="how-n">03</span><span class="how-maps" data-pt="Lançar · Medir">Ship · Measure</span></div>
          <h3 data-pt="Construir, em código quando ajuda">Build it, in code when it helps</h3>
          <p data-pt="Na StreamYard especifiquei tokens e 15+ componentes para que design e código partilhassem uma só fonte. Este site também é feito à mão.">At StreamYard I specified tokens and 15+ components so design and code could share one source. This site is hand-built too.</p>
        </li>
      </ol>
      <p class="how-more reveal reveal-d3">
        <span data-pt="Os mesmos passos antes e depois dos LLMs. Só mudaram as ferramentas.">Same steps before and after LLMs. Only the tools changed.</span>
        <a href="/about#loop" data-umami-event="home-how-to-loop" data-pt="Ver a stack →">See the stack →</a>
      </p>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="container home-block" data-xray>
      <aside class="xray-note" data-xray-note data-pt="Só pessoas com quem trabalhei diretamente. Cada uma diz como trabalhámos em conjunto.">Only people I worked with directly. Each one says how we worked together.</aside>
      <p class="eyebrow reveal" data-pt="Chefias e colegas sobre como trabalho">Managers and teammates on how I work</p>
      <div class="testimonials-masonry">
        <a class="testimonial-card testimonial-card--featured reveal reveal-d1" data-umami-event="testimonial" data-umami-event-author="daniel-cardoso" href="https://www.linkedin.com/in/joaofranciscojacinto/details/recommendations/" target="_blank" rel="noopener noreferrer">
          <span class="testimonial-stroke-light" aria-hidden="true"></span>
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Daniel.avif" alt="Daniel Cardoso" width="512" height="512" loading="lazy"></div>
            <div>
              <div class="testimonial-name">Daniel Cardoso</div>
              <div class="testimonial-role" data-pt="Diretor de Design para IA na Talkdesk">Director of Design for AI at Talkdesk</div>
            </div>
          </div>
          <p class="testimonial-quote" data-pt="Tive o privilégio de trabalhar com o João como Senior Product Designer num produto de IA… O João tem <strong>uma combinação única de proficiência técnica, conhecimento de design e competências de UX excecionais</strong>, o que faz dele uma mais-valia para qualquer equipa.">I had the privilege of working with João as a Senior Product Designer on an AI product… João possesses <strong>a unique combination of technical proficiency, design expertise, and exceptional UX competencies</strong>, making him a valuable asset to any team.</p>
          <div class="testimonial-footer">
            <span class="testimonial-logo testimonial-logo--talkdesk" role="img" aria-label="Talkdesk"></span>
            <p class="testimonial-relation" data-pt="O Daniel foi o meu manager na Talkdesk">Daniel was my manager at Talkdesk</p>
            <span class="testimonial-source" data-pt="Ler no LinkedIn ↗">Read on LinkedIn ↗</span>
          </div>
        </a>

        <a class="testimonial-card reveal reveal-d2" data-umami-event="testimonial" data-umami-event-author="will-brett-atkin" href="https://www.linkedin.com/in/joaofranciscojacinto/details/recommendations/" target="_blank" rel="noopener noreferrer">
          <span class="testimonial-stroke-light" aria-hidden="true"></span>
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Will.avif" alt="Will Brett-Atkin" width="91" height="105" loading="lazy"></div>
            <div>
              <div class="testimonial-name">Will Brett-Atkin</div>
              <div class="testimonial-role">Staff Product Designer</div>
            </div>
          </div>
          <p class="testimonial-quote" data-pt="O João tem um talento raro para <strong>gerir, em simultâneo e com eficiência, vários projetos de grande prioridade e grande impacto</strong>. A capacidade de equilibrar tudo e de se destacar em ambientes tão exigentes é prova da sua experiência e dedicação.">João possesses a rare talent for <strong>efficiently managing multiple high-priority, high-impact projects simultaneously</strong>. His ability to balance and excel in such demanding environments is a testament to his expertise and dedication.</p>
          <div class="testimonial-footer">
            <span class="testimonial-logo testimonial-logo--streamyard" role="img" aria-label="StreamYard"></span>
            <p class="testimonial-relation" data-pt="O Will foi meu colega na StreamYard">Will was my coworker at StreamYard</p>
            <span class="testimonial-source" data-pt="Ler no LinkedIn ↗">Read on LinkedIn ↗</span>
          </div>
        </a>

        <a class="testimonial-card reveal reveal-d3" data-umami-event="testimonial" data-umami-event-author="xavier-gallego" href="https://www.linkedin.com/in/joaofranciscojacinto/details/recommendations/" target="_blank" rel="noopener noreferrer">
          <span class="testimonial-stroke-light" aria-hidden="true"></span>
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Xavier.avif" alt="Xavier Gallego" width="91" height="105" loading="lazy"></div>
            <div>
              <div class="testimonial-name">Xavier Gallego</div>
              <div class="testimonial-role" data-pt="Engenheiro sénior na Synthesia">Sr. Engineer at Synthesia</div>
            </div>
          </div>
          <p class="testimonial-quote" data-pt="A dedicação do João em manter padrões de design elevados e em promover a colaboração na nossa equipa é de primeira. <strong>A sua abertura ao feedback</strong> ajuda a criar um ambiente que melhora muito o nosso fluxo de trabalho e as nossas entregas.">João's dedication to maintain high design standards and foster collaboration within our team is top notch. <strong>His openness to feedback</strong> helps create an environment that greatly enhances our workflow and deliverables.</p>
          <div class="testimonial-footer">
            <span class="testimonial-logo testimonial-logo--streamyard" role="img" aria-label="StreamYard"></span>
            <p class="testimonial-relation" data-pt="O Xavier foi meu colega na StreamYard">Xavier was my coworker at StreamYard</p>
            <span class="testimonial-source" data-pt="Ler no LinkedIn ↗">Read on LinkedIn ↗</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <XraySwitch float wrap=".home-wrap" />
  </div>

</Base>

<script is:inline>
/* Hero intro glue. The intro itself is /scripts/hero-cut.js (loaded above,
   deferred). Here: remember the full run for this session, and tell the
   script when X-ray turns on or off. X-ray is the .xray class on .home-wrap,
   toggled by the switch or the X key, so one observer covers both. */
(function() {
  document.addEventListener('jj:cutdone', function() {
    try { sessionStorage.setItem('jj-intro', '1'); } catch (_) {}
  });
  const wrap = document.querySelector('.home-wrap');
  if (!wrap) return;
  const send = () => { if (window.HeroCut) window.HeroCut.xray(wrap.classList.contains('xray')); };
  new MutationObserver(send).observe(wrap, { attributes: true, attributeFilter: ['class'] });
  /* Deferred scripts have run by DOMContentLoaded; catch X-ray already on. */
  document.addEventListener('DOMContentLoaded', () => { if (wrap.classList.contains('xray')) send(); });
})();

(function() {
  const track = document.querySelector('.brands-track');
  const cycle = track && track.querySelector('.brands-cycle');
  if (!track || !cycle) return;

  let lastCycleWidth = 0;
  const setup = () => {
    const cycleWidth = cycle.getBoundingClientRect().width;
    if (!cycleWidth || cycleWidth === lastCycleWidth) return;
    lastCycleWidth = cycleWidth;
    track.style.setProperty('--brands-cycle', cycleWidth + 'px');
    while (track.querySelector('.brands-cycle.clone')) track.querySelector('.brands-cycle.clone').remove();
    const viewport = window.innerWidth;
    const copies = Math.max(2, Math.ceil((viewport + cycleWidth) / cycleWidth) + 1);
    for (let i = 1; i < copies; i++) {
      const clone = cycle.cloneNode(true);
      clone.classList.add('clone');
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelectorAll('a').forEach(a => a.setAttribute('tabindex', '-1'));
      track.appendChild(clone);
    }
    track.classList.add('is-ready');
  };

  /* Eager attempt on next frame in case the cycle is already laid out
     (typical desktop case where the brands strip is at or near the
     initial viewport). */
  requestAnimationFrame(setup);

  /* Observe the cycle itself — its width changes when the lazy-loaded
     logo images finally arrive (mobile: brands sit below the fold, so
     images load only on scroll). The prior implementation waited for
     a one-shot Promise.all on img load events and measured ONCE; on
     mobile that often raced with layout, left cycleWidth at 0, and
     the `if (!cycleWidth) return;` early-bail kept `is-ready` off the
     track — animation never started. ResizeObserver naturally
     handles late image loads, font shifts, and viewport rotation in
     one mechanism. */
  if (window.ResizeObserver) {
    new ResizeObserver(setup).observe(cycle);
  } else {
    /* Fallback: window resize + a couple of retries for the lazy
       image case. Older browsers without ResizeObserver are rare
       enough that this is best-effort. */
    let raf;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(setup);
    });
    setTimeout(setup, 500);
    setTimeout(setup, 1500);
  }
})();

(function() {
  const brands = document.querySelector('.brands');
  if (!brands) return;
  const update = () => {
    document.documentElement.style.setProperty('--brands-h', brands.offsetHeight + 'px');
  };
  update();
  if (window.ResizeObserver) new ResizeObserver(update).observe(brands);
  window.addEventListener('resize', update);
})();
</script>

