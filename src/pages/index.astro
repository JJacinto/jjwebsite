  .stats-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  .testimonials-masonry { grid-template-columns: 1fr; }
  .may-like-grid,
  .cases-grid,
  .cases-grid-row-2 { grid-template-columns: 1fr; }
  .journey-row { grid-template-columns: 1fr; gap: 8px; }
  .contact { padding: 100px 20px 60px; }
  .case-meta-grid { grid-template-columns: 1fr 1fr; }
  .pull-quote { padding-left: 20px; }
}
</style>
