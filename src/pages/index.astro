.pw-form { display: flex; flex-direction: column; gap: 12px; align-items: stretch; }
.pw-input {
  width: 100%; padding: 12px 16px;
  border: 1.5px solid var(--border-strong);
  border-radius: var(--radius-md);
  font-family: var(--font-body); font-size: 1rem;
  background: var(--bg); color: var(--fg1);
  outline: none; text-align: center; letter-spacing: 0.12em;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.pw-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(61,61,181,0.12);
}
.pw-input.pw-shake {
  animation: pw-shake 0.38s cubic-bezier(0.36,0.07,0.19,0.97);
  border-color: #c00;
}
@keyframes pw-shake {
  0%,100% { transform: translateX(0); }
  20%      { transform: translateX(-6px); }
  40%      { transform: translateX(6px); }
  60%      { transform: translateX(-4px); }
  80%      { transform: translateX(4px); }
}
.pw-error {
  font-family: var(--font-body); font-size: 0.8rem;
  color: #b00; margin: 0; min-height: 1em;
}
.pw-form .btn { width: 100%; justify-content: center; }
.pw-input-wrap { position: relative; }
.pw-input-wrap .pw-input { padding-right: 44px; }
.pw-reveal {
  position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
  width: 30px; height: 30px;
  display: flex; align-items: center; justify-content: center;
  color: var(--fg3); transition: color 0.2s;
}
.pw-reveal:hover { color: var(--fg1); }
.pw-reveal svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

/* ============================================================
   Footer
   ============================================================ */
.footer {
  background: var(--dark);
  border-top: 1px solid rgba(255,255,255,0.06);
  padding: 32px var(--pad);
  text-align: center;
}
