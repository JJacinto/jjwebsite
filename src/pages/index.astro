  .case-meta-grid { grid-template-columns: repeat(2, 1fr); }
  .outcomes { padding: 28px; }
  .outcomes.cols-3 { grid-template-columns: 1fr; }
  .outcomes.cols-2 { grid-template-columns: 1fr; }
  .next-case { grid-template-columns: 1fr; }
