---
import Base from '../layouts/Base.astro';
---
<Base activePage="home" showCta={true}>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-marquee">
      <div class="marquee-track">
        <span>WELCOME</span><span>·</span><span>BEM-VINDO</span><span>·</span>
        <span>WELCOME</span><span>·</span><span>BEM-VINDO</span><span>·</span>
        <span>WELCOME</span><span>·</span><span>BEM-VINDO</span><span>·</span>
      </div>
    </div>
    <div class="container hero-inner">
      <h1 class="hero-greeting reveal">Hi 👋 I'm João Jacinto.</h1>
      <p class="hero-role reveal reveal-d1" aria-label="Product design expert">
        <span class="role-item">Product design expert</span>
        <span class="role-item">Digital product builder</span>
      </p>
      <div class="hero-photo reveal reveal-d2">
        <img src="/assets/images/joao-photo.webp" alt="João Jacinto" loading="eager">
      </div>
      <p class="hero-tagline reveal reveal-d3">Designing digital products with startups and enterprises since 2015, with love ♥</p>
      <div class="hero-ctas reveal reveal-d4">
        <a class="btn btn-ghost" href="/about">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          <span>Learn more</span>
        </a>
        <a class="btn btn-ghost" href="/case-studies">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          <span>View work</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="brands reveal">
    <div class="container">
      <p class="eyebrow brands-label">I've proudly worked with</p>
    </div>
    <div class="brands-marquee">
      <div class="brands-track">
        <a href="https://www.anchorage.com" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/anchorage.png" alt="Anchorage Digital"></a>
        <a href="https://streamyard.com" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/streamyard.avif" alt="StreamYard"></a>
        <a href="https://www.talkdesk.com" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/talkdesk.avif" alt="Talkdesk"></a>
        <a href="https://www.namecheap.com" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/namecheap.avif" alt="Namecheap"></a>
        <a href="https://github.com/beubi" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/beubi.avif" alt="Be.Ubi"></a>
        <a href="https://www.anchorage.com" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1"><img src="/assets/logos/anchorage.png" alt=""></a>
        <a href="https://streamyard.com" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1"><img src="/assets/logos/streamyard.avif" alt=""></a>
        <a href="https://www.talkdesk.com" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1"><img src="/assets/logos/talkdesk.avif" alt=""></a>
        <a href="https://www.namecheap.com" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1"><img src="/assets/logos/namecheap.avif" alt=""></a>
        <a href="https://github.com/beubi" target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1"><img src="/assets/logos/beubi.avif" alt=""></a>
      </div>
    </div>
  </section>
  <div id="brandsTooltip" class="brands-tooltip" aria-hidden="true" role="tooltip"></div>

  <!-- STATS -->
  <section class="stats">
    <div class="container">
      <p class="eyebrow reveal">My career in numbers</p>
      <div class="stats-grid">
        <div class="stat reveal reveal-d1">
          <div class="stat-num">5</div>
          <div class="stat-title">Products launched</div>
          <div class="stat-desc">StreamYard On-Air, Talkdesk AI Trainer, and more</div>
        </div>
        <div class="stat reveal reveal-d2">
          <div class="stat-num">25M<sup>+</sup></div>
          <div class="stat-title">Users reached</div>
          <div class="stat-desc">Across 8 industries: AI, crypto banking, streaming, CX contact center, and more</div>
        </div>
        <div class="stat reveal reveal-d3">
          <div class="stat-num">10<sup>+</sup></div>
          <div class="stat-title">Years of experience</div>
          <div class="stat-desc">Working with innovative startups and established global companies</div>
        </div>
      </div>
      <div class="stats-cta reveal">
        <a class="btn btn-ghost" href="/contact">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12v9H2z"/><path d="M2 4l6 5 6-5"/></svg></span>
          <span>Let's connect</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="container">
      <p class="eyebrow reveal">What people are saying</p>
      <div class="testimonials-masonry">
        <div class="testimonial-card reveal reveal-d1" onclick="window.open('https://linkedin.com/in/joaofranciscojacinto/','_blank','noopener')" style="cursor:pointer">
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Daniel.avif" alt="Daniel Cardoso"></div>
            <div>
              <div class="testimonial-name">Daniel Cardoso</div>
              <div class="testimonial-role">Director of Design for AI at Talkdesk</div>
            </div>
          </div>
          <p class="testimonial-quote">I had the privilege of working with João as a Senior Product Designer on an AI product, and I was continually impressed by his expertise and skills. João possesses a unique combination of technical proficiency, design expertise, and exceptional UX competencies, making him a valuable asset to any team.</p>
          <p class="testimonial-relation">Daniel was my manager at Talkdesk</p>
        </div>

        <div class="testimonial-card reveal reveal-d2" onclick="window.open('https://linkedin.com/in/joaofranciscojacinto/','_blank','noopener')" style="cursor:pointer">
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Will.avif" alt="Will Brett-Atkin"></div>
            <div>
              <div class="testimonial-name">Will Brett-Atkin</div>
              <div class="testimonial-role">Staff Product Designer</div>
            </div>
          </div>
          <p class="testimonial-quote">João possesses a rare talent for efficiently managing multiple high-priority, high-impact projects simultaneously. His ability to balance and excel in such demanding environments is a testament to his expertise and dedication.</p>
          <p class="testimonial-relation">Will was my coworker at StreamYard</p>
        </div>

        <div class="testimonial-card reveal reveal-d3" onclick="window.open('https://linkedin.com/in/joaofranciscojacinto/','_blank','noopener')" style="cursor:pointer">
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Xavier.avif" alt="Xavier Gallego"></div>
            <div>
              <div class="testimonial-name">Xavier Gallego</div>
              <div class="testimonial-role">Sr. Engineer at Synthesia</div>
            </div>
          </div>
          <p class="testimonial-quote">João's dedication to maintain high design standards and foster collaboration within our team is top notch. His openness to feedback helps create an environment that greatly enhances our workflow and deliverables.</p>
          <p class="testimonial-relation">Xavier was my coworker at StreamYard</p>
        </div>
      </div>
    </div>
  </section>

  <!-- YOU MAY LIKE -->
  <section class="may-like">
    <div class="container">
      <p class="eyebrow reveal">You may like to read</p>
      <div class="may-like-grid">
        <a class="case-card reveal reveal-d1" href="/case-studies/redefining-webinar-customization">
          <img src="/assets/images/case-webinar.avif" alt="Webinar customization" loading="lazy">
          <div class="case-card-body">
            <div class="case-card-cat">Design</div>
            <div class="case-card-title">Redefining webinar customization</div>
          </div>
        </a>
        <a class="case-card reveal reveal-d2" href="/case-studies/understanding-webinar-organizers">
          <img src="/assets/images/case-research.avif" alt="Research ops" loading="lazy">
          <div class="case-card-body">
            <div class="case-card-cat">Research Ops</div>
            <div class="case-card-title">Understanding webinar organizers</div>
          </div>
        </a>
        <a class="case-card reveal reveal-d3" href="/case-studies/leading-and-managing-a-design-system">
          <img src="/assets/images/case-ds.avif" alt="Design system" loading="lazy">
          <div class="case-card-body">
            <div class="case-card-cat">Design Leadership</div>
            <div class="case-card-title">Leading and managing a design system</div>
          </div>
        </a>
      </div>
      <div class="may-like-cta reveal">
        <a class="btn btn-ghost" href="/case-studies">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          <span>All case studies</span>
        </a>
      </div>
    </div>
  </section>

</Base>

<script is:inline>
(function() {
  const items = document.querySelectorAll('.role-item');
  if (!items.length) return;
  let idx = 0;
  items[0].classList.add('is-active');
  setInterval(() => {
    const prev = idx;
    idx = (idx + 1) % items.length;
    items[prev].classList.remove('is-active');
    items[prev].classList.add('is-prev');
    items[idx].classList.add('is-active');
    setTimeout(() => items[prev].classList.remove('is-prev'), 600);
  }, 2800);
})();
</script>

