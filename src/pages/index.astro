function switchPage(page) {
  const prevCanvas = document.getElementById('contact-canvas');
  if (prevCanvas?._stopCanvas) { prevCanvas._stopCanvas(); prevCanvas._contactReady=false; }

  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));

  const isCase = page && page.startsWith('case-');
  if (isCase) {
    if (!renderCasePage(page)) { page = 'home'; }
  }

  const target = document.getElementById(isCase ? 'page-case' : 'page-' + page);
  if (target) target.classList.add('active');

  const navActive = isCase ? 'cases' : page;
  document.querySelectorAll('.pill-nav a, .mobile-menu a').forEach(a => {
    a.classList.toggle('active', a.dataset.page === navActive);
  });
  movePillIndicator();

  footer.style.display = page === 'contact' ? 'none' : '';
  nav.classList.toggle('nav-dark', page === 'contact');

  window.scrollTo({ top: 0, behavior: 'auto' });

  if (page === 'contact') requestAnimationFrame(initContactCanvas);

  requestAnimationFrame(() => {
    document.querySelectorAll('.page.active .reveal').forEach(el => {
      el.classList.remove('visible');
      revealObserver.observe(el);
    });
  });

  return false;
}

