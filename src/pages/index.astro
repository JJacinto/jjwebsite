---
import Base from '../layouts/Base.astro';
---
<Base activePage="home" showCta={true} disablePageParticles={true}>

  <!-- HERO -->
  <section class="hero">
    <!-- Particle overlay — the drifting dot field that greets visitors
         on work / about / case pages, also present on the home hero.
         The compose-modal init picks this up via the .hero-particles
         class; the particle canvas stays transparent so the CSS wash
         gradient behind it shows through. -->
    <div class="hero-particles" aria-hidden="true">
      <canvas class="cta-footer-bg"></canvas>
    </div>
    <div class="container hero-inner">
      <h1 class="hero-greeting reveal"><span class="hero-hey">Hey</span>, I'm João.</h1>
      <p class="hero-role reveal reveal-d1" aria-label="I design the parts users don't see, so the parts they do see feel inevitable">
        <span class="role-item">I design the parts users don't see, so the parts they do see feel inevitable.</span>
        <span class="role-item">A product designer who builds. The work starts before the pixels.</span>
        <span class="role-item">Ten years of work where one decision shapes a thousand others.</span>
        <span class="role-item">At Anchorage, I'm learning what it means to design for irreversible decisions.</span>
      </p>
      <div class="hero-ctas reveal reveal-d3">
        <button class="btn btn-accent" type="button" data-umami-event="hero-start-project" onclick="openComposeModal(1)">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12v9H2z"/><path d="M2 4l6 5 6-5"/></svg></span>
          <span>Start project</span>
        </button>
        <a class="btn btn-ghost" data-umami-event="hero-view-work" href="/case-studies">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          <span>View work</span>
        </a>
      </div>
    </div>
  </section>

  <!-- WORK HIGHLIGHTS -->
  <section class="may-like">
    <div class="container">
      <p class="eyebrow reveal">Work highlights</p>
      <div class="may-like-grid">
        <a class="case-card reveal reveal-d1" data-umami-event="case-card-home" data-umami-event-slug="redefining-webinar-customization" href="/case-studies/redefining-webinar-customization">
          <img src="/assets/images/case-webinar-redefining.webp" alt="Webinar customization" width="1949" height="1107" loading="eager" fetchpriority="high">
          <div class="case-card-body">
            <div class="case-card-cat">Design • StreamYard</div>
            <div class="case-card-title">Redefining webinar customization</div>
            <div class="case-card-highlight">Tripled weekly webinar volume after shipping webinar customization</div>
          </div>
        </a>
        <a class="case-card reveal reveal-d2" data-umami-event="case-card-home" data-umami-event-slug="understanding-webinar-organizers" href="/case-studies/understanding-webinar-organizers">
          <img src="/assets/images/case-research.avif" alt="Research ops" width="1522" height="964" loading="eager" fetchpriority="high">
          <div class="case-card-body">
            <div class="case-card-cat">Research Ops • StreamYard</div>
            <div class="case-card-title">Understanding webinar organizers</div>
            <div class="case-card-highlight">Informed the product's roadmap, and briefed 2 other teams in the process.</div>
          </div>
        </a>
      </div>
      <div class="may-like-cta reveal">
        <a class="btn btn-ghost" data-umami-event="home-view-more" href="/case-studies">
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
          <span>View more</span>
        </a>
      </div>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="brands reveal">
    <div class="container">
      <p class="eyebrow brands-label">Worked with</p>
    </div>
    <div class="brands-marquee">
      <div class="brands-track">
        <div class="brands-cycle">
          <a href="https://www.anchorage.com" data-umami-event="brand-anchorage" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/anchorage.avif" alt="Anchorage Digital" width="1024" height="232" loading="lazy"></a>
          <a href="https://streamyard.com" data-umami-event="brand-streamyard" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/streamyard.avif" alt="StreamYard" width="512" height="88" loading="lazy"></a>
          <a href="https://www.talkdesk.com" data-umami-event="brand-talkdesk" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/talkdesk.avif" alt="Talkdesk" width="512" height="117" loading="lazy"></a>
          <a href="https://www.namecheap.com" data-umami-event="brand-namecheap" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/namecheap.avif" alt="Namecheap" width="512" height="93" loading="lazy"></a>
          <a href="https://github.com/beubi" data-umami-event="brand-beubi" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/beubi.avif" alt="Be.Ubi" width="284" height="126" loading="lazy"></a>
        </div>
      </div>
    </div>
  </section>
  <div id="brandsTooltip" class="brands-tooltip" aria-hidden="true" role="tooltip"></div>

  <!-- STATS -->
  <section class="stats">
    <div class="container">
      <p class="eyebrow reveal">My career in numbers</p>
      <div class="stats-grid">
        <div class="stat reveal reveal-d1">
          <div class="stat-num">5</div>
          <div class="stat-title">Products launched</div>
          <div class="stat-desc">Anchorage Digital Policies, StreamYard On-Air, Talkdesk AI Trainer, and more</div>
        </div>
        <div class="stat reveal reveal-d2">
          <div class="stat-num">25M<sup>+</sup></div>
          <div class="stat-title">Users reached</div>
          <div class="stat-desc">Across 8 industries: AI, crypto banking, streaming, CX contact center, and more</div>
        </div>
        <div class="stat reveal reveal-d3">
          <div class="stat-num">10<sup>+</sup></div>
          <div class="stat-title">Years of experience</div>
          <div class="stat-desc">Working with innovative startups and established global companies</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="container">
      <p class="eyebrow reveal">What people I've worked with say</p>
      <div class="testimonials-masonry">
        <a class="testimonial-card reveal reveal-d1" data-umami-event="testimonial" data-umami-event-author="daniel-cardoso" href="https://linkedin.com/in/joaofranciscojacinto/" target="_blank" rel="noopener noreferrer">
          <span class="testimonial-stroke-light" aria-hidden="true"></span>
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Daniel.avif" alt="Daniel Cardoso" width="512" height="512" loading="lazy"></div>
            <div>
              <div class="testimonial-name">Daniel Cardoso</div>
              <div class="testimonial-role">Director of Design for AI at Talkdesk</div>
            </div>
          </div>
          <p class="testimonial-quote">I had the privilege of working with João as a Senior Product Designer on an AI product, and I was continually impressed by his expertise and skills. João possesses a unique combination of technical proficiency, design expertise, and exceptional UX competencies, making him a valuable asset to any team.</p>
          <p class="testimonial-relation">Daniel was my manager at Talkdesk</p>
        </a>

        <a class="testimonial-card reveal reveal-d2" data-umami-event="testimonial" data-umami-event-author="will-brett-atkin" href="https://linkedin.com/in/joaofranciscojacinto/" target="_blank" rel="noopener noreferrer">
          <span class="testimonial-stroke-light" aria-hidden="true"></span>
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Will.avif" alt="Will Brett-Atkin" width="91" height="105" loading="lazy"></div>
            <div>
              <div class="testimonial-name">Will Brett-Atkin</div>
              <div class="testimonial-role">Staff Product Designer</div>
            </div>
          </div>
          <p class="testimonial-quote">João possesses a rare talent for efficiently managing multiple high-priority, high-impact projects simultaneously. His ability to balance and excel in such demanding environments is a testament to his expertise and dedication.</p>
          <p class="testimonial-relation">Will was my coworker at StreamYard</p>
        </a>

        <a class="testimonial-card reveal reveal-d3" data-umami-event="testimonial" data-umami-event-author="xavier-gallego" href="https://linkedin.com/in/joaofranciscojacinto/" target="_blank" rel="noopener noreferrer">
          <span class="testimonial-stroke-light" aria-hidden="true"></span>
          <div class="testimonial-header">
            <div class="testimonial-avatar"><img src="/assets/images/Xavier.avif" alt="Xavier Gallego" width="91" height="105" loading="lazy"></div>
            <div>
              <div class="testimonial-name">Xavier Gallego</div>
              <div class="testimonial-role">Sr. Engineer at Synthesia</div>
            </div>
          </div>
          <p class="testimonial-quote">João's dedication to maintain high design standards and foster collaboration within our team is top notch. His openness to feedback helps create an environment that greatly enhances our workflow and deliverables.</p>
          <p class="testimonial-relation">Xavier was my coworker at StreamYard</p>
        </a>
      </div>
    </div>
  </section>

</Base>

<script is:inline>
(function() {
  const items = document.querySelectorAll('.role-item');
  if (!items.length) return;
  let idx = 0;
  items[0].classList.add('is-active');
  setInterval(() => {
    const prev = idx;
    idx = (idx + 1) % items.length;
    items[prev].classList.remove('is-active');
    items[prev].classList.add('is-prev');
    items[idx].classList.add('is-active');
    setTimeout(() => items[prev].classList.remove('is-prev'), 600);
  }, 5000);
})();

(function() {
  const track = document.querySelector('.brands-track');
  const cycle = track && track.querySelector('.brands-cycle');
  if (!track || !cycle) return;

  let lastCycleWidth = 0;
  const setup = () => {
    const cycleWidth = cycle.getBoundingClientRect().width;
    if (!cycleWidth || cycleWidth === lastCycleWidth) return;
    lastCycleWidth = cycleWidth;
    track.style.setProperty('--brands-cycle', cycleWidth + 'px');
    while (track.querySelector('.brands-cycle.clone')) track.querySelector('.brands-cycle.clone').remove();
    const viewport = window.innerWidth;
    const copies = Math.max(2, Math.ceil((viewport + cycleWidth) / cycleWidth) + 1);
    for (let i = 1; i < copies; i++) {
      const clone = cycle.cloneNode(true);
      clone.classList.add('clone');
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelectorAll('a').forEach(a => a.setAttribute('tabindex', '-1'));
      track.appendChild(clone);
    }
    track.classList.add('is-ready');
  };

  /* Eager attempt on next frame in case the cycle is already laid out
     (typical desktop case where the brands strip is at or near the
     initial viewport). */
  requestAnimationFrame(setup);

  /* Observe the cycle itself — its width changes when the lazy-loaded
     logo images finally arrive (mobile: brands sit below the fold, so
     images load only on scroll). The prior implementation waited for
     a one-shot Promise.all on img load events and measured ONCE; on
     mobile that often raced with layout, left cycleWidth at 0, and
     the `if (!cycleWidth) return;` early-bail kept `is-ready` off the
     track — animation never started. ResizeObserver naturally
     handles late image loads, font shifts, and viewport rotation in
     one mechanism. */
  if (window.ResizeObserver) {
    new ResizeObserver(setup).observe(cycle);
  } else {
    /* Fallback: window resize + a couple of retries for the lazy
       image case. Older browsers without ResizeObserver are rare
       enough that this is best-effort. */
    let raf;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(setup);
    });
    setTimeout(setup, 500);
    setTimeout(setup, 1500);
  }
})();

(function() {
  const brands = document.querySelector('.brands');
  if (!brands) return;
  const update = () => {
    document.documentElement.style.setProperty('--brands-h', brands.offsetHeight + 'px');
  };
  update();
  if (window.ResizeObserver) new ResizeObserver(update).observe(brands);
  window.addEventListener('resize', update);
})();
</script>

