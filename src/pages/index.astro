---
import RetuneBridge from '../components/RetuneBridge.tsx';
import '../styles/tokens.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>João Jacinto — Senior Product Designer</title>
<meta name="description" content="João Jacinto — Senior Product Designer based in Aveiro, Portugal. 10+ years designing digital products with startups and enterprises.">
<link rel="icon" type="image/svg+xml" href="/assets/JJ.svg">
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@900&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
@font-face {
  font-family: 'Mona Sans';
  src: url('https://github.githubassets.com/assets/mona-sans.woff2') format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}

/* ============================================================
   Reset & Base
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--fg1);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  line-height: 1.75;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
button { font-family: inherit; background: none; border: none; cursor: pointer; color: inherit; }
.container { max-width: var(--container); margin: 0 auto; padding: 0 var(--pad); }

h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 900;
  color: var(--fg1);
  line-height: 1.15;
}
h1 { font-size: var(--text-h1); letter-spacing: -0.035em; }
h2 { font-size: var(--text-h2); letter-spacing: -0.03em; }
h3 { font-size: 1.3rem;  letter-spacing: -0.02em; }
h4 { font-size: 1.1rem;  letter-spacing: -0.02em; }

p { font-family: var(--font-body); font-size: 0.95rem; color: var(--fg2); line-height: 1.75; }

.eyebrow {
  font-family: var(--font-body);
  font-size: 0.78rem;
  color: var(--fg3);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* ============================================================
   Reveal animations
   ============================================================ */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
}
.reveal.visible { opacity: 1; transform: translateY(0); }
.reveal-d1 { transition-delay: 0.08s; }
.reveal-d2 { transition-delay: 0.16s; }
.reveal-d3 { transition-delay: 0.24s; }
.reveal-d4 { transition-delay: 0.32s; }

@keyframes marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .reveal { transition: none; opacity: 1; transform: none; }
  .marquee-track { animation: none !important; }
}

/* ============================================================
   NAV
   ============================================================ */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  padding: 16px 0;
  transition: background 0.35s cubic-bezier(0.22,1,0.36,1), box-shadow 0.35s, padding 0.3s;
}
.nav.scrolled {
  padding: 12px 0;
  background: rgba(236, 234, 229, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 1px 0 var(--border);
}
.nav .container {
  display: flex; align-items: center; justify-content: space-between;
}

/* Logo: single J idle → JJ on hover */
.logo-outer {
  width: 44px; height: 44px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; position: relative; flex-shrink: 0;
  background: none; padding: 0;
}
.logo-bg {
  position: absolute; inset: 0; border-radius: 50%;
  background: rgba(61,61,181,0.10);
  opacity: 0;
  transition: opacity 0.3s ease;
}
.logo-outer:hover .logo-bg { opacity: 1; }
.logo-letters {
  display: flex; align-items: center;
  font-family: var(--font-display); font-weight: 900; font-size: 1.35rem;
  letter-spacing: -0.04em;
  position: relative; z-index: 1;
}
.logo-j1 {
  color: var(--fg1);
  position: relative; z-index: 1;
  transition: color 0.3s ease;
}
.logo-outer:hover .logo-j1 { color: var(--accent); }
.logo-j2 {
  display: inline-block;
  color: var(--accent);
  opacity: 0;
  transform: translateX(-82%);
  transition:
    transform 0.44s cubic-bezier(0.22,1,0.36,1),
    opacity 0.36s cubic-bezier(0.4,0,0.2,1);
  position: relative; z-index: 0;
}
.logo-outer:hover .logo-j2 { opacity: 1; transform: translateX(0); }

/* Pill nav */
.pill-nav {
  position: relative; display: flex;
  border-radius: var(--radius-full); padding: 4px;
  background: transparent;
}
.pill-indicator {
  position: absolute; top: 4px; bottom: 4px;
  background: rgba(28,26,23,0.07);
  border-radius: var(--radius-full);
  transition: left 0.32s cubic-bezier(0.25,0.46,0.45,0.94), width 0.32s cubic-bezier(0.25,0.46,0.45,0.94);
  pointer-events: none;
}
.pill-nav a {
  position: relative; z-index: 1;
  font-size: 0.88rem; color: var(--fg2);
  padding: 8px 18px; border-radius: var(--radius-full);
  cursor: pointer; user-select: none; white-space: nowrap;
  transition: color 0.18s ease, transform 0.12s ease;
}
.pill-nav a:hover:not(.active) { color: #3A3330; }
.pill-nav a.active { color: var(--fg1); }
.pill-nav a:active { transform: scale(0.93); }

/* Nav dark variant (contact page) */
.nav.nav-dark .pill-nav a { color: rgba(240,237,232,0.45); }
.nav.nav-dark .pill-nav a:hover:not(.active) { color: rgba(240,237,232,0.80); }
.nav.nav-dark .pill-nav a.active { color: var(--fg-inverse); }
.nav.nav-dark .pill-indicator { background: rgba(240,237,232,0.12); }
.nav.nav-dark.scrolled {
  background: rgba(20,18,16,0.88);
  box-shadow: 0 1px 0 rgba(255,255,255,0.06);
}
.nav.nav-dark .logo-j1 { color: var(--fg-inverse); }
.nav.nav-dark .li-badge {
  border-color: rgba(240,237,232,0.22);
  color: rgba(240,237,232,0.65);
}
.nav.nav-dark .li-badge:hover {
  border-color: rgba(240,237,232,0.7);
  background: rgba(240,237,232,0.10);
  color: var(--fg-inverse);
}

/* Nav right-side group */
.nav-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* LinkedIn badge */
.li-badge {
  width: 40px; height: 40px;
  border: 1.5px solid var(--border-strong);
  border-radius: var(--radius-sm);
  display: flex; align-items: center; justify-content: center;
  color: var(--fg1);
  transition: border-color 0.2s, background 0.2s, color 0.2s;
  flex-shrink: 0;
}
.li-badge:hover {
  border-color: var(--fg1);
  background: var(--fg1);
  color: var(--fg-inverse);
}
.li-badge svg { width: 18px; height: 18px; fill: currentColor; }


/* Mobile toggle */
.nav-toggle { display: none; width: 40px; height: 40px; align-items: center; justify-content: center; }
.nav-toggle span,
.nav-toggle span::before,
.nav-toggle span::after {
  display: block; width: 22px; height: 2px; background: var(--fg1);
  transition: transform 0.3s, top 0.3s;
}
.nav-toggle span { position: relative; }
.nav-toggle span::before, .nav-toggle span::after { content: ''; position: absolute; left: 0; }
.nav-toggle span::before { top: -6px; }
.nav-toggle span::after  { top: 6px; }
.nav-toggle.open span { background: transparent; }
.nav-toggle.open span::before { top: 0; transform: rotate(45deg); }
.nav-toggle.open span::after  { top: 0; transform: rotate(-45deg); }

.mobile-menu {
  display: none; position: fixed; inset: 0; z-index: 99;
  background: rgba(236,234,229,0.97);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  flex-direction: column; align-items: center; justify-content: center; gap: 28px;
  padding-bottom: 0;
}
.mobile-menu.open { display: flex; }
.mobile-menu > a {
  font-family: var(--font-display); font-weight: 900;
  font-size: 1.75rem; letter-spacing: -0.03em;
  color: var(--fg1);
}
.mobile-menu > a.active { color: var(--accent); }
.mobile-menu-secondary {
  position: absolute; bottom: 0; left: 0; right: 0;
  display: flex; flex-direction: column; align-items: stretch;
  gap: 8px; padding: 16px 32px 32px;
  border-top: 1px solid var(--border);
}
.mobile-menu-btn {
  display: flex; align-items: center; gap: 12px;
  padding: 11px 18px; border-radius: var(--radius-sm);
  border: 1.5px solid var(--border-strong);
  background: transparent;
  font-family: var(--font-body); font-size: 0.9rem;
  color: var(--fg2); cursor: pointer; text-decoration: none;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}
.mobile-menu-btn:hover {
  border-color: var(--accent); color: var(--accent); background: var(--accent-muted);
}
.mobile-menu-btn svg { width: 18px; height: 18px; flex-shrink: 0; }

/* ============================================================
   Buttons
   ============================================================ */
.btn {
  display: inline-flex; align-items: center; gap: 0;
  padding: 12px 28px; border-radius: var(--radius-full);
  font-family: var(--font-body); font-size: 0.9rem;
  position: relative; overflow: hidden; white-space: nowrap;
  transition:
    color 0.35s cubic-bezier(0.4,0,0.2,1),
    border-color 0.35s cubic-bezier(0.4,0,0.2,1),
    box-shadow 0.3s;
}
.btn::before {
  content: ''; position: absolute; inset: 0;
  transform: scaleX(0); transform-origin: left center;
  transition: transform 0.42s cubic-bezier(0.4,0,0.2,1);
  z-index: 0;
}
.btn:hover::before { transform: scaleX(1); }
.btn > span, .btn > .btn-icon { position: relative; z-index: 1; }
.btn-icon {
  display: inline-flex; align-items: center;
  max-width: 0; overflow: hidden; opacity: 0;
  margin-right: 0;
  transition:
    max-width 0.42s cubic-bezier(0.4,0,0.2,1),
    opacity 0.32s cubic-bezier(0.4,0,0.2,1),
    margin-right 0.42s cubic-bezier(0.4,0,0.2,1);
}
.btn:hover .btn-icon { max-width: 22px; opacity: 1; margin-right: 6px; }
.btn-icon svg { width: 16px; height: 16px; flex-shrink: 0; }

.btn-ghost {
  background: rgba(255,255,255,0.5);
  border: 3px solid rgba(28,26,23,0.10);
  color: var(--fg1);
}
.btn-ghost::before { background: var(--accent); }
.btn-ghost:hover {
  color: #fff;
  border-color: rgba(61,61,181,0.55);
  box-shadow: 0 6px 24px rgba(61,61,181,0.22);
}

.btn-accent {
  background: var(--accent);
  border: 3px solid rgba(61,61,181,0.70);
  color: #fff;
}
.btn-accent::before { background: var(--accent-dark); }
.btn-accent:hover {
  border-color: rgba(61,61,181,0.9);
  box-shadow: 0 6px 24px rgba(61,61,181,0.3);
}

.btn-dark-outline {
  background: transparent;
  border: 3px solid rgba(255,255,255,0.28);
  color: var(--fg-inverse);
}
.btn-dark-outline::before { background: rgba(255,255,255,0.12); }
.btn-dark-outline:hover {
  border-color: rgba(255,255,255,0.6);
  color: #fff;
}

/* ============================================================
   Pages
   ============================================================ */
.page { display: none; }
.page.active { display: block; flex: 1; }

/* ============================================================
   Marquee (decorative)
   ============================================================ */
.marquee {
  overflow: hidden;
  pointer-events: none;
  mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
}
.marquee-track {
  display: flex; width: max-content;
  animation: marquee 30s linear infinite;
}
.marquee-track span {
  font-family: var(--font-display); font-weight: 900;
  white-space: nowrap; letter-spacing: -0.03em;
  padding: 0 24px;
}

/* ============================================================
   HOME — Hero
   ============================================================ */
.hero {
  padding-top: clamp(120px, 16vw, 180px);
  padding-bottom: clamp(60px, 8vw, 100px);
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero-marquee {
  position: absolute; top: 50%; left: 0; right: 0;
  transform: translateY(-60%);
  pointer-events: none; z-index: 1;
}
.hero-marquee .marquee-track { animation-duration: 55s; }
.hero-marquee span {
  font-size: clamp(6rem, 14vw, 11rem);
  color: rgba(61, 61, 181, 0.055);
}
.hero-inner { position: relative; z-index: 2; }
.hero-greeting {
  font-size: clamp(2.6rem, 5vw, 3.8rem);
  letter-spacing: -0.035em;
  line-height: 1.1;
  margin-bottom: 8px;
}
.hero-role {
  font-family: var(--font-body);
  font-size: clamp(1.25rem, 2.5vw, 1.6rem);
  color: var(--fg3);
  margin-bottom: 44px;
  letter-spacing: 0.01em;
  height: 1.6em;
  overflow: hidden;
  position: relative;
}
.role-item {
  position: absolute;
  left: 0; right: 0;
  transform: translateY(110%);
  opacity: 0;
  transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  white-space: nowrap;
}
.role-item.is-active { transform: translateY(0); opacity: 1; }
.role-item.is-prev   { transform: translateY(-110%); opacity: 0; }
.hero-photo {
  width: clamp(200px, 26vw, 268px);
  height: clamp(200px, 26vw, 268px);
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 44px;
  border: 6px solid var(--border);
  box-shadow: 0 20px 60px rgba(61,61,181,0.15);
  position: relative;
  will-change: transform;
  transition:
    transform 0.55s cubic-bezier(0.22,1,0.36,1),
    box-shadow 0.28s,
    border-color 0.38s cubic-bezier(0.4,0,0.2,1);
}
.hero-photo:hover {
  box-shadow: var(--shadow-lg);
  border-color: rgba(61,61,181,0.30);
}
.hero-photo::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(
    circle at calc(var(--tilt-mx, 50) * 1%) calc(var(--tilt-my, 50) * 1%),
    rgba(255,255,255,0.18) 0%,
    rgba(255,255,255,0.06) 40%,
    transparent 70%
  );
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.hero-photo.tilt-active::after { opacity: 1; }
.hero-photo img { width: 100%; height: 100%; object-fit: cover; }
.hero-tagline {
  font-family: var(--font-body);
  font-size: 1rem; color: var(--fg2);
  max-width: 520px; margin: 0 auto 36px;
  line-height: 1.8;
}
.hero-ctas {
  display: flex; gap: 12px;
  justify-content: center; flex-wrap: wrap;
}

/* ============================================================
   HOME — Brands strip
   ============================================================ */
.brands {
  padding: 60px 0;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  overflow: hidden;
}
.brands-label {
  text-align: center; margin-bottom: 36px;
}
.brands-marquee {
  overflow: hidden;
  mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
}
.brands-track {
  display: flex;
  width: max-content;
  align-items: center;
  height: 39px;
  gap: clamp(48px, 7vw, 96px);
  animation: brands-scroll 28s linear infinite;
}
@keyframes brands-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.brands-track a {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}
.brands-track img {
  height: 36px;
  width: auto;
  object-fit: contain;
  opacity: 0.35;
  filter: grayscale(100%);
  transform: scale(1);
  transition: opacity 0.25s, filter 0.25s, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
}
.brands-track a:hover img {
  opacity: 0.85;
  filter: grayscale(0%);
  transform: scale(1.1);
}
@media (prefers-reduced-motion: reduce) {
  .brands-track { animation: none; }
}
.brands-tooltip {
  position: fixed; z-index: 9999; pointer-events: none;
  padding: 6px 12px; border-radius: 8px;
  background: var(--dark); color: var(--fg-inverse);
  font-family: var(--font-body); font-size: 0.75rem;
  white-space: nowrap; box-shadow: var(--shadow-md);
  opacity: 0; transition: opacity 0.18s;
  transform: translateY(-4px);
}
.brands-tooltip.visible { opacity: 1; transform: translateY(0); transition: opacity 0.18s, transform 0.18s; }

/* ============================================================
   HOME — Stats
   ============================================================ */
.stats { padding: clamp(72px, 10vw, 100px) 0; }
.stats .eyebrow { text-align: center; display: block; margin-bottom: 52px; }
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(24px, 4vw, 48px);
}
.stat { text-align: center; }
.stat-num {
  font-family: var(--font-display); font-weight: 900;
  font-size: clamp(3rem, 5vw, 4.8rem);
  letter-spacing: -0.04em; line-height: 1;
  margin-bottom: 10px; color: var(--fg1);
}
.stat-num sup { font-size: 0.38em; color: var(--fg3); vertical-align: super; margin-left: 2px; }
.stat-num .unit { font-size: 0.38em; color: var(--fg3); }
.stat-title {
  font-family: var(--font-display); font-weight: 900;
  font-size: var(--text-h3); letter-spacing: -0.01em;
  line-height: 1.25; margin-bottom: 8px;
  color: var(--fg1);
}
.stat-desc {
  font-family: var(--font-body);
  font-size: 0.82rem; color: var(--fg3);
  line-height: 1.6;
}
.stats-cta { text-align: center; margin-top: 52px; }

/* ============================================================
   HOME — Testimonials (masonry)
   ============================================================ */
.testimonials {
  padding: clamp(60px, 8vw, 80px) 0;
  background: var(--bg-alt);
}
.testimonials .eyebrow { text-align: center; display: block; margin-bottom: 40px; }
.testimonials-masonry { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.testimonial-card {
  background: var(--surface);
  border-radius: 22px;
  border: 6px solid var(--border);
  padding: 24px;
  margin-bottom: 20px;
  box-shadow: var(--shadow-sm);
  will-change: transform;
  position: relative;
  overflow: hidden;
  transition:
    transform 0.55s cubic-bezier(0.22,1,0.36,1),
    box-shadow 0.28s,
    border-color 0.38s cubic-bezier(0.4,0,0.2,1);
}
.testimonial-card:hover {
  box-shadow: var(--shadow-lg);
  border-color: rgba(61,61,181,0.30);
}
.testimonial-header {
  display: flex; align-items: center;
  gap: 12px; margin-bottom: 14px;
}
.testimonial-avatar {
  width: 50px; height: 50px;
  border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(135deg, var(--accent-subtle), rgba(61,61,181,0.18));
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display); font-weight: 900;
  font-size: 0.85rem; color: var(--accent);
  overflow: hidden;
}
.testimonial-avatar img {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.testimonial-name {
  font-family: var(--font-display); font-weight: 900;
  font-size: 1rem; letter-spacing: -0.01em;
  color: var(--fg1);
}
.testimonial-role {
  font-family: var(--font-body);
  font-size: 0.72rem; color: #a2a2a2;
  margin-top: 2px;
}
.testimonial-li-hint {
  position: absolute; top: 14px; right: 14px;
  display: flex; align-items: center; gap: 5px;
  padding: 5px 10px; border-radius: var(--radius-full);
  background: var(--accent); color: #fff;
  font-family: var(--font-body); font-size: 0.68rem;
  white-space: nowrap; pointer-events: none;
  opacity: 0;
  transform: translateY(-4px);
  transition: opacity 0.22s ease, transform 0.22s ease;
  z-index: 2;
}
.testimonial-li-hint svg { width: 11px; height: 11px; fill: currentColor; flex-shrink: 0; }
.testimonial-card:hover .testimonial-li-hint { opacity: 1; transform: translateY(0); }
.testimonial-quote {
  font-family: var(--font-body);
  font-size: 0.84rem; color: var(--fg2);
  line-height: 1.7;
  margin-bottom: 10px;
}
.testimonial-relation {
  font-family: var(--font-body);
  font-size: 0.72rem; color: var(--fg3);
  line-height: 1.5; margin: 0;
  padding-top: 10px;
  border-top: 1px solid var(--border);
}

/* ============================================================
   Case card
   ============================================================ */
.case-card {
  background: var(--surface);
  border-radius: 20px;
  border: 6px solid var(--border);
  overflow: hidden;
  cursor: pointer;
  box-shadow: var(--shadow-sm);
  will-change: transform;
  position: relative;
  transition:
    transform 0.55s cubic-bezier(0.22,1,0.36,1),
    box-shadow 0.28s,
    border-color 0.38s cubic-bezier(0.4,0,0.2,1);
}
.case-card:hover {
  box-shadow: var(--shadow-lg);
  border-color: rgba(61,61,181,0.30);
}
.case-card::before {
  content: '';
  position: absolute; inset: 0;
  background: var(--accent-muted);
  opacity: 0;
  z-index: 1;
  pointer-events: none;
  transition: opacity 0.35s ease;
  border-radius: 14px; /* card radius (20px) minus border (6px) = inner clip radius */
}
.case-card:hover::before { opacity: 1; }
.case-card::after,
.testimonial-card::after,
.next-case::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(
    circle at calc(var(--tilt-mx, 50) * 1%) calc(var(--tilt-my, 50) * 1%),
    rgba(255,255,255,0.12) 0%,
    rgba(255,255,255,0.04) 40%,
    transparent 70%
  );
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}
.case-card.tilt-active::after,
.testimonial-card.tilt-active::after,
.next-case.tilt-active::after { opacity: 1; }
.case-card-featured img { height: 224px; }
.case-card img {
  width: 100%; height: 180px;
  object-fit: cover; display: block;
  transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
}
.case-card:hover img { transform: scale(1.08); }
.case-card-body { padding: 20px 22px 24px; position: relative; z-index: 2; }
.case-card-cat {
  font-family: var(--font-body);
  font-size: 0.72rem; color: var(--fg3);
  text-transform: uppercase; letter-spacing: 0.06em;
  margin-bottom: 8px;
}
.case-card-title {
  font-family: var(--font-display); font-weight: 900;
  font-size: 1rem; letter-spacing: -0.02em;
  line-height: 1.3; color: var(--fg1);
}

/* ============================================================
