---
import Base from '../../layouts/Base.astro';
import { CASES } from '../../data/cases';
import RedefiningWebinarBody from '../../components/cases/RedefiningWebinarBody.astro';
import UnderstandingWebinarOrganizersBody from '../../components/cases/UnderstandingWebinarOrganizersBody.astro';
import LeadingDesignSystemBody from '../../components/cases/LeadingDesignSystemBody.astro';
import DesigningSupportChatBody from '../../components/cases/DesigningSupportChatBody.astro';

export function getStaticPaths() {
  return CASES.map(c => ({ params: { slug: c.slug }, props: { caseData: c } }));
}

const { caseData: c } = Astro.props;
/* "Next case" walks only the visible cases — soft-hidden ones (see
   the `hidden` flag in cases.ts) are skipped so they don't surface
   via the case-detail pager. getStaticPaths still builds their
   pages above, so direct URLs continue to work. */
const visibleCases = CASES.filter(x => !x.hidden);
const visIdx = visibleCases.findIndex(x => x.slug === c.slug);
/* If the current case is itself hidden (deep-linked), fall back to
   the first visible case rather than NaN-ing the modulo. */
const nextIdx = visIdx === -1 ? 0 : (visIdx + 1) % visibleCases.length;
const next = visibleCases[nextIdx];
const outcomesClass = c.outcomes.length === 2 ? 'cols-2' : 'cols-3';

/* Some cases have a hand-built body component (richer layout than
   the default template). Detect them here and skip the templated
   header/sections/outcomes chain when one is present. */
const customBodySlugs = new Set([
  'redefining-webinar-customization',
  'understanding-webinar-organizers',
  'leading-and-managing-a-design-system',
  'designing-a-support-chat-experience',
]);
const hasCustomBody = customBodySlugs.has(c.slug);

/* Side-TOC items.
   - Default cases: fixed journey labels (Context / Problem / Approach /
     Solution / Impact). Section anchors fall through if a case has
     fewer than three sections, so the TOC adapts without throwing.
   - Custom-body cases: a slug-specific TOC matching the section
     anchors defined inside the body component. */
const tocItems = c.slug === 'redefining-webinar-customization'
  ? [
      { id: 'case-context',      label: 'Context' },
      { id: 'case-discovery',    label: 'Discovery' },
      { id: 'case-problem',      label: 'Problem' },
      { id: 'case-approach',     label: 'Approach' },
      { id: 'case-step-1',       label: 'Step 1 · Branding' },
      { id: 'case-step-2',       label: 'Step 2 · Fields' },
      { id: 'case-final-result', label: 'Final result' },
      { id: 'case-impact',       label: 'Impact' },
    ]
  : c.slug === 'understanding-webinar-organizers'
  ? [
      { id: 'case-context',    label: 'Context' },
      { id: 'case-role',       label: 'My role' },
      { id: 'case-challenge',  label: 'The challenge' },
      { id: 'case-deep-dive',  label: 'Deep-dive' },
      { id: 'case-validation', label: 'Validation' },
      { id: 'case-impact',     label: 'Impact' },
    ]
  : c.slug === 'leading-and-managing-a-design-system'
  ? [
      { id: 'case-context',         label: 'Context' },
      { id: 'case-role',            label: 'My role' },
      { id: 'case-challenge',       label: 'The challenge' },
      { id: 'case-organizing',      label: 'Organizing the team' },
      { id: 'case-weekly-practice', label: 'Weekly practice' },
      { id: 'case-design',          label: 'Design' },
      { id: 'case-impact',          label: 'Impact' },
    ]
  : c.slug === 'designing-a-support-chat-experience'
  ? [
      { id: 'case-context',             label: 'Context' },
      { id: 'case-role',                label: 'My role' },
      { id: 'case-challenge',           label: 'The challenge' },
      { id: 'case-kickoff',             label: 'Kickoff and research' },
      { id: 'case-discovery',           label: 'What we discovered' },
      { id: 'case-design-iterations',   label: 'Design iterations' },
      { id: 'case-customer-chat',       label: 'Customer-facing chat' },
      { id: 'case-design-system',       label: 'Design system' },
      { id: 'case-impact',              label: 'Impact' },
      { id: 'case-current-state',       label: 'Current state' },
      { id: 'case-retrospective',       label: 'Retrospective' },
    ]
  : [
      { id: 'case-context', label: 'Context' },
      c.sections[0] ? { id: 'case-section-0', label: 'Problem' } : null,
      c.sections[1] ? { id: 'case-section-1', label: 'Approach' } : null,
      c.sections[2] ? { id: 'case-section-2', label: 'Solution' } : null,
      { id: 'case-impact', label: 'Impact' },
    ].filter(Boolean);
---
<Base
  activePage="cases"
  title={`${c.title} — João Jacinto`}
  description={c.subtitle}
  showCta={true}
>

  <div class="case-wrap" id="case-content">
    <div class="case-toc-rail">
      <nav class="case-toc" aria-label="Case study sections">
        {tocItems.map(item => (
          <a href={`#${item.id}`} data-toc-target={item.id} data-umami-event="case-toc" data-umami-event-target={item.id}>{item.label}</a>
        ))}
      </nav>
    </div>

    <div class="container">
      <a class="back-link" data-umami-event="case-detail-back" href="/case-studies">← Back to case studies</a>

      {hasCustomBody ? (
        c.slug === 'understanding-webinar-organizers' ? (
          <UnderstandingWebinarOrganizersBody />
        ) : c.slug === 'leading-and-managing-a-design-system' ? (
          <LeadingDesignSystemBody />
        ) : c.slug === 'designing-a-support-chat-experience' ? (
          <DesigningSupportChatBody />
        ) : (
          <RedefiningWebinarBody />
        )
      ) : (
        <>
          <div class="case-header" id="case-context">
            <div class="case-cat">{c.cat}</div>
            <h1 class="case-title">{c.title}</h1>
            <p class="case-subtitle">{c.subtitle}</p>

            <div class="case-meta-grid">
              <div><div class="case-meta-label">Company</div><div class="case-meta-val">{c.company}</div></div>
              <div><div class="case-meta-label">Role</div><div class="case-meta-val">{c.role}</div></div>
              <div><div class="case-meta-label">Year</div><div class="case-meta-val">{c.year}</div></div>
              <div><div class="case-meta-label">Duration</div><div class="case-meta-val">{c.duration}</div></div>
            </div>

            <div class="case-keywords">
              {c.keywords.map(k => <span class="keyword">{k}</span>)}
            </div>
          </div>

          <div class="case-hero-img reveal">
            <img src={c.img} alt={c.title} width={c.imgW} height={c.imgH} loading="eager" fetchpriority="high">
          </div>

          <div class={`outcomes ${outcomesClass} reveal`} id="case-impact">
            {c.outcomes.map(o => (
              <div class="outcome">
                <div class="outcome-num">{o.n}</div>
                <div class="outcome-title">{o.title}</div>
                <div class="outcome-desc">{o.desc}</div>
              </div>
            ))}
          </div>

          <section class="achievements reveal">
            <span class="eyebrow">Key outcomes</span>
            <ul>{c.achievements.map(a => <li>{a}</li>)}</ul>
          </section>

          <div class="case-sections">
            {c.sections.map((s, sIdx) => (
              <div class="reveal" id={`case-section-${sIdx}`}>
                <h2>{s.h}</h2>
                <p>{s.body}</p>
              </div>
            ))}
          </div>

          <blockquote class="pull-quote reveal">"{c.quote}"</blockquote>
        </>
      )}

      <div class="next-case-wrap">
        <span class="eyebrow">Next case study</span>
        <a class="next-case reveal" href={`/case-studies/${next.slug}`} data-umami-event="next-case" data-umami-event-slug={next.slug}>
          <img src={next.img} alt={next.title} width={next.imgW} height={next.imgH} loading="lazy">
          <div class="next-case-body">
            <div class="next-case-cat">{next.cat}</div>
            <div class="next-case-title">{next.title} →</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Password gate overlay — shown via JS if not unlocked -->
  <div id="pw-overlay" style="display:none">
    <div class="case-wrap">
      <div class="container">
        <a class="back-link" data-umami-event="case-detail-back" href="/case-studies">← Back to case studies</a>
        <div class="pw-gate reveal visible">
          <div class="pw-gate-lock">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h2>This case study is private</h2>
          <p>Enter the password to read it.</p>
          <form class="pw-form" id="pwForm">
            <div class="pw-input-wrap">
              <input type="password" class="pw-input" id="pwInput" placeholder="Password" autocomplete="current-password">
              <button type="button" class="pw-reveal" id="pwReveal" aria-label="Show password" onclick="togglePwReveal()">
                <svg class="pw-eye-open" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="pw-eye-shut" viewBox="0 0 24 24" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
            <p class="pw-error" id="pwError"></p>
            <button type="submit" class="btn btn-accent">
              <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
              <span>Unlock</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

</Base>

<script is:inline>
const CASE_PASSWORD = 'alohomora';

function isUnlocked() {
  return sessionStorage.getItem('jj-case-unlocked') === '1';
}

if (!isUnlocked()) {
  document.getElementById('case-content').style.display = 'none';
  document.getElementById('pw-overlay').style.display = '';
  setTimeout(() => document.getElementById('pwInput')?.focus(), 50);
}

document.getElementById('pwForm')?.addEventListener('submit', function(e) {
  e.preventDefault();
  const input = document.getElementById('pwInput');
  const error = document.getElementById('pwError');
  const ok = input.value.trim().toLowerCase() === CASE_PASSWORD;
  if (window.umami && typeof window.umami.track === 'function') {
    window.umami.track(ok ? 'case-unlock-success' : 'case-unlock-fail');
  }
  if (ok) {
    sessionStorage.setItem('jj-case-unlocked', '1');
    const overlay = document.getElementById('pw-overlay');
    const content = document.getElementById('case-content');
    /* Reveal the page underneath, then break the gate away over it so
       the content fades up slowly from behind as the lock dissolves. */
    content.style.display = '';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      overlay.style.display = 'none';
    } else {
      content.classList.add('pw-revealing');
      overlay.classList.add('pw-breaking');
      setTimeout(function () { overlay.style.display = 'none'; }, 700);
    }
  } else {
    error.textContent = 'Incorrect password — try again.';
    input.classList.add('pw-shake');
    input.value = '';
    input.focus();
    input.addEventListener('animationend', () => input.classList.remove('pw-shake'), { once: true });
  }
});

function togglePwReveal() {
  const input = document.getElementById('pwInput');
  const btn   = document.getElementById('pwReveal');
  if (!input || !btn) return;
  const showing = input.type === 'text';
  input.type = showing ? 'password' : 'text';
  btn.querySelector('.pw-eye-open').style.display = showing ? '' : 'none';
  btn.querySelector('.pw-eye-shut').style.display = showing ? 'none' : '';
  btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
  input.focus();
}

/* Floating side-TOC behavior.
   - paintActive(): chooses the deepest target whose top has crossed
     the 35%-viewport activation line. Highlights its TOC link.
   - paintFade(): reads .case-wrap's bottom edge in viewport
     coordinates and fades the TOC out as the wrap end approaches
     the TOC's own bottom — so the rail disappears smoothly before
     the contact section below would overlap it. Pointer events
     drop too while faded so a dim link can't be tab-trapped.
   - paintCentering(): the TOC starts vertically centered on the
     viewport at scroll=0; once scrolled past the centering offset
     it sticks (CSS handles that — we just keep the centering
     margin-top in sync with the TOC's measured half-height). */
(function () {
  var rail  = document.querySelector('.case-toc-rail');
  var toc   = document.querySelector('.case-toc');
  var wrap  = document.querySelector('.case-wrap');
  var links = toc ? toc.querySelectorAll('a') : [];
  if (!rail || !toc || !wrap || !links.length) return;

  var targets = [];
  links.forEach(function (link) {
    var id = link.getAttribute('data-toc-target');
    var el = id && document.getElementById(id);
    if (el) targets.push({ id: id, el: el, link: link });
  });
  if (!targets.length) return;

  function syncCentering() {
    /* Centering margin-top: half the viewport minus half the TOC
       height. Sticky `top` is set in CSS to the nav-clearance
       value, so once scrolling consumes this margin the TOC parks
       beneath the nav and stays there. */
    var h = toc.offsetHeight;
    rail.style.setProperty('--case-toc-half-h', (h / 2) + 'px');
  }

  function paintActive() {
    var activeIdx = -1;
    var activationY = window.innerHeight * 0.35;
    targets.forEach(function (t, i) {
      var r = t.el.getBoundingClientRect();
      if (r.top - activationY <= 0) activeIdx = i;
    });
    if (activeIdx === -1) activeIdx = 0;
    targets.forEach(function (t, i) {
      t.link.classList.toggle('is-active', i === activeIdx);
    });
  }

  function paintFade() {
    var wr = wrap.getBoundingClientRect();
    var tr = toc.getBoundingClientRect();
    /* Buffer: vertical gap between TOC bottom and case-wrap bottom.
       Positive while case-wrap extends below the TOC; goes negative
       once the wrap end has scrolled past the TOC bottom. We start
       fading 200px before that crossover so the disappearance is
       gentle, not a snap. */
    var buffer = wr.bottom - tr.bottom;
    var fadeRange = 200;
    var opacity = 1;
    if (buffer < fadeRange) {
      opacity = Math.max(0, Math.min(1, buffer / fadeRange));
    }
    toc.style.opacity = opacity;
    toc.style.pointerEvents = opacity < 0.1 ? 'none' : '';
  }

  function paint() {
    paintActive();
    paintFade();
  }

  syncCentering();
  paint();
  window.addEventListener('scroll', paint, { passive: true });
  window.addEventListener('resize', function () {
    syncCentering();
    paint();
  }, { passive: true });
  /* TOC item count can change between unlock states or fonts loading;
     observe its size so the centering offset stays correct. */
  if (window.ResizeObserver) new ResizeObserver(syncCentering).observe(toc);
})();
</script>
