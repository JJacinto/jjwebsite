---
import Base from '../../layouts/Base.astro';
import { CASES } from '../../data/cases';

/* Soft-hide via the `hidden` flag in cases.ts — filter the visible
   list once, then slice into featured/rest from the filtered view. */
const visible  = CASES.filter(c => !c.hidden);
const featured = visible.slice(0, 2);
const rest     = visible.slice(2);
---
<Base
  activePage="cases"
  title="Case Studies — João Jacinto"
  description="Product design case studies by João Jacinto — webinar UX, research ops, design systems, AI platforms, and support tools."
>

  <div class="cases-wrap">
    <div class="marquee cases-marquee">
      <div class="marquee-track">
        <span>CASE STUDIES</span><span>·</span><span>WORK</span><span>·</span>
        <span>CASE STUDIES</span><span>·</span><span>WORK</span><span>·</span>
      </div>
    </div>
    <div class="container">
      <div class="cases-grid-row-2" style="margin-bottom:24px">
        {featured.map((c, i) => (
          <a class={`case-card case-card-featured reveal reveal-d${i + 1}`} href={`/case-studies/${c.slug}`} data-umami-event="case-card-index-featured" data-umami-event-slug={c.slug}>
            <img src={c.img} alt={c.title} width={c.imgW} height={c.imgH} loading="eager" fetchpriority="high">
            <div class="case-card-body">
              <div class="case-card-cat">{c.cat}</div>
              <div class="case-card-title">{c.title}</div>
            </div>
          </a>
        ))}
      </div>
      <div class={rest.length <= 2 ? 'cases-grid-row-2' : 'cases-grid'}>
        {rest.map((c, i) => (
          <a class={`case-card reveal reveal-d${i + 1}`} href={`/case-studies/${c.slug}`} data-umami-event="case-card-index" data-umami-event-slug={c.slug}>
            <img src={c.img} alt={c.title} width={c.imgW} height={c.imgH} loading="lazy">
            <div class="case-card-body">
              <div class="case-card-cat">{c.cat}</div>
              <div class="case-card-title">{c.title}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

</Base>
