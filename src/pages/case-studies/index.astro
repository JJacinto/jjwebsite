---
import Base from '../../layouts/Base.astro';
import { CASES } from '../../data/cases';

/* Hidden cases (see cases.ts) are not shown or built. */
const visible = CASES.filter(c => !c.hidden);
---
<Base
  activePage="cases"
  title="Case Studies — João Jacinto"
  description="Product design case studies by João Jacinto — webinar UX, research ops, design systems, AI platforms, and support tools."
  titlePt="Casos de Estudo — João Jacinto"
  descriptionPt="Casos de estudo de product design de João Jacinto — UX de webinars, research ops, design systems, plataformas de IA e ferramentas de suporte."
>

  <div class="work-wrap">
    <div class="container">

      <header class="work-head">
        <span class="eyebrow" data-pt="Trabalho">Work</span>
        <h1 data-pt="Quatro problemas, desembaraçados.">Four problems, untangled.</h1>
        <p class="work-intro" data-pt="Cada um começou numa confusão: componentes que se tinham afastado do código, agentes de suporte afogados em separadores, webinars sem a cara de quem os organizava. Aqui fica o que cortei e o que foi lançado.">Each one started messy: components that had drifted from code, support agents buried in tabs, webinars that couldn't look like their hosts. Here's what I cut, and what shipped.</p>
      </header>

      <div class="work-grid">
        {visible.map((c, i) => (
          <a class={`case-card work-card reveal reveal-d${(i % 2) + 1}`} href={`/case-studies/${c.slug}`} data-umami-event={i < 2 ? 'case-card-index-featured' : 'case-card-index'} data-umami-event-slug={c.slug}>
            <div class="work-card-media">
              <img src={c.img} alt={c.title} data-pt-alt={c.titlePt} width={c.imgW} height={c.imgH} loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i < 2 ? 'high' : undefined}>
            </div>
            <div class="work-card-body">
              <div class="work-card-meta">
                <span class="eyebrow">{c.company} · {c.year}</span>
                <span class="work-card-lock">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <span data-pt="Privado">Private</span>
                </span>
              </div>
              <h2 class="case-card-title work-card-title" data-pt={c.titlePt}>{c.title}</h2>
              <p class="work-card-problem" data-pt={c.problemPt}>{c.problem}</p>
              <div class="work-card-foot">
                <span class="work-card-num" data-pt={c.cardNumPt}>{c.cardNum}</span>
                <span class="work-card-label" data-pt={c.cardLabelPt}>{c.cardLabel}</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <article class="work-next reveal">
        <div class="work-next-text">
          <span class="eyebrow" data-pt="Anchorage Digital · A escrever o caso">Anchorage Digital · Writing it up</span>
          <h2 class="work-next-title" data-pt="Políticas e permissões">Policies and permissions</h2>
          <p class="work-next-body" data-pt="O redesenho que transformou um fluxo de administração de 40 passos num único passo de configuração. O caso de estudo está a ser escrito.">The redesign that turned a 40-step admin flow into one configuration step. The case study is in progress.</p>
        </div>
        <div class="work-next-stat">
          <span class="work-card-num">40 → 1</span>
          <span class="work-card-label" data-pt="passos de administração">admin steps</span>
        </div>
      </article>

      <p class="work-access"><span data-pt="Todos os casos de estudo são privados.">All case studies are private.</span> <button type="button" class="work-ask" data-umami-event="work-ask-access" data-pt="Pede-me acesso" onclick="jjComposeWith((window.jjLang ? window.jjLang() : 'en') === 'pt' ? 'Olá João, podes enviar-me a palavra-passe dos casos de estudo?' : 'Hi João, could you send me the password for the case studies?')">Ask me for access</button> <span data-pt="e eu envio a palavra-passe.">and I'll send the password.</span></p>

    </div>
  </div>

</Base>
