---
import '../styles/global.css';
import { versioned } from '../lib/script-url';
import Footer from '../components/Footer.astro';
import XraySwitch from '../components/XraySwitch.astro';
import { LANGUAGES } from '../i18n/languages.mjs';

interface Props {
  title?: string;
  description?: string;
  /* Portuguese versions, used when the visitor switches to PT. */
  titlePt?: string;
  descriptionPt?: string;
  activePage?: 'home' | 'about' | 'cases' | 'contact';
  navDark?: boolean;
  showFooter?: boolean;
  showCta?: boolean;
  /* Disable the page-wide particle overlay above the fold. Set true
     on pages that already paint their own particle field in the hero
     (contact, error pages) to avoid doubling up. */
  disablePageParticles?: boolean;
  /* The page renders <Footer /> itself, inside its own field (contact), so
     Base skips the closing band and its second field. */
  footerInPage?: boolean;
  /* Keep the page out of search results (error pages). */
  noindex?: boolean;
  /* Trail after "Home" for search results, e.g. Case studies > Case title.
     Paths are site-relative and end in a slash. */
  breadcrumb?: { name: string; namePt?: string; path: string }[];
  /* Extra schema.org nodes for this page (e.g. the case study itself). */
  jsonLd?: Record<string, unknown>[];
  /* The same nodes for the Portuguese page (falls back to jsonLd). */
  jsonLdPt?: Record<string, unknown>[];
}

const {
  title = 'João Jacinto — Senior Product Designer',
  description = 'João Jacinto — Senior Product Designer based in Aveiro, Portugal. 10+ years designing digital products with startups and enterprises.',
  titlePt = 'João Jacinto — Senior Product Designer',
  descriptionPt = 'João Jacinto — Senior Product Designer em Aveiro, Portugal. Mais de 10 anos a desenhar produtos digitais com startups e grandes empresas.',
  activePage = 'home',
  navDark = false,
  showFooter = true,
  showCta = true,
  disablePageParticles = false,
  footerInPage = false,
  noindex = false,
  breadcrumb = [],
  jsonLd = [],
  jsonLdPt,
} = Astro.props;

const siteUrl     = 'https://joaojacinto.com';
const canonical   = new URL(Astro.url.pathname, siteUrl).href;
const ogImage     = `${siteUrl}/assets/og-image.png`;
const isHome      = activePage === 'home';

/* Structured data, one graph per page: the site, João, this page, and the
   breadcrumb trail when there is one. The ids let the nodes point at each
   other, and let pages add their own nodes that refer to João as author. */
const personId  = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
function buildGraph(pt: boolean) {
  /* The Portuguese page lives under /pt/; the site-level nodes (WebSite,
     Person) keep the same ids in both languages. */
  const prefix   = pt ? '/pt' : '';
  const pageUrl  = pt ? new URL(prefix + Astro.url.pathname, siteUrl).href : canonical;
  const crumbsId = `${pageUrl}#breadcrumb`;
  return {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${siteUrl}/`,
      name: 'João Jacinto',
      inLanguage: pt ? 'pt-PT' : 'en',
      publisher: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'João Jacinto',
      jobTitle: 'Senior Product Designer',
      url: `${siteUrl}/`,
      image: ogImage,
      sameAs: [
        'https://linkedin.com/in/joaofranciscojacinto/',
        'https://x.com/joao_jacinto_8',
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Aveiro',
        addressCountry: 'PT',
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Anchorage Digital',
        url: 'https://www.anchorage.com',
      },
    },
    {
      '@type': isHome ? 'ProfilePage' : 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pt ? titlePt : title,
      description: pt ? descriptionPt : description,
      inLanguage: pt ? 'pt-PT' : 'en',
      isPartOf: { '@id': websiteId },
      ...(isHome ? { mainEntity: { '@id': personId } } : { about: { '@id': personId } }),
      ...(breadcrumb.length ? { breadcrumb: { '@id': crumbsId } } : {}),
    },
    ...(breadcrumb.length ? [{
      '@type': 'BreadcrumbList',
      '@id': crumbsId,
      itemListElement: [{ name: 'Home', namePt: 'Início', path: '/' }, ...breadcrumb].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: pt ? (b.namePt ?? b.name) : b.name,
        item: new URL(prefix + b.path, siteUrl).href,
      })),
    }] : []),
    ...(pt ? (jsonLdPt ?? jsonLd) : jsonLd),
  ],
  };
}
const schemaGraph = buildGraph(false);
const schemaGraphPt = buildGraph(true);
const ldEscape = (g: unknown) => JSON.stringify(g).replace(/</g, '\\u003c');

/* Umami analytics — privacy-friendly, no cookies. Renders only when
   both env vars are set in the hosting platform (Vercel/Netlify/etc.):
   - PUBLIC_UMAMI_SCRIPT_URL  e.g. https://analytics.joaojacinto.com/script.js
   - PUBLIC_UMAMI_WEBSITE_ID  e.g. 1a2b3c4d-... (from Umami dashboard) */
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const umamiId  = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiOn  = !!(umamiSrc && umamiId);

/* The language registry, handed to the inline scripts as window.jjLangs
   (language script, settings menu). Only what the browser needs. */
const jjLangs = LANGUAGES.map(({ code, htmlLang, label, short }) => ({ code, htmlLang, label, short }));

/* Flags for the language picker, drawn in a 36x26 box like the first two
   were. Plain shapes, no gradients, so they stay crisp at 18px wide. */
const FLAGS: Record<string, string> = {
  en: '<path fill="#b22234" d="M0 0h36v26H0z"/><path stroke="#fff" stroke-width="2" d="M0 3h36M0 7h36M0 11h36M0 15h36M0 19h36M0 23h36"/><path fill="#3c3b6e" d="M0 0h14.4v14H0z"/><path stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-dasharray="0 2.4" d="M2 2.2h10M2 5.4h10M2 8.6h10M2 11.8h10"/>',
  pt: '<path fill="#da291c" d="M0 0h36v26H0z"/><path fill="#046a38" d="M0 0h14.4v26H0z"/><circle cx="14.4" cy="13" r="5.2" fill="#ffe000"/><path fill="#da291c" d="M11.8 10h5.2v3.8a2.6 2.6 0 0 1-5.2 0z"/><path fill="#fff" d="M13 11.2h2.8v2.5a1.4 1.4 0 0 1-2.8 0z"/>',
  es: '<path fill="#aa151b" d="M0 0h36v26H0z"/><path fill="#f1bf00" d="M0 6.5h36v13H0z"/>',
  fr: '<path fill="#0055a4" d="M0 0h12v26H0z"/><path fill="#fff" d="M12 0h12v26H12z"/><path fill="#ef4135" d="M24 0h12v26H24z"/>',
  de: '<path fill="#000" d="M0 0h36v8.67H0z"/><path fill="#dd0000" d="M0 8.67h36v8.66H0z"/><path fill="#ffce00" d="M0 17.33h36V26H0z"/>',
  zh: '<path fill="#de2910" d="M0 0h36v26H0z"/><path fill="#ffde00" d="M6 2.9L6.81 5.39H9.42L7.31 6.92L8.12 9.41L6 7.88L3.88 9.41L4.69 6.92L2.58 5.39H5.19ZM10.99 3.25L11.54 2.58L11.07 1.85L11.88 2.16L12.43 1.48L12.38 2.35L13.2 2.66L12.36 2.89L12.31 3.76L11.84 3.03ZM12.81 5.56L13.6 5.18L13.48 4.32L14.08 4.95L14.87 4.57L14.45 5.34L15.06 5.97L14.2 5.81L13.79 6.58L13.67 5.72ZM12.85 8.64L13.73 8.63L13.99 7.8L14.27 8.63L15.14 8.62L14.44 9.14L14.72 9.96L14.01 9.46L13.31 9.98L13.57 9.15ZM11.1 11.01L11.9 11.35L12.48 10.7L12.39 11.57L13.19 11.91L12.34 12.1L12.26 12.97L11.82 12.22L10.97 12.41L11.54 11.76Z"/>',
  ja: '<path fill="#fff" d="M0 0h36v26H0z"/><circle cx="18" cy="13" r="7.8" fill="#bc002d"/>',
};
---
<!DOCTYPE html>
<html lang="en-US" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title data-pt={titlePt}>{title}</title>
<meta name="description" content={description} data-pt-content={descriptionPt}>
{noindex
  ? <meta name="robots" content="noindex">
  : <link rel="canonical" href={canonical}>}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#0e0d0c">

<!-- Open Graph -->
<meta property="og:type" content={isHome ? 'website' : 'article'}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title} data-pt-content={titlePt}>
<meta property="og:description" content={description} data-pt-content={descriptionPt}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="João Jacinto">
<meta property="og:locale" content="en_US">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title} data-pt-content={titlePt}>
<meta name="twitter:description" content={description} data-pt-content={descriptionPt}>
<meta name="twitter:image" content={ogImage}>

{!noindex && (
  <script type="application/ld+json" set:html={ldEscape(schemaGraph)} data-pt={ldEscape(schemaGraphPt)} />
)}

<!-- Fonts are served from /fonts (see @font-face in global.css). The two
     files every page uses above the fold are fetched early. -->
<link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/hanken-grotesk-900-latin.woff2" as="font" type="font/woff2" crossorigin>

<script is:inline define:vars={{ jjLangs }}>window.jjLangs = jjLangs;</script>

<!-- Settings bootstrap — runs before paint so nothing flashes.
     The visitor's choices come from the settings menu in the nav and
     are saved in localStorage:
       lang      a code from src/i18n/languages.mjs (default: en)
       textsize  "115" | "130"                (default: 100)
     The site is dark only: data-theme="dark" is fixed on <html>.
     Contrast and motion have no control in the menu; they follow the
     visitor's system settings.
     What ends up on <html>:
       lang="pt-PT"            the page's language (see the language script below)
       data-contrast="high"    high-contrast colours (global.css)
       data-motion="reduce"    low motion: no animations, no custom cursor or
                               card tilt; CSS and the canvas scripts read this
       data-text-size="115"    larger text (or "130"); scales the root font size
     Other scripts can use window.jjPrefs (get / set / effective) and
     listen on document for "jj:motionchange" (detail.reduce) and
     "jj:contrastchange" (detail.contrast). -->
<script is:inline>
(function () {
  var root = document.documentElement;
  var VALUES = { textsize: ['100', '115', '130'] };
  var DEFAULTS = { textsize: '100' };

  function read(key) {
    try {
      var v = localStorage.getItem(key);
      return VALUES[key].indexOf(v) > -1 ? v : DEFAULTS[key];
    } catch (_) { return DEFAULTS[key]; }
  }
  function media(query) {
    try { return window.matchMedia(query); } catch (_) { return { matches: false }; }
  }
  var sysContrast = media('(prefers-contrast: more)');
  var sysMotion = media('(prefers-reduced-motion: reduce)');

  /* Choices saved by the old theme, contrast and motion controls no
     longer apply; drop them so nobody is left on a setting they can't
     change. */
  try { ['theme', 'contrast', 'motion'].forEach(function (k) { localStorage.removeItem(k); }); } catch (_) {}

  var pref = { textsize: read('textsize') };

  function effective() {
    return {
      theme: 'dark',
      contrast: sysContrast.matches ? 'high' : 'normal',
      motion: sysMotion.matches ? 'reduce' : 'full',
      textsize: pref.textsize
    };
  }

  function setAttr(name, on, value) {
    if (on) root.setAttribute(name, value); else root.removeAttribute(name);
  }

  var shown = null;      /* what is on <html> right now */
  var fadeTimer = 0;
  function apply() {
    var next = effective();
    var first = !shown;
    var prev = shown || {};
    var coloursChanged = next.contrast !== prev.contrast;

    /* Cross-fade colours when the contrast changes (never on load,
       never with animations off). See html.theme-transitioning in global.css. */
    if (!first && coloursChanged && next.motion !== 'reduce') {
      root.classList.add('theme-transitioning');
      clearTimeout(fadeTimer);
      fadeTimer = setTimeout(function () { root.classList.remove('theme-transitioning'); }, 500);
    }

    setAttr('data-motion', next.motion === 'reduce', 'reduce');
    setAttr('data-contrast', next.contrast === 'high', 'high');
    setAttr('data-text-size', next.textsize !== '100', next.textsize);
    shown = next;
    if (first) return;

    function tell(name, detail) {
      document.dispatchEvent(new CustomEvent(name, { detail: detail }));
    }
    if (next.motion !== prev.motion) tell('jj:motionchange', { reduce: next.motion === 'reduce' });
    if (next.contrast !== prev.contrast) tell('jj:contrastchange', { contrast: next.contrast });
    if (next.textsize !== prev.textsize) {
      /* Everything changed size: let scripts that measure re-measure. */
      window.dispatchEvent(new Event('resize'));
    }
  }

  /* The site's languages (window.jjLangs, from src/i18n/languages.mjs):
     [{ code, htmlLang, label, short }], English first. Nothing below
     names a language: add one to the registry and it works here. */
  var LANGS = window.jjLangs || [{ code: 'en', htmlLang: 'en-US', label: 'English', short: 'EN' }];
  function known(code) {
    for (var i = 0; i < LANGS.length; i++) if (LANGS[i].code === code) return code;
    return null;
  }
  /* The code for an <html lang> value, by its first subtag: pt-PT -> pt,
     zh-Hans -> zh. Anything unknown counts as English. */
  function codeOfLang(htmlLang) {
    var first = String(htmlLang || '').toLowerCase().split('-')[0];
    for (var i = 0; i < LANGS.length; i++) {
      if (LANGS[i].htmlLang.toLowerCase().split('-')[0] === first) return LANGS[i].code;
    }
    return 'en';
  }

  /* Which language does this visitor want? A code, or null when they
     have not chosen. The one place that decides it. */
  function wantedLanguage() {
    try { return known(localStorage.getItem('lang')); } catch (_) { return null; }
  }

  /* With no choice saved (a first visit), the browser's guess: go down
     its list of preferred languages and take the first the site has. The
     guess is not saved, so only a choice made in the settings menu sticks. */
  function browserLanguage() {
    var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
    for (var li = 0; li < list.length; li++) {
      var code = known(String(list[li]).toLowerCase().slice(0, 2));
      if (code) return code;
    }
    return 'en';
  }

  /* Path with any language prefix taken off: /pt/x/ -> /x/, /pt -> /. */
  function stripLang(path) {
    var m = /^\/([a-z]{2})(?=\/|$)/.exec(path);
    if (m && m[1] !== 'en' && known(m[1])) path = path.slice(m[0].length) || '/';
    return path;
  }
  /* The same path in another language: English has no prefix. */
  window.jjLangPath = function (path, lang) {
    path = stripLang(path);
    return lang === 'en' ? path : '/' + lang + (path === '/' ? '/' : path);
  };

  /* URL of this page in another language: EN /x/ <-> PT /pt/x/. Keeps
     the query and the hash. */
  window.jjLangUrl = function (lang) {
    return window.jjLangPath(location.pathname, lang) + location.search + location.hash;
  };

  var wanted = wantedLanguage();
  /* A page with no data-lang-mode is a raw dev page: it behaves like url
     mode. Error pages ("fetch") keep their URL, so they cannot redirect;
     the language script swaps their copy in place, and a first-time
     visitor gets the browser's guess there. */
  if (root.dataset.langMode === 'fetch') {
    window.jjLangWanted = wanted || browserLanguage();
  } else {
    /* The URL says the language. A saved choice that differs sends the
       visitor to the same page in that language. The browser's guess does
       not: a link to a page in one language opens in that language, for
       visitors and for search engines alike. */
    window.jjLangWanted = wanted;
    if (wanted && wanted !== codeOfLang(root.lang)) location.replace(window.jjLangUrl(wanted));
  }
  apply();

  /* Contrast and motion follow the system. */
  [sysContrast, sysMotion].forEach(function (m) {
    if (m.addEventListener) m.addEventListener('change', apply);
    else if (m.addListener) m.addListener(apply);
  });

  window.jjPrefs = {
    /* The visitor's saved choice (text size only). */
    get: function (key) { return pref[key]; },
    /* What is applied right now, including what the system asks for. */
    effective: effective,
    set: function (key, value) {
      if (!VALUES[key] || VALUES[key].indexOf(value) < 0) return;
      pref[key] = value;
      try { localStorage.setItem(key, value); } catch (_) {}
      apply();
    }
  };
})();
</script>

{umamiOn && (
  <script is:inline async defer data-website-id={umamiId} src={umamiSrc}></script>
)}
</head>
<body>

<a href="#main-content" class="skip-link" data-umami-event="skip-link" data-pt="Saltar para o conteúdo">Skip to content</a>

<nav class:list={['nav', { 'nav-dark': navDark }]} id="nav" {...(activePage === 'home' ? { 'data-cut-nav': '' } : {})}>
  <div class="container">
    <a href="/" class="logo-outer" aria-label="Home" data-pt-aria-label="Início">
      <span class="logo-bg"></span>
      {/* Inline copy of /assets/jj-logo.svg so the hover light pass can
          run along the strokes. .logo-pass paths are stroke centrelines,
          clipped to the mark by the mask. */}
      <svg class="logo-mark" viewBox="0 0 1080 1080" aria-hidden="true" focusable="false">
        <defs>
          <g id="jjLogoShape">
            <g transform="matrix(1.20499,0,0,1.20469,-1150.09,-2581.94)">
              <path d="M1468.5,2314.5C1439.63,2429.03 1365.6,2721.15 1340.63,2804.28C1299.23,2942.15 1221.67,2989.38 1144.62,2967.52C1076.63,2948.24 1029.01,2878.62 1064.42,2754.18C1071.3,2730.03 1096.48,2716.01 1120.62,2722.89C1144.76,2729.76 1158.78,2754.94 1151.9,2779.09C1143.99,2806.88 1141.6,2830.08 1144.94,2848.7C1147.87,2865.03 1156.11,2876.22 1169.43,2880C1186.93,2884.96 1201.96,2876.29 1215.43,2859.34C1230.49,2840.4 1243.01,2813.11 1253.52,2778.11C1284.56,2674.74 1391.99,2245.82 1391.99,2245.82C1395.13,2233.26 1403.23,2223.24 1413.67,2217.31C1427.34,2208.36 1445.39,2207.09 1460.66,2215.55C1460.66,2215.55 1529.91,2253.82 1599.98,2215.75C1622.04,2203.77 1649.67,2211.95 1661.65,2234.02C1673.62,2256.08 1665.44,2283.72 1643.39,2295.7C1577.48,2331.5 1512.03,2325.74 1468.5,2314.5Z"/>
              <path d="M1392.08,2879.85C1399.28,2869.7 1423.21,2833.42 1439.82,2778.11C1483.13,2633.9 1530.2,2440.99 1530.2,2440.99C1536.15,2416.6 1560.78,2401.63 1585.17,2407.59C1609.55,2413.54 1624.51,2438.17 1618.56,2462.56C1618.56,2462.56 1570.83,2658.11 1526.93,2804.28C1504.59,2878.69 1480.11,2921.48 1456.11,2945.35C1406.45,2994.74 1361.63,2963.16 1361.63,2963.16C1340.57,2949.52 1334.54,2921.33 1348.18,2900.26C1357.98,2885.11 1375.3,2877.73 1392.08,2879.85Z"/>
            </g>
            <g transform="matrix(1.20499,0,0,1.20469,-1229.74,-2381.85)">
              <path d="M1722.17,2773.11C1715.66,2797.35 1690.7,2811.76 1666.46,2805.26C1642.22,2798.75 1627.82,2773.79 1634.32,2749.54L1663.35,2641.27C1669.85,2617.02 1694.81,2602.61 1719.05,2609.12C1743.3,2615.62 1757.7,2640.58 1751.2,2664.83L1722.17,2773.11Z"/>
            </g>
          </g>
          <mask id="jjLogoMask" maskUnits="userSpaceOnUse" x="0" y="0" width="1080" height="1080">
            <use href="#jjLogoShape" fill="#fff"/>
          </mask>
        </defs>
        <use href="#jjLogoShape" fill="currentColor"/>
        <g mask="url(#jjLogoMask)">
          <g transform="matrix(1.20499,0,0,1.20469,-1150.09,-2581.94)">
            <path class="logo-pass logo-pass-1" pathLength="1" d="M1120,2715C1075,2850 1100,2912 1157,2924C1215,2938 1267,2895 1297,2791C1330,2680 1437,2256 1437,2256C1480,2285 1560,2305 1665,2232"/>
            <path class="logo-pass logo-pass-2" pathLength="1" d="M1587,2400C1574,2452 1527,2645 1483,2791C1455,2885 1420,2925 1335,2925"/>
          </g>
          <g transform="matrix(1.20499,0,0,1.20469,-1229.74,-2381.85)">
            <path class="logo-pass logo-pass-3" pathLength="1" d="M1721,2600L1664,2814"/>
          </g>
        </g>
      </svg>
    </a>

    <div class="pill-nav" id="pillNav">
      <div class="pill-indicator" id="pillIndicator"></div>
      <a href="/" data-page="home" class:list={[{ active: activePage === 'home' }]} data-pt="Início">Home</a>
      <a href="/about" data-page="about" class:list={[{ active: activePage === 'about' }]} data-pt="Sobre">About</a>
      <a href="/case-studies" data-page="cases" class:list={[{ active: activePage === 'cases' }]} data-pt="Trabalho">Work</a>
      <a href="/contact" data-page="contact" class:list={[{ active: activePage === 'contact' }]} data-pt="Contacto">Contact</a>
    </div>

    <div class="nav-right">
      {/* Settings menu: language and text size.
          One button at every width (it stays in the bar on phones,
          beside the menu button). The button shows the language in use
          so visitors looking for EN/PT still find it. Choices are saved
          and applied before paint by the settings script in <head>;
          the menu itself is wired in nav.js. */}
      <div class="settings" id="settings">
        <button class="settings-btn" id="settingsBtn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="settingsPanel" aria-label="Settings: language and text size" data-pt-aria-label="Definições: idioma e tamanho do texto" data-umami-event="settings-open">
