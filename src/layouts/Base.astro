/* ──────────────────────────────────────────────────────────────
 * Animated dot field for global-CTA cards.
 * - Constellation density biases toward the CTA button (denser
 *   near it, sparser far away). Inside-button bounds are excluded
 *   so the field "circumvents" the button.
 * - Mouse interaction ONLY fires while the cursor is over the
 *   card itself (mouseenter/leave gate).
 * - Scoped instance per .about-cta — pauses off-screen / when tab
 *   hidden / when reduced motion is requested.
 * ────────────────────────────────────────────────────────────── */
(function () {
  var wraps = document.querySelectorAll('.cta-footer-wrap');
  if (!wraps.length) return;
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  wraps.forEach(initCta);

  function initCta(wrap) {
    var canvas = wrap.querySelector('.cta-footer-bg');
    /* The "card" is the container holding the CTA buttons. .about-cta on
       the global outro, .contact-inner on the contact page (which reuses
       this same particle system on its own dark hero-fold). */
    var card   = wrap.querySelector('.about-cta, .contact-inner');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    if (!ctx) { canvas.style.display = 'none'; return; }

    var W = 0, H = 0, dpr = 1;
    var pts = [];
    var btnZone = null;
    var mouseX = -999, mouseY = -999, prevMX = 0, prevMY = 0, velX = 0, velY = 0;
    var mouseInside = false;
    var raf = 0, inView = true, tabVisible = true;
    var bgImage = null;   /* offscreen canvas with the dithered gradient */

    /* Resolve --dark to RGB once. The gradient START color is detected
       per-page from the section directly above the wrap, so the
       transition is invisible regardless of which page renders this. */
    function probeRGB(str) {
      var p = document.createElement('div');
      p.style.color = str;
      document.body.appendChild(p);
      var m = getComputedStyle(p).color.match(/[\d.]+/g);
      document.body.removeChild(p);
      return m ? [+m[0], +m[1], +m[2]] : [0, 0, 0];
    }
    var rootStyles = getComputedStyle(document.documentElement);
    var DARK   = probeRGB(rootStyles.getPropertyValue('--dark').trim()   || '#1C1A17');
    var BG_FALLBACK = probeRGB(rootStyles.getPropertyValue('--bg').trim() || '#ECEAE5');

    var isContactPage = wrap.classList.contains('contact');

    function detectAboveColor() {
      /* Contact page: hardcoded gradient. Top is a darker shade than
         --dark; by the time the gradient reaches the hero it's already
         at full --dark. No section-above detection here — just paint. */
      if (isContactPage) {
        var d = probeRGB(rootStyles.getPropertyValue('--dark').trim() || '#1C1A17');
        return [Math.max(0, d[0] - 14), Math.max(0, d[1] - 14), Math.max(0, d[2] - 14)];
      }
      /* Walk up the previousElementSibling chain looking for an element
         with an opaque background AND that's actually in the document
         flow (skip fixed/absolute helpers like .brands-tooltip — those
         are anchored elsewhere on the screen and aren't what visually
         sits above the wrap). Falls back to body bg if nothing matches. */
      var prev = wrap.previousElementSibling;
      while (prev) {
        var styles = getComputedStyle(prev);
        var pos = styles.position;
        var disp = styles.display;
        if (pos === 'fixed' || pos === 'absolute' || disp === 'none') {
          prev = prev.previousElementSibling;
          continue;
        }
        var bg = styles.backgroundColor;
        if (bg && bg !== 'transparent' && bg.indexOf('rgba(0, 0, 0, 0)') === -1) {
          var rgba = bg.match(/[\d.]+/g);
          if (rgba && rgba.length >= 3) {
            var alpha = rgba.length === 4 ? +rgba[3] : 1;
            if (alpha > 0.5) return [+rgba[0], +rgba[1], +rgba[2]];
          }
        }
        prev = prev.previousElementSibling;
      }
      var bodyBg = getComputedStyle(document.body).backgroundColor;
      var b = bodyBg.match(/[\d.]+/g);
      if (b && b.length >= 3) return [+b[0], +b[1], +b[2]];
      return BG_FALLBACK;
    }

    /* Cheap hash-based 2D value noise for low-frequency organic variation. */
    function hash2(ix, iy) {
      var s = Math.sin(ix * 127.1 + iy * 311.7) * 43758.5453;
      return s - Math.floor(s);
    }
    function vnoise2(x, y) {
      var ix = Math.floor(x), iy = Math.floor(y);
      var fx = x - ix, fy = y - iy;
      var u = fx * fx * (3 - 2 * fx);
      var v = fy * fy * (3 - 2 * fy);
      var a = hash2(ix,     iy);
      var b = hash2(ix + 1, iy);
      var c = hash2(ix,     iy + 1);
      var d = hash2(ix + 1, iy + 1);
      return (1 - u) * (1 - v) * a + u * (1 - v) * b
           + (1 - u) * v       * c + u * v       * d;
    }
    /* 3-octave FBM with per-octave rotation — breaks the axis-aligned
       grid pattern that single-octave value noise reveals on flat
       gradients. Result reads as cloud/fog texture, not pixelated cells.
       Returns roughly 0..1 (slightly compressed by octave decay). */
    function fbm2(x, y) {
      var v = 0, amp = 0.5;
      var c = 0.8660254, s = 0.5;     /* rotate ~30° per octave */
      for (var i = 0; i < 3; i++) {
        v += amp * vnoise2(x, y);
        var nx = (c * x - s * y) * 2.07;
        var ny = (s * x + c * y) * 2.07;
        x = nx; y = ny;
        amp *= 0.5;
      }
      return v;
    }

    /* Build a one-time offscreen canvas that paints the bg-alt → dark
       transition organically. Per-pixel: smoothstep ramp + low-frequency
       value noise (organic blobs) + per-pixel random dither (band killer).
       Painted into the main canvas once per frame as the background, so
       gradient banding is impossible (it's quantized after dither). */
    function buildBackground(w, h, dprIn) {
      var oc = document.createElement('canvas');
      var cw = Math.max(1, Math.floor(w * dprIn));
      var ch = Math.max(1, Math.floor(h * dprIn));
      oc.width = cw; oc.height = ch;
      var octx = oc.getContext('2d');
      var img = octx.createImageData(cw, ch);
      var data = img.data;
      /* Gradient zone: full canvas height for the outro wrap (so the top
         seamlessly meets the section above). On the contact page the
         gradient resolves quickly — by the time it reaches the hero the
         color is at full --dark, and everything below stays --dark. */
      var transition = isContactPage ? ch * 0.32 : ch;
      var nScale = 0.018 / dprIn;          /* low-freq noise frequency */
      /* Pick the gradient START color to match the section directly above
         the wrap on this page — invisible transition regardless of page. */
      var ABOVE = detectAboveColor();
      var dr = DARK[0] - ABOVE[0], dg = DARK[1] - ABOVE[1], db = DARK[2] - ABOVE[2];
      /* Fade the noise/dither in over the first ~100 physical pixels so
         the seam zone is pure flat color identical to the section above,
         and noise only appears once the gradient has visibly moved away
         from the start color. */
      var noiseFadeEnd = 100 * dprIn;
      for (var y = 0; y < ch; y++) {
        var t  = Math.min(1, y / transition);
        var tt = t * t * (3 - 2 * t);     /* smoothstep ramp */
        var rb = ABOVE[0] + dr * tt;
        var gb = ABOVE[1] + dg * tt;
        var bb = ABOVE[2] + db * tt;
        var nAtt = Math.min(1, y / noiseFadeEnd);
        var nAtt2 = nAtt * nAtt * (3 - 2 * nAtt);  /* smoothstep the fade-in too */
        for (var x = 0; x < cw; x++) {
          /* Multi-octave fog — subtler than a single octave and grid-free. */
          var n = (fbm2(x * nScale, y * nScale) - 0.45) * 3.2 * nAtt2;
          /* Per-pixel random dither — crushes the remaining 8-bit steps. */
          var jitter = (Math.random() - 0.5) * 3.5 * nAtt2;
          var off = n + jitter;
          var idx = (y * cw + x) * 4;
          data[idx]     = rb + off;
          data[idx + 1] = gb + off;
          data[idx + 2] = bb + off;
          data[idx + 3] = 255;
        }
      }
      octx.putImageData(img, 0, 0);
      return oc;
    }

    function measureButton(which) {
      /* `which` is 'chat' (Get in touch / .btn-accent) or 'video'
         (Book a call / .btn-dark-outline). Falls back to the first
         .btn so the initial generate() call still works. */
      var sel = which === 'video' ? '.btn-dark-outline'
              : which === 'chat'  ? '.btn-accent'
              : '.btn';
      var btn = card && card.querySelector(sel);
      if (!btn) return null;
      var wrapR = wrap.getBoundingClientRect();
      var btnR  = btn.getBoundingClientRect();
      var pad = 14;
      return {
        cx: btnR.left - wrapR.left + btnR.width  / 2,
        cy: btnR.top  - wrapR.top  + btnR.height / 2,
        hw: btnR.width  / 2 + pad,
        hh: btnR.height / 2 + pad
      };
    }

    function inButton(x, y, b) {
      return Math.abs(x - b.cx) < b.hw && Math.abs(y - b.cy) < b.hh;
    }

    /* Material Symbols paths — same icons the CTA buttons use. */
    var MAT_CHAT = 'M80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z';
    var MAT_VIDEO = 'M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h480q33 0 56.5 23.5T720-720v180l160-160v440L720-420v180q0 33-23.5 56.5T640-160H160Zm0-80h480v-480H160v480Zm0 0v-480 480Z';
    function samplePath(pathData, size) {
      var oc = document.createElement('canvas');
      oc.width = oc.height = Math.ceil(size);
      var octx = oc.getContext('2d');
      octx.save();
      octx.fillStyle = '#fff';
      /* Material viewBox is 0 -960 960 960 — translate Y origin so the icon
         lands inside positive canvas coordinates after the scale. */
      octx.translate(0, size);
      octx.scale(size / 960, size / 960);
      octx.fill(new Path2D(pathData), 'evenodd');
      octx.restore();
      var data = octx.getImageData(0, 0, oc.width, oc.height).data;
      var out = [];
      for (var y = 0; y < oc.height; y += 2) {
        for (var x = 0; x < oc.width; x += 2) {
          if (data[(y * oc.width + x) * 4 + 3] > 60) {
            out.push([x - oc.width / 2, y - oc.height / 2]);
          }
        }
      }
      return out;
    }

    function generate() {
      pts = [];
      var w = canvas.offsetWidth, h = canvas.offsetHeight;
      if (w === 0 || h === 0) return;
      btnZone = measureButton();
      var diag = Math.sqrt(w * w + h * h);
      /* Density: full-width wrap is much larger than the old card, so a
         lower density keeps the resting field calm. */
      var target = Math.round((w * h) / 4200);
      /* Sample both formations sized to the .about-cta region (NOT the full
         wrap), since that's where the icon should converge. */
      var cardH = card ? card.getBoundingClientRect().height : h;
      var iconSize = Math.min(w * 0.30, cardH * 0.95);
      var chatPts  = samplePath(MAT_CHAT,  iconSize);
      var videoPts = samplePath(MAT_VIDEO, iconSize);
      /* Center the icon over the card's actual position within the wrap,
         not over the wrap's middle (which would land in the footer). */
      var wcx = w / 2, wcy = h / 2;
      if (card) {
        var wrapR = wrap.getBoundingClientRect();
        var cardR = card.getBoundingClientRect();
        wcx = cardR.left - wrapR.left + cardR.width  / 2;
        wcy = cardR.top  - wrapR.top  + cardR.height / 2;
      }
      var attempts = 0, maxAttempts = target * 25;
      while (pts.length < target && attempts < maxAttempts) {
        attempts++;
        var x = Math.random() * w;
        var y = Math.random() * h;
        if (btnZone && inButton(x, y, btnZone)) continue;
        /* Density bias: closer to button → higher acceptance probability,
           so the field clusters around the button and thins out toward edges. */
        if (btnZone) {
          var dx = x - btnZone.cx, dy = y - btnZone.cy;
          var d  = Math.sqrt(dx * dx + dy * dy);
          var p  = 1 - (d / diag);          /* 1 near, 0 at far diagonal */
          if (Math.random() > p * 1.4) continue;
        }
        var cp = chatPts.length  ? chatPts[Math.floor(Math.random()  * chatPts.length)]  : null;
        var vp = videoPts.length ? videoPts[Math.floor(Math.random() * videoPts.length)] : null;
        pts.push({
          x: x, y: y, ox: x, oy: y, vx: 0, vy: 0,
          tw: Math.random() * Math.PI * 2,
          ts: 0.012 + Math.random() * 0.022,
          /* Per-particle ambient drift — wider lissajous orbit, slower
             phase advance so peak instantaneous velocity stays similar. */
          dPhX: Math.random() * Math.PI * 2,
          dPhY: Math.random() * Math.PI * 2,
          dSpX: 0.0005 + Math.random() * 0.0012,
          dSpY: 0.0005 + Math.random() * 0.0012,
          dAmp: 10 + Math.random() * 22,
          /* Per-shape targets — chosen on hover by which button is hovered. */
          chatX:  cp ? wcx + cp[0] : null, chatY:  cp ? wcy + cp[1] : null,
          videoX: vp ? wcx + vp[0] : null, videoY: vp ? wcy + vp[1] : null,
          r:  0.7 + Math.random() * 1.2
        });
      }
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      var w = wrap.clientWidth, h = wrap.clientHeight;
      W = Math.max(1, Math.floor(w * dpr));
      H = Math.max(1, Math.floor(h * dpr));
      canvas.width = W; canvas.height = H;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      bgImage = buildBackground(w, h, dpr);
      generate();
    }

    /* Mouse scatter listens on the entire dark wrap, so the cursor
       interacts with particles anywhere in the section (including
       the footer area). */
    wrap.addEventListener('mouseenter', function () { mouseInside = true; });
    wrap.addEventListener('mouseleave', function () {
      mouseInside = false;
      mouseX = mouseY = -999;
      velX = velY = 0;
    });
    wrap.addEventListener('mousemove', function (e) {
      var r = wrap.getBoundingClientRect();
      var nx = e.clientX - r.left, ny = e.clientY - r.top;
      velX = nx - prevMX; velY = ny - prevMY;
      prevMX = nx; prevMY = ny;
      mouseX = nx; mouseY = ny;
    });

    /* Button-hover state: particles turn accent-colored and form whichever
       icon matches the hovered button. Eased in/out via a 0..1 progress lerp. */
    var btnHover = false;
    var activeShape = 'chat';   /* 'chat' for Get in touch, 'video' for Book a call */
    var hoverProg = 0;
    var primaryBtn   = card && card.querySelector('.btn-accent');
    var secondaryBtn = card && card.querySelector('.btn-dark-outline');
    var hoverStart = 0;
    if (primaryBtn) {
      primaryBtn.addEventListener('mouseenter', function () {
        btnHover = true; activeShape = 'chat';
        hoverStart = performance.now();
        loop();
      });
      primaryBtn.addEventListener('mouseleave', function () { btnHover = false; hoverStart = 0; loop(); });
    }
    if (secondaryBtn) {
      secondaryBtn.addEventListener('mouseenter', function () {
        btnHover = true; activeShape = 'video';
        hoverStart = performance.now();
        loop();
      });
      secondaryBtn.addEventListener('mouseleave', function () { btnHover = false; hoverStart = 0; loop(); });
    }

    var IR = 130;
    function frame() {
      raf = 0;
      var w = canvas.offsetWidth, h = canvas.offsetHeight;
      /* Paint the dithered organic gradient as the background each frame.
         drawImage from a pre-built offscreen canvas → cheap (GPU-accel). */
      if (bgImage) {
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.drawImage(bgImage, 0, 0);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      } else {
        ctx.clearRect(0, 0, w, h);
      }

      var spd = mouseInside ? Math.min(Math.sqrt(velX * velX + velY * velY), 30) : 0;

      /* Very slow ease in/out (~7.5s rise time) so the gravitation reads
         as deliberate atmosphere, not a snap. */
      hoverProg += ((btnHover ? 1 : 0) - hoverProg) * 0.005;

      /* After 10 seconds of continuous hover, particles in the inner pull
         zone enter an agitation phase: each randomly alternates between
         being engulfed (sucked into the button) and jittering in place. */
      var now = performance.now();
      var agitationActive = btnHover && hoverStart && (now - hoverStart) > 10000;

      /* Re-measure the *currently hovered* button each frame. Particles
         gravitate toward whichever CTA is hovered, not always Get in touch. */
      if (btnHover && hoverProg > 0.01) btnZone = measureButton(activeShape);

      for (var i = 0; i < pts.length; i++) {
        var p = pts[i];

        /* Ambient drift — gentle lissajous orbit around the seed position. */
        p.dPhX += p.dSpX; p.dPhY += p.dSpY;
        var driftX = Math.cos(p.dPhX) * p.dAmp;
        var driftY = Math.sin(p.dPhY) * p.dAmp;

        /* Target: rest position + drift. When a CTA is hovered, particles
           within 1000px of the button gravitate toward it with strength
           that falls off with distance. Beyond the radius, particles
           continue drifting normally and don't change color. */
        var tx = p.ox + driftX;
        var ty = p.oy + driftY;
        var pull = 0;
        if (hoverProg > 0.001 && btnZone) {
          var ddx = p.ox - btnZone.cx, ddy = p.oy - btnZone.cy;
          var dToBtn = Math.sqrt(ddx * ddx + ddy * ddy);
          if (dToBtn < 1000) {
            pull = (1 - dToBtn / 1000) * hoverProg;
            tx = (p.ox + driftX) + (btnZone.cx - (p.ox + driftX)) * pull;
            ty = (p.oy + driftY) + (btnZone.cy - (p.oy + driftY)) * pull;
          }
        }

        /* Spring toward target — very slow gravitation so particles
           drift toward the button rather than snap. Heavier damping
           keeps the velocity from overshooting on long pulls. */
        p.vx = (p.vx + (tx - p.x) * 0.0035) * 0.94;
        p.vy = (p.vy + (ty - p.y) * 0.0035) * 0.94;

        /* After 10s of hover, close particles randomly engulf or agitate.
           Each one re-rolls its mode every ~1.6s so the field looks alive,
           with some particles being sucked in and others vibrating. */
        if (agitationActive && pull > 0.4 && btnZone) {
          if (!p.agitAt || (now - p.agitAt) > 1600) {
            p.agitMode = Math.random() < 0.5 ? 1 : 0;  /* 1 = engulf, 0 = agitate */
            p.agitAt = now;
          }
          if (p.agitMode === 1) {
            /* Engulf — extra acceleration toward button center on top
               of the regular pull, so they accelerate inward fast. */
            p.vx += (btnZone.cx - p.x) * 0.012;
            p.vy += (btnZone.cy - p.y) * 0.012;
          } else {
            /* Agitate — random jitter, scaled by pull so closer particles
               vibrate harder. Weight toward perpendicular-to-pull for
               visual "shake". */
            p.vx += (Math.random() - 0.5) * 1.4 * pull;
            p.vy += (Math.random() - 0.5) * 1.4 * pull;
          }
        }

        /* Cursor scatter — only while mouse is inside the card AND not hovering CTA. */
        if (mouseInside && spd > 1 && hoverProg < 0.5) {
          var dx = p.x - mouseX, dy = p.y - mouseY;
          var d2 = dx * dx + dy * dy;
          if (d2 < IR * IR && d2 > 0.1) {
            var d  = Math.sqrt(d2);
            var fo = 1 - d / IR;
            p.vx += (dx / d) * fo * fo * spd * 0.06;
            p.vy += (dy / d) * fo * fo * spd * 0.06;
          }
        }
        p.x += p.vx; p.y += p.vy;
        /* Don't let particles cross into the button's footprint —
           push them back to the nearest button edge if they do.
           Stops the field from rendering "behind" the button. */
        if (btnZone) {
          var bdx = p.x - btnZone.cx, bdy = p.y - btnZone.cy;
          if (Math.abs(bdx) < btnZone.hw && Math.abs(bdy) < btnZone.hh) {
            var overX = btnZone.hw - Math.abs(bdx);
            var overY = btnZone.hh - Math.abs(bdy);
            if (overX < overY) {
              p.x += (bdx >= 0 ? overX : -overX);
              p.vx *= -0.3;
            } else {
              p.y += (bdy >= 0 ? overY : -overY);
              p.vy *= -0.3;
            }
          }
        }
        /* Particles fully absorbed (touching the button edge while pulled
           hard) respawn at a random wrap edge — keeps the field populated
           when the user holds hover for a long time. */
        if (btnZone && pull > 0.85) {
          var edge = Math.floor(Math.random() * 4);
          if (edge === 0)      { p.ox = Math.random() * w; p.oy = -10; }
          else if (edge === 1) { p.ox = w + 10;            p.oy = Math.random() * h; }
          else if (edge === 2) { p.ox = Math.random() * w; p.oy = h + 10; }
          else                 { p.ox = -10;               p.oy = Math.random() * h; }
          p.x = p.ox; p.y = p.oy;
          p.vx = p.vy = 0;
        }
        p.tw += p.ts;
        /* Base twinkle alpha; pulled particles also brighten. */
        var a = 0.18 + 0.16 * (Math.sin(p.tw) * 0.5 + 0.5) + pull * 0.30;
        if (a > 1) a = 1;
        /* Per-particle color lerp by `pull`: only particles inside the
           1000px radius shift toward the active CTA's color. Active color
           is primary accent for chat (Get in touch), neutral warm grey
           for video (Book a call). */
        var tcr, tcg, tcb;
        if (activeShape === 'video') { tcr = 200; tcg = 195; tcb = 188; }
        else                          { tcr =  61; tcg =  61; tcb = 181; }
        var cr = Math.round(240 + (tcr - 240) * pull);
        var cg = Math.round(237 + (tcg - 237) * pull);
        var cb = Math.round(232 + (tcb - 232) * pull);
        /* Particles inside the radius also grow slightly while drawn in. */
        var rr = p.r * (1 + pull * 0.4);
        ctx.fillStyle = 'rgba(' + cr + ',' + cg + ',' + cb + ',' + a + ')';
        if (pull > 0.02 && btnZone) {
          /* Stretch each pulled particle into a comet-like ellipse oriented
             toward the button. Stretch grows with pull so particles closer
             to the button visibly elongate along the pull direction. */
          var pdx = btnZone.cx - p.x, pdy = btnZone.cy - p.y;
          var ang = Math.atan2(pdy, pdx);
          var stretch = 1 + pull * 1.3;
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(ang);
          ctx.beginPath();
          ctx.ellipse(0, 0, rr * stretch, rr, 0, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        } else {
          ctx.beginPath();
          ctx.arc(p.x, p.y, rr, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      velX *= 0.7; velY *= 0.7;
      if (inView && tabVisible && !reduced) raf = requestAnimationFrame(frame);
    }

    function loop() { if (!raf && !reduced) raf = requestAnimationFrame(frame); }

    var resizeTimer;
    var ro = window.ResizeObserver
      ? new ResizeObserver(function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(resize, 80);
        })
      : null;
    if (ro) ro.observe(wrap);
    else window.addEventListener('resize', function () {
      clearTimeout(resizeTimer); resizeTimer = setTimeout(resize, 80);
    });

    document.addEventListener('visibilitychange', function () {
      tabVisible = document.visibilityState === 'visible';
      if (tabVisible) loop();
    });
    if (window.IntersectionObserver) {
      new IntersectionObserver(function (es) {
        inView = es[0].isIntersecting;
        if (inView) loop();
      }, { threshold: 0 }).observe(wrap);
    }

    /* Defer first measure until layout settles + the wrap is actually sized. */
    requestAnimationFrame(function () { resize(); loop(); });
  }
})();
</script>

</body>
</html>
