<script is:inline>
/* Language switch.
   The visitor picks the language in the settings menu in the nav and the
   page changes in place, with no reload: this script fetches the page in
   the new language, and swaps its text, attributes and links into the one
   on screen.

   Every built page carries all of it: the elements whose text or
   attributes differ by language are stamped data-i18n="tN" (the same id
   in every language), data-i18n-t="" when their inner HTML is language
   dependent and data-i18n-a="aria-label title …" for attributes. A few
   fixed ids cover <html lang>, the canonical link, og:url and og:locale,
   and the settings button's short code (data-lang-short).
   In `astro dev` the English page is raw (data-pt in the source, nothing
   stamped), so stamp() applies the build's rule to a document itself,
   live or fetched. Same code path in dev and production.

   Markup that scripts add later (the compose modal) is not stamped. It
   keeps the old way: English with data-pt="…" / data-pt-<attr>="…",
   registered here and refreshed with window.jjLangRefresh(container).
   Other languages read window.jjUi, a { english: translation } table
   from the #jj-ui JSON block in the page, keyed by keyOf(english).

   Other scripts can use:
     window.jjLang()            the code of the page's language ("en", "pt", …)
     window.jjT(en, pt)         the text a script writes itself, in that language
     window.jjLangRefresh(el)   after adding markup with data-pt
     window.jjLangPrefetch(c)   warm the cache for a language
     document "jj:langchange"   { lang } once the swap is done.
   This runs before the deferred scripts, so nav.js measures the nav with
   the final labels. */
(function () {
  var root = document.documentElement;
  var LANGS = window.jjLangs || [{ code: 'en', htmlLang: 'en-US', label: 'English', short: 'EN' }];
  var PFX = 'data-pt-';
  window.jjUi = {};

  function byCode(code) {
    for (var i = 0; i < LANGS.length; i++) if (LANGS[i].code === code) return LANGS[i];
    return null;
  }
  function codeOfLang(htmlLang) {
    var first = String(htmlLang || '').toLowerCase().split('-')[0];
    for (var i = 0; i < LANGS.length; i++) {
      if (LANGS[i].htmlLang.toLowerCase().split('-')[0] === first) return LANGS[i].code;
    }
    return 'en';
  }
  function current() { return codeOfLang(root.lang); }
  /* The dictionary key for an English string (same as keyOf() in
     src/i18n/languages.mjs): whitespace collapsed and trimmed. */
  function keyOf(s) { return String(s).replace(/\s+/g, ' ').trim(); }
  function mode() { return root.dataset.langMode === 'fetch' ? 'fetch' : 'url'; }

  /* ---------- stamping ---------- */

  /* Give every element that has data-pt or data-pt-<attr> an id and a
     list of what differs, in document order, the way the build does (the
     ids must be the same in a live page and a fetched one). Works on a
     DOMParser document. A page that is already stamped is left alone. */
  function stamp(doc) {
    if (doc.querySelector('[data-i18n]')) return;
    var n = 0;
    function walk(scope) {
      var els = scope.querySelectorAll('*');
      for (var i = 0; i < els.length; i++) {
        var el = els[i], names = [];
        for (var j = 0; j < el.attributes.length; j++) {
          var an = el.attributes[j].name;
          if (an.indexOf(PFX) === 0) names.push(an.slice(PFX.length));
        }
        var text = el.hasAttribute('data-pt');
        if (text || names.length) {
          el.setAttribute('data-i18n', 't' + n++);
          if (text) el.setAttribute('data-i18n-t', '');
          if (names.length) el.setAttribute('data-i18n-a', names.join(' '));
        }
        if (el.tagName === 'TEMPLATE' && el.content) walk(el.content);
      }
    }
    walk(doc);
    function fixed(el, id, attr) {
      if (!el) return;
      el.setAttribute('data-i18n', id);
      if (attr) el.setAttribute('data-i18n-a', attr); else el.setAttribute('data-i18n-t', '');
    }
    fixed(doc.documentElement, 'html', 'lang');
    fixed(doc.querySelector('link[rel="canonical"]'), 'canonical', 'href');
    fixed(doc.querySelector('meta[property="og:url"]'), 'ogurl', 'content');
    fixed(doc.querySelector('meta[property="og:locale"]'), 'oglocale', 'content');
    fixed(doc.querySelector('[data-lang-short]'), 'short', '');
  }
  stamp(document);

  /* ---------- text that scripts write ---------- */

  function readUi(doc) {
    var el = doc.getElementById('jj-ui'), out = {};
    if (el) { try { out = JSON.parse(el.textContent) || {}; } catch (_) {} }
    return out;
  }
  window.jjUi = readUi(document);

  function trans(en, lang) {
    if (lang === 'en') return en;
    var v = window.jjUi && window.jjUi[keyOf(en)];
    if (!v) return en;
    /* The key ignores the spaces around the text ("Date: "); keep them. */
    return /^\s*/.exec(en)[0] + String(v).replace(/^\s+|\s+$/g, '') + /\s*$/.exec(en)[0];
  }
  /* The text a script writes itself: English, Portuguese (written beside
     it), or the translation from the page's jj-ui table. */
  window.jjT = function (en, pt) {
    var lang = current();
    if (lang === 'pt') return pt === undefined ? en : pt;
    return trans(en, lang);
  };

  /* ---------- markup that scripts add later ---------- */

  var texts = [];   /* [el, enHTML, ptHTML] */
  var attrs = [];   /* [el, name, enValue, ptValue] */

  /* Record the English and Portuguese versions of every opted-in element
     under scope that the build did not stamp. Elements already recorded
     are skipped. */
  function register(scope) {
    var found = { texts: [], attrs: [] };
    var els = Array.prototype.slice.call(scope.querySelectorAll('*'));
    if (scope.nodeType === 1) els.unshift(scope);
    els.forEach(function (el) {
      if (el.__jjLang) return;
      el.__jjLang = true;
      /* Stamped (a carrier itself, or inside a text carrier whose HTML the
         swap replaces): the swap handles it. <html> is stamped too, but
         only for its lang attribute, so it does not count as a parent. */
      if (el.hasAttribute('data-i18n') || (el.closest && el.closest('[data-i18n-t]'))) return;
      if (el.hasAttribute('data-pt')) found.texts.push([el, el.innerHTML, el.getAttribute('data-pt')]);
      for (var i = 0; i < el.attributes.length; i++) {
        var a = el.attributes[i];
        if (a.name.indexOf(PFX) === 0) {
          var name = a.name.slice(PFX.length);
          found.attrs.push([el, name, el.getAttribute(name), a.value]);
        }
      }
    });
    texts = texts.concat(found.texts);
    attrs = attrs.concat(found.attrs);
    return found;
  }
  register(document);

  function applyRuntime(lang, only) {
    var t = only ? only.texts : texts, a = only ? only.attrs : attrs;
    if (!only) {
      /* Drop what the page no longer holds (a swap can replace a
         container's contents). */
      texts = t = t.filter(function (x) { return x[0].isConnected; });
      attrs = a = a.filter(function (x) { return x[0].isConnected; });
    }
    t.forEach(function (x) {
      x[0].innerHTML = lang === 'en' ? x[1] : lang === 'pt' ? x[2] : trans(x[1], lang);
      /* text-hover.js splits some labels into per-character spans;
         have it redo the split on the new text. */
      if (x[0].dataset.scDone) {
        delete x[0].dataset.scDone;
        if (window.jjWrapChars) window.jjWrapChars(x[0]);
      }
    });
    a.forEach(function (x) {
      var v = lang === 'en' ? x[2] : lang === 'pt' ? x[3] : (x[2] === null ? null : trans(x[2], lang));
      if (v === null) x[0].removeAttribute(x[1]); else x[0].setAttribute(x[1], v);
    });
  }

  /* ---------- the swap ---------- */

  var docs = {};        /* lang + path -> Promise of a parsed, stamped document */
  var token = 0;        /* the latest pick wins */

  function pageUrl(lang) {
    if (mode() === 'fetch') {
      var src = root.getAttribute('data-lang-src') || '/';
      return lang === 'en' ? src : '/' + lang + src;
    }
    return window.jjLangPath(location.pathname, lang) + location.search;
  }
  function fetchDoc(lang) {
    var url = pageUrl(lang), key = lang + '|' + url;
    if (!docs[key]) {
      docs[key] = fetch(url, { credentials: 'same-origin' }).then(function (res) {
        if (!res.ok) throw new Error('status ' + res.status);
        return res.text();
      }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        stamp(doc);
        return doc;
      });
      docs[key].catch(function () { delete docs[key]; });
    }
    return docs[key];
  }
  window.jjLangPrefetch = function (lang) {
    if (!byCode(lang) || lang === current()) return;
    fetchDoc(lang).catch(function () {});
  };

  /* Links that stay on the site follow the language: /about -> /de/about. */
  function relink(lang) {
    var links = document.querySelectorAll('a[href]');
    for (var i = 0; i < links.length; i++) {
      var h = links[i].getAttribute('href');
      if (h.charAt(0) !== '/' || h.charAt(1) === '/') continue;
      var m = /^([^?#]*)(.*)$/.exec(h), path = m[1];
      var segs = path.split('/').filter(Boolean);
      if (segs.length && segs[segs.length - 1].indexOf('.') > -1) continue;
      var next = window.jjLangPath(path, lang) + m[2];
      if (next !== h) links[i].setAttribute('href', next);
    }
  }

  /* The settings button shows the code, the picker the name and flag. */
  function syncPicker(lang) {
    var info = byCode(lang) || LANGS[0];
    var shorts = document.querySelectorAll('[data-lang-short]');
    for (var i = 0; i < shorts.length; i++) shorts[i].textContent = info.short;
    var radio = document.querySelector('input[name="jj-lang"][value="' + info.code + '"]');
    if (radio) radio.checked = true;
    var cur = document.querySelector('.lang-picker-cur');
    if (cur && radio) {
      var row = radio.nextElementSibling;
      var flag = row && row.querySelector('.settings-flag');
      var oldFlag = cur.querySelector('.settings-flag');
      if (flag && oldFlag) oldFlag.innerHTML = flag.innerHTML;
      var name = cur.querySelector('.lang-picker-name');
      if (name) { name.textContent = info.label; name.setAttribute('lang', info.htmlLang); }
    }
  }
  window.jjLangPickerSync = function () { syncPicker(current()); };

  /* Copy one language's page onto the live one. */
  function applyDoc(doc, lang) {
    var byId = {};
    var theirs = doc.querySelectorAll('[data-i18n]');
    for (var i = 0; i < theirs.length; i++) byId[theirs[i].getAttribute('data-i18n')] = theirs[i];

    var ours = Array.prototype.slice.call(document.querySelectorAll('[data-i18n]'));
    ours.forEach(function (el) {
      if (!el.isConnected) return;     /* inside text that was just replaced */
      var src = byId[el.getAttribute('data-i18n')];
      if (!src) return;
      (src.getAttribute('data-i18n-a') || '').split(' ').forEach(function (n) {
        if (!n) return;
        var v = src.getAttribute(n);
        if (v === null) el.removeAttribute(n);
        else if (el.getAttribute(n) !== v) el.setAttribute(n, v);
      });
      if (src.hasAttribute('data-i18n-t')) {
        var tag = el.tagName;
        if (tag === 'SCRIPT' || tag === 'TITLE') {
          if (el.textContent !== src.textContent) el.textContent = src.textContent;
        } else if (el.innerHTML !== src.innerHTML) {
          el.innerHTML = src.innerHTML;
          /* text-hover.js's per-character split went with the old text. */
          if (el.dataset.scDone) {
            delete el.dataset.scDone;
            if (window.jjWrapChars) window.jjWrapChars(el);
          }
        }
      }
    });
    root.lang = (byCode(lang) || LANGS[0]).htmlLang;
    window.jjUi = readUi(doc);
    relink(lang);
    applyRuntime(lang);
    syncPicker(lang);
  }

  /* The first stamped text element on screen, and where it sits, so the
     page can be put back where the visitor was reading. */
  function anchor() {
    var els = document.querySelectorAll('[data-i18n-t]');
    for (var i = 0; i < els.length; i++) {
      var r = els[i].getBoundingClientRect();
      if (r.height > 0 && r.width > 0 && r.top >= 0 && r.top < window.innerHeight) {
        return { id: els[i].getAttribute('data-i18n'), top: r.top };
      }
    }
    return null;
  }
  function restore(a) {
    if (!a) return;
    var el = document.querySelector('[data-i18n="' + a.id + '"]');
    if (!el) return;
    var d = el.getBoundingClientRect().top - a.top;
    /* "instant" beats any scroll-behavior: smooth on the page. */
    if (Math.abs(d) > 1) window.scrollTo({ top: window.scrollY + d, left: window.scrollX, behavior: 'instant' });
  }

  /* opts.boot: an error page showing its language on load, with no
     transition and no scroll to keep. */
  function switchTo(lang, opts) {
    var boot = !!(opts && opts.boot);
    var my = ++token;
    fetchDoc(lang).then(function (doc) {
      if (my !== token) return;
      function update() {
        var a = boot ? null : anchor();
        applyDoc(doc, lang);
        if (mode() === 'url') {
          try { history.replaceState(history.state, '', window.jjLangUrl(lang)); } catch (_) {}
        }
        /* Label widths changed: let nav.js re-place the pill indicator. */
        window.dispatchEvent(new Event('resize'));
        document.dispatchEvent(new CustomEvent('jj:langchange', { detail: { lang: lang } }));
        restore(a);
      }
      var motion = window.jjPrefs && window.jjPrefs.effective().motion;
      if (!boot && document.startViewTransition && motion !== 'reduce') {
        /* A short crossfade of the whole page (timing in global.css). */
        root.classList.add('jj-lang-swap');
        var vt = null;
        try { vt = document.startViewTransition(update); } catch (_) {}
        if (vt) {
          var clear = function () { root.classList.remove('jj-lang-swap'); };
          vt.finished.then(clear, clear);
          vt.ready.catch(function () {});
          vt.updateCallbackDone.catch(function () { fail(lang); });
          return;
        }
        root.classList.remove('jj-lang-swap');
      }
      update();
    }).catch(function () { if (my === token) fail(lang); });
  }
  /* No page to swap in (offline, missing): the old way, a full load.
     Error pages have no other URL to go to, so they stay as they are. */
  function fail(lang) {
    if (mode() === 'url') location.assign(window.jjLangUrl(lang));
  }

  window.jjLang = current;
  /* For markup a script adds after load (English, with data-pt): call
     window.jjLangRefresh(container) once it is in the page. */
  window.jjLangRefresh = function (scope) {
    var found = register(scope || document);
    var lang = current();
    if (lang !== 'en') applyRuntime(lang, found);
  };
  window.jjSetLang = function (lang) {
    if (!byCode(lang)) return;
    try { localStorage.setItem('lang', lang); } catch (_) {}
    if (lang === current()) { token++; syncPicker(lang); return; }
    switchTo(lang, null);
  };

  syncPicker(current());

  /* An error page keeps its URL, so it cannot be sent to /pt/…: it
     shows the language the visitor wants right away. (Pages in url mode
     were already redirected by the script in <head>.) */
  if (mode() === 'fetch' && window.jjLangWanted && window.jjLangWanted !== current()) {
    switchTo(window.jjLangWanted, { boot: true });
  }
})();
</script>

<script is:inline src={versioned('/scripts/nav.js')} defer></script>
<script is:inline src={versioned('/scripts/text-hover.js')} defer></script>
<script is:inline src={versioned('/scripts/card-light.js')} defer></script>
<script is:inline src={versioned('/scripts/compose-modal.js')} defer></script>
{/* The field at the top of the page and in the bottom contact areas. The
    home page loads it itself, next to the hero scripts, so the intro finds
    HeroSpace in order. */}
{!isHome && (showCta || showFooter || !disablePageParticles) &&<script is:inline src={versioned('/scripts/hero-space.js')} defer></script>}

<script>
  /* Retune visual-editing overlay — dev only. The branch is dead-code
     eliminated in prod by Vite's `import.meta.env.DEV` replacement, so
     React/Retune are not bundled into the production output. */
  if (import.meta.env.DEV) {
    const [{ Retune }, React, { createRoot }] = await Promise.all([
      import('retune'),
      import('react'),
      import('react-dom/client'),
    ]);
    const root = document.getElementById('retune-root');
    if (root) createRoot(root).render(React.createElement(Retune));
  }
</script>

<script is:inline>
/* Open the compose modal on the chat tab with a prefilled message, then
   focus the name field. Uses only the public window.openComposeModal. */
window.jjComposeWith = function (message) {
  if (typeof window.openComposeModal !== 'function') return;
  window.openComposeModal(0);
  var tries = 0;
  (function fill() {
    var body = document.getElementById('chat-body');
    if (body) {
      body.value = message;
      body.dispatchEvent(new Event('input', { bubbles: true }));
      var name = document.getElementById('user-name');
      if (name) name.focus();
    } else if (tries++ < 20) {
      setTimeout(fill, 50);
    }
  })();
};
</script>

</body>
