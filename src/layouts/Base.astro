                  'Engagement: ' + engagement, 'Budget: ' + budget,
                  'Timeline: ' + timeline,
                  context ? '\nProject details:\n' + context : null,
                  links ? '\nRelevant links:\n' + links : null].filter(function (l) { return l !== null; }).join('\n')
      };
    }
    var bodyEl = document.getElementById('chat-body');
