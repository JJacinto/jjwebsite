---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /* Portuguese versions, used when the visitor switches to PT. */
  titlePt?: string;
  descriptionPt?: string;
  activePage?: 'home' | 'about' | 'cases' | 'contact';
  navDark?: boolean;
  showFooter?: boolean;
  showCta?: boolean;
  /* Disable the page-wide particle overlay above the fold. Set true
     on pages that already paint their own particle field in the hero
     (contact, error pages) to avoid doubling up. */
  disablePageParticles?: boolean;
}

const {
  title = 'João Jacinto — Senior Product Designer',
  description = 'João Jacinto — Senior Product Designer based in Aveiro, Portugal. 10+ years designing digital products with startups and enterprises.',
  titlePt = 'João Jacinto — Senior Product Designer',
  descriptionPt = 'João Jacinto — Senior Product Designer em Aveiro, Portugal. Mais de 10 anos a desenhar produtos digitais com startups e grandes empresas.',
  activePage = 'home',
  navDark = false,
  showFooter = true,
  showCta = true,
  disablePageParticles = false,
} = Astro.props;

const siteUrl     = 'https://joaojacinto.com';
const canonical   = new URL(Astro.url.pathname, siteUrl).href;
const ogImage     = `${siteUrl}/assets/og-image.png`;
const isHome      = activePage === 'home';

/* Umami analytics — privacy-friendly, no cookies. Renders only when
   both env vars are set in the hosting platform (Vercel/Netlify/etc.):
   - PUBLIC_UMAMI_SCRIPT_URL  e.g. https://analytics.joaojacinto.com/script.js
   - PUBLIC_UMAMI_WEBSITE_ID  e.g. 1a2b3c4d-... (from Umami dashboard) */
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const umamiId  = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiOn  = !!(umamiSrc && umamiId);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title data-pt={titlePt}>{title}</title>
<meta name="description" content={description} data-pt-content={descriptionPt}>
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/svg+xml" href="/assets/jj-logo.svg">

<!-- Open Graph -->
<meta property="og:type" content={isHome ? 'website' : 'article'}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="João Jacinto">
<meta property="og:locale" content="en_US">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>

{isHome && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'João Jacinto',
    jobTitle: 'Senior Product Designer',
    url: siteUrl,
    sameAs: [
      'https://linkedin.com/in/joaofranciscojacinto/',
      'https://x.com/joao_jacinto_8',
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Aveiro',
      addressCountry: 'PT',
    },
    worksFor: {
      '@type': 'Organization',
      name: 'Anchorage Digital',
      url: 'https://www.anchorage.com',
    },
  })} />
)}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@900&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">

<!-- Theme bootstrap — runs before paint to prevent FOUC. Theme is
     locked to dark while the user-facing toggle is commented out
     (see .nav-right + .mobile-menu-secondary). Re-enable the
     toggle and the localStorage opt-out (kept below, commented)
     to restore user choice. -->
<script is:inline>
  /* Language bootstrap: English unless the visitor picked Portuguese
     with the EN/PT switch (saved in localStorage as "lang"). Runs
     before paint so the right switch segment is lit from the start. */
  try {
    if (localStorage.getItem('lang') === 'pt') document.documentElement.lang = 'pt-PT';
  } catch (_) {}
  document.documentElement.setAttribute('data-theme', 'dark');
  /*
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      if (stored !== 'light') document.documentElement.setAttribute('data-theme', 'dark');
    } catch (_) {
      document.documentElement.setAttribute('data-theme', 'dark');
    }
  })();
  */
</script>

{umamiOn && (
  <script is:inline async defer data-website-id={umamiId} src={umamiSrc}></script>
)}
</head>
<body>

<a href="#main-content" class="skip-link" data-umami-event="skip-link" data-pt="Saltar para o conteúdo">Skip to content</a>

<nav class:list={['nav', { 'nav-dark': navDark }]} id="nav">
  <div class="container">
    <a href="/" class="logo-outer" aria-label="Home" data-pt-aria-label="Início">
      <span class="logo-bg"></span>
      <img class="logo-mark" src="/assets/jj-logo.svg" alt="" aria-hidden="true">
    </a>

    <div class="pill-nav" id="pillNav">
      <div class="pill-indicator" id="pillIndicator"></div>
      <a href="/" data-page="home" class:list={[{ active: activePage === 'home' }]} data-pt="Início">Home</a>
      <a href="/about" data-page="about" class:list={[{ active: activePage === 'about' }]} data-pt="Sobre">About</a>
      <a href="/case-studies" data-page="cases" class:list={[{ active: activePage === 'cases' }]} data-pt="Trabalho">Work</a>
      <a href="/contact" data-page="contact" class:list={[{ active: activePage === 'contact' }]} data-pt="Contacto">Contact</a>
    </div>

    <div class="nav-right">
      {/* Theme toggle — temporarily disabled. The button is kept
          commented out so it can be re-enabled by uncommenting
          this block (the click handler in nav.js still looks for
          #themeToggle and short-circuits when it isn't there). */}
      {/*
      <button class="btn btn-ghost theme-toggle" id="themeToggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <span class="btn-icon"><svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg><svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></span>
      </button>
      */}
      {/* EN/PT switch. English by default; the choice is saved and
          applied on every page (see the language script below). */}
      <div class="lang-switch" role="group" aria-label="Language" data-pt-aria-label="Idioma">
        <button type="button" data-lang-set="en" lang="en" aria-pressed="true" aria-label="English" data-umami-event="lang-en">EN</button>
        <button type="button" data-lang-set="pt" lang="pt-PT" aria-pressed="false" aria-label="Português" data-umami-event="lang-pt">PT</button>
      </div>
      <button class="btn btn-ghost nav-cta" type="button" data-umami-event="nav-cta-start-project" onclick="openComposeModal(1)">
        <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 4h12v9H2z"/><path d="M2 4l6 5 6-5"/></svg></span>
        <span data-pt="Iniciar projeto">Start project</span>
      </button>
      <button class="nav-toggle" id="navToggle" aria-label="Menu" data-pt-aria-label="Menu" aria-expanded="false" onclick="toggleMobile()">
        <span></span>
      </button>
    </div>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <a href="/" data-page="home" class:list={[{ active: activePage === 'home' }]} onclick="toggleMobile()" data-pt="Início">Home</a>
  <a href="/about" data-page="about" class:list={[{ active: activePage === 'about' }]} onclick="toggleMobile()" data-pt="Sobre">About</a>
  <a href="/case-studies" data-page="cases" class:list={[{ active: activePage === 'cases' }]} onclick="toggleMobile()" data-pt="Trabalho">Work</a>
  <a href="/contact" data-page="contact" class:list={[{ active: activePage === 'contact' }]} onclick="toggleMobile()" data-pt="Contacto">Contact</a>
  <div class="mobile-menu-secondary">
    {/* Mobile theme toggle — temporarily disabled. Uncomment to
        restore. The handler in nav.js short-circuits when
        #mobileThemeToggle isn't in the DOM. */}
    {/*
    <button class="mobile-menu-btn" type="button" id="mobileThemeToggle" aria-label="Toggle dark mode">
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <span class="mobile-theme-label">Switch theme</span>
    </button>
    */}
    <div class="lang-switch" role="group" aria-label="Language" data-pt-aria-label="Idioma">
      <button type="button" data-lang-set="en" lang="en" aria-pressed="true" aria-label="English" data-umami-event="lang-en">EN</button>
      <button type="button" data-lang-set="pt" lang="pt-PT" aria-pressed="false" aria-label="Português" data-umami-event="lang-pt">PT</button>
    </div>
    <button class="mobile-menu-btn mobile-menu-btn--primary" type="button" data-umami-event="mobile-menu-start-project" onclick="toggleMobile(); openComposeModal(1);">
      <span data-pt="Iniciar projeto">Start project</span>
    </button>
  </div>
</div>

<main id="main-content">
  {!disablePageParticles && (
    <div class="page-particles" aria-hidden="true">
      <canvas class="cta-footer-bg"></canvas>
    </div>
  )}
  <slot />
</main>

{(showCta || showFooter) && (
  <div class:list={['cta-footer-wrap', { 'cta-footer-wrap--solo': !showCta }]}>
    {/* Canvas in both modes — solo wraps (contact + error pages) get the
        same FBM-dithered gradient + particle treatment as the regular
        cta-footer-wrap, so the page→footer transition looks organic. */}
    <canvas class="cta-footer-bg" aria-hidden="true"></canvas>
    {showCta && (
      <section class="global-cta-section">
        <div class="container">
          <div class="about-cta reveal">
            <div class="about-cta-avatar-stack" aria-hidden="true">
              {/* Six-frame roulette, hover-triggered. Each <img> is
                  absolutely positioned over the others; the original
                  headshot is shown statically by default. Hovering
                  the stack runs avatar-roulette across the six
                  frames at 1.8s total / 0.3s per frame, snapping
                  between photos for a slot-machine feel. Reduced-
                  motion users see only the first frame, static.
                  data-tooltip is read by the click handler in
                  compose-modal.js to populate the freeze tooltip. */}
              <img class="about-cta-avatar-frame" src="/assets/images/photo.webp" data-tooltip="Click again. I dare you." data-pt-data-tooltip="Clica outra vez. Duvido." alt="" width="96" height="96" loading="lazy">
              <img class="about-cta-avatar-frame" src="/assets/images/photo-astronaut.webp" data-tooltip="Trained for zero gravity. Employed for zero margin." data-pt-data-tooltip="Treinado para gravidade zero. Contratado para margem zero." alt="" width="96" height="96" loading="lazy">
              <img class="about-cta-avatar-frame" src="/assets/images/photo-guitar.webp" data-tooltip="Practicing quietly. The neighbors disagree." data-pt-data-tooltip="A praticar baixinho. Os vizinhos discordam." alt="" width="96" height="96" loading="lazy">
              <img class="about-cta-avatar-frame" src="/assets/images/photo-tickets.webp" data-tooltip="Itinerary: aspirational. Carry-on: overpacked." data-pt-data-tooltip="Itinerário: ambicioso. Bagagem de mão: a rebentar pelas costuras." alt="" width="96" height="96" loading="lazy">
              <img class="about-cta-avatar-frame" src="/assets/images/photo-vr.webp" data-tooltip="911 in VR. EV in the garage. Identity crisis." data-pt-data-tooltip="Um 911 em VR. Um elétrico na garagem. Crise de identidade." alt="" width="96" height="96" loading="lazy">
              <img class="about-cta-avatar-frame" src="/assets/images/photo-padel.webp" data-tooltip="Smash intent. Lob outcome." data-pt-data-tooltip="Intenção de smash. Resultado: lob." alt="" width="96" height="96" loading="lazy">
              {/* Progress ring — renders around the avatar when the
                  stack carries .is-frozen, with a 4s circular fill
                  showing the time remaining before the roulette
                  resumes. pathLength="100" lets the fill animate via
                  stroke-dashoffset 100 → 0 in CSS without computing
                  the actual circumference. */}
              <svg class="about-cta-avatar-progress" viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r="48" pathLength="100"></circle>
              </svg>
              {/* Tooltip — JS fills .textContent from the active
                  frame's data-tooltip on click, then .is-frozen
                  fades it in. */}
              <span class="about-cta-avatar-tooltip"></span>
            </div>
            <h2 data-pt="Vamos construir algo.">Let's build something.</h2>
            <p data-pt="Gosto de trabalho de produto, design systems e projetos 0→1, onde a estrutura conta tanto como a superfície.">Drawn to product work, design systems, and 0→1 projects where the structure matters as much as the surface.</p>
            <div class="about-cta-btns">
              <button class="btn btn-accent" data-umami-event="cta-get-in-touch" onclick="openComposeModal()">
                <span class="btn-icon"><svg viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M80-80v-720q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v480q0 33-23.5 56.5T800-240H240L80-80Zm126-240h594v-480H160v525l46-45Zm-46 0v-480 480Z"/></svg></span>
                <span data-pt="Falar comigo">Get in touch</span>
              </button>
              <a class="btn btn-dark-outline" data-umami-event="cta-book-call" href="https://www.cal.eu/joao-jacinto" target="_blank" rel="noopener noreferrer">
                <span class="btn-icon"><svg viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M160-160q-33 0-56.5-23.5T80-240v-480q0-33 23.5-56.5T160-800h480q33 0 56.5 23.5T720-720v180l160-160v440L720-420v180q0 33-23.5 56.5T640-160H160Zm0-80h480v-480H160v480Zm0 0v-480 480Z"/></svg></span>
                <span data-pt="Marcar chamada">Book a call</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}
    {showFooter && (
      <footer class="footer" id="footer">
        <div class="container">
          <div class="footer-status" id="footer-status">
            <span class="footer-status-dot" id="footer-status-dot"></span>
            <span class="footer-status-label" id="footer-status-label"></span>
          </div>
          <p>© 2026 João Jacinto • <button class="footer-email-link" id="footer-email-btn" data-umami-event="footer-email-copy" aria-label="Copy email contact@joaojacinto.com to clipboard" data-pt-aria-label="Copiar o email contact@joaojacinto.com para a área de transferência">contact@joaojacinto.com</button></p>
        </div>
      </footer>
    )}
  </div>
)}

<div id="compose-root"></div>

{import.meta.env.DEV && <div id="retune-root"></div>}

<script is:inline>
/* Language switch (EN/PT).
   Copy is English in the markup. An element opts in to Portuguese with
   data-pt="…" (replaces its inner HTML) or data-pt-<attribute>="…"
   (replaces that attribute, e.g. data-pt-aria-label). Anything without
   one stays in English. The choice is saved in localStorage ("lang") and
   read again in <head> on every page. This runs before the deferred
   scripts, so nav.js measures the nav with the final labels.
   Other scripts can read window.jjLang() ("en" or "pt"), listen for
   "jj:langchange" on document, and call window.jjLangRefresh(el) for
   markup they add later. */
(function () {
  var root = document.documentElement;
  var ATTR = 'data-pt-';
  var texts = [];   /* [el, enHTML, ptHTML] */
  var attrs = [];   /* [el, name, enValue, ptValue] */

  /* Record the English and Portuguese versions of every opted-in
     element under scope. Elements already recorded are skipped. */
  function register(scope) {
    var found = { texts: [], attrs: [] };
    var els = Array.prototype.slice.call(scope.querySelectorAll('*'));
    if (scope.nodeType === 1) els.unshift(scope);
    els.forEach(function (el) {
      if (el.__jjLang) return;
      el.__jjLang = true;
      if (el.hasAttribute('data-pt')) found.texts.push([el, el.innerHTML, el.getAttribute('data-pt')]);
      for (var i = 0; i < el.attributes.length; i++) {
        var a = el.attributes[i];
        if (a.name.indexOf(ATTR) === 0) {
          var name = a.name.slice(ATTR.length);
          found.attrs.push([el, name, el.getAttribute(name), a.value]);
        }
      }
    });
    texts = texts.concat(found.texts);
    attrs = attrs.concat(found.attrs);
    return found;
  }
  register(document);

  function current() { return (root.lang || 'en').toLowerCase().indexOf('pt') === 0 ? 'pt' : 'en'; }

  function apply(lang, only) {
    var pt = lang === 'pt';
    root.lang = pt ? 'pt-PT' : 'en';
    (only ? only.texts : texts).forEach(function (t) {
      t[0].innerHTML = pt ? t[2] : t[1];
      /* text-hover.js splits some labels into per-character spans;
         have it redo the split on the new text. */
      if (t[0].dataset.scDone) {
        delete t[0].dataset.scDone;
        if (window.jjWrapChars) window.jjWrapChars(t[0]);
      }
    });
    (only ? only.attrs : attrs).forEach(function (a) {
      var v = pt ? a[3] : a[2];
      if (v === null) a[0].removeAttribute(a[1]); else a[0].setAttribute(a[1], v);
    });
    document.querySelectorAll('[data-lang-set]').forEach(function (b) {
      b.setAttribute('aria-pressed', String(b.getAttribute('data-lang-set') === lang));
    });
  }

  window.jjLang = current;
  /* For markup a script adds after load (English, with data-pt): call
     window.jjLangRefresh(container) once it is in the page. */
  window.jjLangRefresh = function (scope) {
    var found = register(scope || document);
    if (current() === 'pt') apply('pt', found);
  };
  window.jjSetLang = function (lang) {
    lang = lang === 'pt' ? 'pt' : 'en';
    if (lang === current()) return;
    try { localStorage.setItem('lang', lang); } catch (_) {}
    apply(lang);
    /* Label widths changed: let nav.js re-place the pill indicator. */
    window.dispatchEvent(new Event('resize'));
    document.dispatchEvent(new CustomEvent('jj:langchange', { detail: { lang: lang } }));
  };

  document.querySelectorAll('[data-lang-set]').forEach(function (b) {
    b.addEventListener('click', function () {
      document.querySelectorAll('.lang-switch').forEach(function (s) { s.classList.add('is-animated'); });
      window.jjSetLang(b.getAttribute('data-lang-set')); });
  });

  if (current() === 'pt') apply('pt');
})();
</script>

<script src="/scripts/nav.js" defer></script>
<script src="/scripts/text-hover.js" defer></script>
<script src="/scripts/compose-modal.js" defer></script>

<script>
  /* Retune visual-editing overlay — dev only. The branch is dead-code
     eliminated in prod by Vite's `import.meta.env.DEV` replacement, so
     React/Retune are not bundled into the production output. */
  if (import.meta.env.DEV) {
    const [{ Retune }, React, { createRoot }] = await Promise.all([
      import('retune'),
      import('react'),
      import('react-dom/client'),
    ]);
    const root = document.getElementById('retune-root');
    if (root) createRoot(root).render(React.createElement(Retune));
  }
</script>

<script is:inline>
/* Open the compose modal on the chat tab with a prefilled message, then
   focus the name field. Uses only the public window.openComposeModal. */
window.jjComposeWith = function (message) {
  if (typeof window.openComposeModal !== 'function') return;
  window.openComposeModal(0);
  var tries = 0;
  (function fill() {
    var body = document.getElementById('chat-body');
    if (body) {
      body.value = message;
      body.dispatchEvent(new Event('input', { bubbles: true }));
      var name = document.getElementById('user-name');
      if (name) name.focus();
    } else if (tries++ < 20) {
      setTimeout(fill, 50);
    }
  })();
};
</script>

</body>
</html>
