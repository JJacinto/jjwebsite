  var NOTE = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4.5 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM4.5 10.5V4l8-1.5V5l-8 1.5V10.5z"/></svg>';

