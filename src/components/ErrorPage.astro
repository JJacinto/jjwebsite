---
import Base from '../layouts/Base.astro';

interface Props {
  code: string;
  title: string;
  body: string;
  pageTitle: string;
  description: string;
}

const { code, title, body, pageTitle, description } = Astro.props;
---
<Base
  activePage=""
  navDark={false}
  showCta={false}
  showFooter={true}
  disablePageParticles={true}
  title={pageTitle}
  description={description}
>
  <section class="error-page contact cta-footer-wrap">
    <canvas class="cta-footer-bg" aria-hidden="true"></canvas>
    <div class="contact-inner reveal">
      <p class="eyebrow error-code">{code}</p>
      <h1>{title}</h1>
      <p class="contact-body" set:html={body}></p>
      <div class="contact-ctas">
        <a class="btn btn-accent" href="/">
          <span class="btn-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12L12 3l9 9"/><path d="M5 10v10h14V10"/></svg></span>
          <span>Back to home</span>
        </a>
        <a class="btn btn-ghost" href="/case-studies">
          <span class="btn-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h14M11 6l6 6-6 6"/></svg></span>
          <span>See case studies</span>
        </a>
      </div>
    </div>
  </section>
</Base>
