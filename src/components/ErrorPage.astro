---
import Base from '../layouts/Base.astro';

interface Props {
  code: string;
  title: string;
  body: string;
  pageTitle: string;
  description: string;
  codePt?: string;
  titlePt?: string;
  bodyPt?: string;
  pageTitlePt?: string;
  descriptionPt?: string;
}

const { code, title, body, pageTitle, description, codePt, titlePt, bodyPt, pageTitlePt, descriptionPt } = Astro.props;
---
<Base
  activePage=""
  navDark={false}
  showCta={false}
  showFooter={true}
  disablePageParticles={true}
  title={pageTitle}
  description={description}
  titlePt={pageTitlePt}
  descriptionPt={descriptionPt}
>
  <section class="error-page contact cta-footer-wrap" data-space-root>
    <canvas class="cta-footer-bg" aria-hidden="true"></canvas>
    <canvas class="hero-space" data-hero-space data-space-auto data-space-rally data-hole-a="let go now for a quiet game of zero-gravity pong" data-pt-data-hole-a="larga agora para um pingue-pongue em gravidade zero" data-hole-b="keep holding and I can't promise anything" data-pt-data-hole-b="continua a carregar e não prometo nada" data-hole-c="too late. let go and it's war" data-pt-data-hole-c="tarde demais. larga e é guerra" data-swarm-label="SCORE" data-pt-data-swarm-label="PONTOS" data-swarm-hint="MOVE AND CLICK TO SHOOT" data-pt-data-swarm-hint="MOVE O RATO E CLICA PARA DISPARAR" data-rally-label="RALLY" data-pt-data-rally-label="TROCAS" data-best-label="BEST" data-pt-data-best-label="MELHOR" data-rally-hint="MOVE TO RETURN" data-pt-data-rally-hint="MOVE O RATO PARA DEVOLVER" aria-hidden="true"></canvas>
    <div class="contact-inner reveal">
      <p class="eyebrow error-code" data-pt={codePt}>{code}</p>
      <h1 data-pt={titlePt}>{title}</h1>
      <p class="contact-body" set:html={body} data-pt={bodyPt}></p>
      <div class="contact-ctas">
        <a class="btn btn-accent" href="/">
          <span class="btn-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12L12 3l9 9"/><path d="M5 10v10h14V10"/></svg></span>
          <span data-pt="Voltar ao início">Back to home</span>
        </a>
        <a class="btn btn-ghost" href="/case-studies">
          <span class="btn-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h14M11 6l6 6-6 6"/></svg></span>
          <span data-pt="Ver casos de estudo">See case studies</span>
        </a>
      </div>
    </div>
  </section>
</Base>
