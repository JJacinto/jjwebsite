---
/* X-ray switch, shared by the About page and the case study pages.
   Render one inline switch where the page wants it, and (optionally) one
   `float` copy anywhere outside a transformed ancestor. Both point at the
   page wrapper through `wrap` (a CSS selector); toggling puts `.xray` on
   that wrapper. The script below is bundled once per page, however many
   switches there are. Styles live in global.css, "X-RAY (shared)". */
interface Props {
  wrap: string;
  float?: boolean;
  /* With float: shown all the time, for pages with no inline switch.
     Base.astro renders one on every page; a page with its own switch wins. */
  always?: boolean;
  /* Renders as a ghost button ("Turn on X-ray" / "Turn off X-ray") instead
     of a track and knob. Still a role="switch", synced like the others. */
  button?: boolean;
  label?: string;
  labelPt?: string;
}
const DEFAULT_LABEL = "Show the parts you don't see";
const { wrap, float = false, always = false, button = false, label = DEFAULT_LABEL, labelPt } = Astro.props;
/* Portuguese: the default label has one built in; a custom label needs labelPt. */
const ptLabel = labelPt ?? (label === DEFAULT_LABEL ? 'Mostrar as partes que não se veem' : undefined);
---
{button ? (
  <button type="button" role="switch" aria-checked="false" aria-label="X-ray" data-pt-aria-label="Raio-X" class="btn btn-ghost xray-btn" data-xray-switch data-xray-wrap={wrap} data-umami-event="xray-button" data-sc-each hidden>
    <span class="xray-btn-off" data-pt="Ligar o Raio-X">Turn on X-ray</span>
    <span class="xray-btn-on" data-pt="Desligar o Raio-X">Turn off X-ray</span>
  </button>
) : float ? (
  <button type="button" role="switch" aria-checked="false" aria-label={label} data-pt-aria-label={ptLabel} class:list={['xray-switch', 'xray-switch--float', { 'xray-switch--always': always }]} data-xray-switch data-xray-global={always ? '' : undefined} data-xray-wrap={wrap} hidden>
    <span class="xray-track" aria-hidden="true"><span class="xray-knob"></span></span>
    <span class="xray-label" aria-hidden="true" data-pt="Raio-X">X-ray</span>
  </button>
) : (
  <button type="button" role="switch" aria-checked="false" class="xray-switch" data-xray-switch data-xray-wrap={wrap} hidden>
    <span class="xray-track" aria-hidden="true"><span class="xray-knob"></span></span>
    <span class="xray-label" data-pt={ptLabel}>{label}</span>
  </button>
)}

<script>
  /* Hero/inline switch + floating copy, kept in sync. The `x` key toggles
     the first wrapper on the page. */
  let switches = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-xray-switch]'));
  /* The site-wide switch steps aside when the page has its own. */
  if (switches.some((s) => !s.hasAttribute('data-xray-global'))) {
    switches.filter((s) => s.hasAttribute('data-xray-global')).forEach((s) => s.remove());
    switches = switches.filter((s) => !s.hasAttribute('data-xray-global'));
  }
  const wrapOf = (s: HTMLElement) => document.querySelector<HTMLElement>(s.dataset.xrayWrap || '');
  const wraps = Array.from(new Set(switches.map(wrapOf).filter((w): w is HTMLElement => !!w)));

  function labelGaps(wrap: HTMLElement) {
    wrap.querySelectorAll<HTMLElement>('[data-xray-gap]').forEach((el) => {
      const mb = parseFloat(getComputedStyle(el).marginBottom);
      if (!isNaN(mb)) el.setAttribute('data-xray-gap', String(Math.round(mb)));
    });
  }
  /* The grid lives on <body>, so it covers the shared footer too, which
     sits outside the page wrapper. The footer CTA takes the same .xray. */
  const grids = Array.from(document.querySelectorAll<HTMLElement>('.xray-grid'));
  grids.forEach((g, i) => { if (i === 0) document.body.appendChild(g); else g.remove(); });
  if (!grids.length && switches.length) {
    const g = document.createElement('div');
    g.className = 'xray-grid';
    g.setAttribute('aria-hidden', 'true');
    g.innerHTML = '<div class="xray-grid-inner">' + '<span></span>'.repeat(12) + '</div>';
    document.body.appendChild(g);
  }
  const footer = document.querySelector<HTMLElement>('.cta-footer-wrap');

  function setXray(wrap: HTMLElement, on: boolean) {
    wrap.classList.toggle('xray', on);
    document.documentElement.classList.toggle('xray-on', on);
    if (footer) { footer.classList.toggle('xray', on); if (on) labelGaps(footer); }
    switches.forEach((s) => { if (wrapOf(s) === wrap) s.setAttribute('aria-checked', String(on)); });
    if (on) labelGaps(wrap);
  }

  switches.forEach((s) => {
    const wrap = wrapOf(s);
    if (!wrap) return;
    s.hidden = false;
    s.addEventListener('click', () => setXray(wrap, !wrap.classList.contains('xray')));
  });
  window.addEventListener('resize', () => {
    wraps.forEach((w) => { if (w.classList.contains('xray')) labelGaps(w); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'x' && e.key !== 'X') return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    /* A wrapper that is display:none (a locked case page) cannot be toggled by key. */
    const w = wraps.find((x) => x.getClientRects().length > 0);
    if (w) setXray(w, !w.classList.contains('xray'));
  });

  /* The floating copy appears only after the inline switch has scrolled
     out of view (above the viewport), and never while its page is hidden. */
  wraps.forEach((wrap) => {
    const mine = switches.filter((s) => wrapOf(s) === wrap);
    const inline = mine.find((s) => !s.classList.contains('xray-switch--float'));
    const floating = mine.find((s) => s.classList.contains('xray-switch--float'));
    if (!inline || !floating || !('IntersectionObserver' in window)) return;
    new IntersectionObserver((entries) => {
      const e = entries[entries.length - 1];
      const visible = inline.getClientRects().length > 0;
      floating.classList.toggle('is-shown', visible && !e.isIntersecting && e.boundingClientRect.bottom <= 0);
    }).observe(inline);
  });
</script>
