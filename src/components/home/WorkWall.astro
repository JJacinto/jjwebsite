---
/* Home page work wall: eight tiles, each a small mockup of one decision.
   Three lead tiles (lead: true) sit large on top and loop all the time;
   the other five sit small below and rest on their final frame, playing
   only on hover or focus. Hover, focus or tap shows the decision behind
   it; with X-ray on, every tile shows it at once. Facts come from
   src/data/cases.ts. Styles live in global.css, "Work wall". */
import { CASES } from '../../data/cases';

const slugOf = (slug: string) => {
  const c = CASES.find((x) => x.slug === slug);
  if (!c) throw new Error('WorkWall: unknown case ' + slug);
  return `/case-studies/${c.slug}`;
};

type Tile = {
  id: string; cat: 'ui' | 'ds' | 'rs' | 'ft'; company: string; title: string;
  href?: string; lead?: boolean;
  decision: string; resultLabel: string; result: string;
  titlePt?: string; decisionPt?: string; resultLabelPt?: string; resultPt?: string;
};

const tiles: Tile[] = [
  { id: 'h', lead: true, cat: 'ft', company: 'Anchorage', title: '40 steps → 1',
    decision: 'A 40-step admin flow for policies and permissions became one configuration step.',
    resultLabel: 'Status', result: 'Case study in progress.',
    titlePt: '40 passos → 1',
    decisionPt: 'Um fluxo de administração de 40 passos, para políticas e permissões, passou a um único passo de configuração.',
    resultLabelPt: 'Estado', resultPt: 'Caso de estudo em curso.' },
  { id: 'b', lead: true, cat: 'ui', company: 'StreamYard', title: 'Custom registration fields', href: slugOf('redefining-webinar-customization'),
    decision: 'Registration only collected a name and an email. I shipped a settings page with five custom registration fields.',
    resultLabel: 'Result', result: '32.9% of webinars used custom fields within four months.',
    titlePt: 'Campos de registo personalizados',
    decisionPt: 'O registo só pedia um nome e um email. Lancei uma página de definições com cinco campos de registo personalizados.',
    resultLabelPt: 'Resultado', resultPt: '32,9% dos webinars usaram campos personalizados em quatro meses.' },
  { id: 'c', lead: true, cat: 'rs', company: 'StreamYard', title: 'Journey map', href: slugOf('understanding-webinar-organizers'),
    decision: 'The roadmap came from sales calls and support tickets. I interviewed organisers who paid for competing tools, then mapped five stages for the whole company.',
    resultLabel: 'Result', result: "The company's first shared knowledge base on webinar organisers. Two other teams briefed.",
    titlePt: 'Mapa de jornada',
    decisionPt: 'O roadmap vinha de chamadas de vendas e tickets de suporte. Entrevistei organizadores que pagavam por ferramentas concorrentes e depois mapeei cinco fases para a empresa toda.',
    resultLabelPt: 'Resultado', resultPt: 'A primeira base de conhecimento partilhada da empresa sobre organizadores de webinars. Duas outras equipas receberam o briefing.' },
  { id: 'a', cat: 'ui', company: 'StreamYard', title: 'One colour, whole palette', href: slugOf('redefining-webinar-customization'),
    decision: 'I cut the full page builder. One colour choice generates the whole palette, so hosts get an on-brand webinar without designing one.',
    resultLabel: 'Result', result: 'Weekly webinars went from about 200 to about 600.',
    titlePt: 'Uma cor, a paleta toda',
    decisionPt: 'Cortei o page builder completo. Uma só escolha de cor gera a paleta inteira, e quem organiza fica com um webinar com a sua marca sem ter de o desenhar.',
    resultLabelPt: 'Resultado', resultPt: 'Os webinars semanais passaram de cerca de 200 para cerca de 600.' },
  { id: 'd', cat: 'ds', company: 'StreamYard', title: 'Five versions, one button', href: slugOf('leading-and-managing-a-design-system'),
    decision: 'Some components existed in five or more versions. I skipped new headcount and a big-bang rebuild. Designers from six teams proposed components through fixed checkpoints.',
    resultLabel: 'Result', result: 'Six teams on one roadmap.',
    titlePt: 'Cinco versões, um botão',
    decisionPt: 'Havia componentes com cinco ou mais versões. Dispensei mais headcount e uma reconstrução de uma só vez. Designers de seis equipas propuseram componentes através de checkpoints fixos.',
    resultLabelPt: 'Resultado', resultPt: 'Seis equipas num só roadmap.' },
  { id: 'e', cat: 'ds', company: 'StreamYard', title: 'Theme from one setting', href: slugOf('leading-and-managing-a-design-system'),
    decision: 'Tokens first. Scoped variables mean the whole theme switches between light and dark with one setting.',
    resultLabel: 'Result', result: 'Tokens and 15+ specified components, with six teams on one roadmap.',
    titlePt: 'Tema a partir de uma definição',
    decisionPt: 'Primeiro os tokens. Com variáveis com âmbito, o tema inteiro passa de claro a escuro com uma só definição.',
    resultLabelPt: 'Resultado', resultPt: 'Tokens e 15+ componentes especificados, com seis equipas num só roadmap.' },
  { id: 'f', cat: 'ui', company: 'Namecheap', title: 'Floating chat widget', href: slugOf('designing-a-support-chat-experience'),
    decision: 'The old tool opened a separate window. I cut it, and the chat became a floating widget that stays with you while you browse.',
    resultLabel: 'Result', result: 'Chats grew 28.9% in four months, and 97.4% of feedback was positive.',
    titlePt: 'Widget de chat flutuante',
    decisionPt: 'A ferramenta antiga abria uma janela à parte. Cortei isso, e o chat passou a ser um widget flutuante que acompanha quem está a navegar.',
    resultLabelPt: 'Resultado', resultPt: 'As conversas cresceram 28,9% em quatro meses, e 97,4% do feedback foi positivo.' },
  { id: 'g', cat: 'ui', company: 'Namecheap', title: 'Agent app', href: slugOf('designing-a-support-chat-experience'),
    decision: 'Agents handled five or more chats across 20+ browser tabs. I designed one agent app so they could work from a single place.',
    resultLabel: 'Result', result: 'An agent app and a white-label design system for namecheap.com and ssls.com.',
    titlePt: 'App para agentes',
    decisionPt: 'Os agentes geriam cinco ou mais chats em mais de 20 separadores do browser. Desenhei uma única app para agentes, para trabalharem num só sítio.',
    resultLabelPt: 'Resultado', resultPt: 'Uma app para agentes e um design system white-label para namecheap.com e ssls.com.' },
];

const cats = [
  { f: 'all', label: 'All', labelPt: 'Todos' },
  { f: 'ui', label: 'Product UI', labelPt: undefined },
  { f: 'ds', label: 'Design systems', labelPt: undefined },
  { f: 'rs', label: 'Research', labelPt: 'Pesquisa' },
  { f: 'ft', label: 'Fintech', labelPt: undefined },
];
const count = (f: string) => (f === 'all' ? tiles.length : tiles.filter((t) => t.cat === f).length);

/* Mockup pieces generated here so the markup is static and the resting
   state is the final frame (no JS needed). */
const formFields = [['t', 40], ['d', 54], ['t', 34], ['c', 58], ['t', 46]].map(([k, w], i) => ({ k: k as string, w: w as number, i }));
const journey = [0, 1, 2, 3, 4].map((c) => ({
  c,
  notes: [0, 1, 2].map((n) => {
    const i = c * 3 + n;
    return {
      i, s: (4 + i * 2.4).toFixed(1), nh: [95, 285, 165][i % 3],
      x: ((i * 37) % 11 - 5) * 13, y: ((i * 53) % 9 - 4) * 13, rt: ((i * 29) % 9 - 4) * 5,
      w1: 70 - (i % 4) * 10, w2: 46 + (i % 3) * 12,
    };
  }),
}));
const variants = [[-80, -2, 26, 20, 'oklch(.52 .17 270)'], [-40, 1.5, -14, -4, 'oklch(.6 .16 290)'], [0, 0, 0, 0, 'oklch(.5 .15 255)'], [40, -1.5, 12, -6, 'oklch(.58 .13 275)'], [80, 2, -22, 6, 'oklch(.46 .17 262)']];
const tabs = Array.from({ length: 24 }, (_, i) => {
  const c = i % 6, r = Math.floor(i / 6);
  return { i, left: 11 + c * 45, top: 30 + r * 23, s: (10 + c * 1.5).toFixed(1), dx: 144 - (11 + c * 45 + 20), dy: 70 - (30 + r * 23 + 9), th: (i * 47) % 360 };
});
const inbox = [210, 25, 150, 300, 80].map((h, i) => ({ h, i, s: 36 + i * 4 }));
const steps = Array.from({ length: 40 }, (_, i) => ({ i, s: 24 + (i % 4) * 2, dy: 138 - (i * 7 + 2), w: [62, 84, 46, 72, 90, 54][i % 6], k: i % 8 === 0 }));
---
<div class="wall-controls reveal">
  <div class="wall-chips" role="group" aria-label="Filter work" data-pt-aria-label="Filtrar trabalho">
    {cats.map((c) => (
      <button type="button" class="wall-chip" data-f={c.f} aria-pressed={c.f === 'all' ? 'true' : 'false'} data-umami-event="home-wall-filter" data-umami-event-filter={c.f}>
        <span data-pt={c.labelPt}>{c.label}</span> <em>{count(c.f)}</em>
      </button>
    ))}
  </div>
  <button type="button" class="wall-pause" aria-pressed="false" data-umami-event="home-wall-pause"><span class="wall-sw" aria-hidden="true"></span><span data-pt="Pausar pré-visualizações">Pause previews</span></button>
</div>

<div class="wall" id="wall" role="list" aria-label="Selected work" data-pt-aria-label="Trabalho selecionado">
  {tiles.map((t) => (
    <article class={`tile ${t.lead ? 'tile--lead' : 'tile--more'}`} role="listitem" data-cat={t.cat} tabindex="0" aria-label={`${t.company}, ${t.title}`} data-pt-aria-label={`${t.company}, ${t.titlePt ?? t.title}`}>
      <div class="media" aria-hidden="true">
        {t.id === 'a' && (
          <div class="mock a">
            <div class="pick cd"><span class="dot hue"></span><div class="sw"><i style="--sh:265"></i><i style="--sh:165"></i><i style="--sh:25"></i><i style="--sh:320"></i><b class="ring"></b></div></div>
            <div class="pal"><i class="hue" style="--L:.95;--i:1"></i><i class="hue" style="--L:.86;--i:2"></i><i class="hue" style="--L:.76;--i:3"></i><i class="hue" style="--L:.64;--i:4"></i><i class="hue" style="--L:.5;--i:5"></i><i class="hue" style="--L:.36;--i:6"></i></div>
            <div class="web cd hue" style="--i:8"><div class="wt"><i class="hue" style="--i:8"></i><span class="sk" style="width:60px"></span></div><div class="wh hue" style="--i:9"><span class="sk" style="width:70%"></span><span class="sk" style="width:44%"></span></div><div class="wb"><span class="sk" style="width:80px"></span><span class="mini hue" style="--i:10"></span></div></div>
          </div>
        )}
        {t.id === 'b' && (
          <div class="mock tl"><div class="bf cd">
            <div class="hd"><span class="sk" style="width:84px;height:8px"></span><span class="tag cnt"></span></div>
            {formFields.map((f) => (
              <div class="fld r" style={`--s:${6 + 8 * f.i};--w:8`}>
                <i class="sk" style={`width:${34 + f.i * 7}px`}></i>
                <div class="inp">
                  {f.k === 'c' ? (<><b class="cb"></b><i class="sk" style="width:60%"></i></>) : (<i class="sk" style={`width:${f.w}%`}></i>)}
                  {f.k === 'd' && <u class="chev"></u>}
                </div>
              </div>
            ))}
          </div></div>
        )}
        {t.id === 'c' && (
          <div class="mock tl"><div class="cm">
            {journey.map((col) => (
              <div class="cl">
                <div class="ch r" style="--s:40;--w:14">0{col.c + 1}</div>
                {col.notes.map((n) => (
                  <div class="nt r" style={`--s:${n.s};--w:22;--nh:${n.nh};--x:${n.x};--y:${n.y};--rt:${n.rt}`}><i style={`width:${n.w1}%`}></i><i style={`width:${n.w2}%`}></i></div>
                ))}
              </div>
            ))}
          </div></div>
        )}
        {t.id === 'd' && (
          <div class="mock dm tl">
            {variants.map(([y, rt, dw, db, bg], i) => (
              <div class={`vb r ${i ? 'x' : ''}`} style={`--s:14;--w:24;--y:${y};--rt:${rt};--dw:${dw};--db:${db};--bgv:${bg}`}></div>
            ))}
            <span class="tag vc r" style="--s:14;--w:24"></span>
            <span class="tag tok r" style="--s:38;--w:10">token</span>
          </div>
        )}
        {t.id === 'e' && (
          <div class="mock tl" style="display:grid;place-items:center"><div class="pn">
            <div class="hd"><span class="sk" style="width:70px;height:8px"></span><span class="trk"></span></div>
            <div class="in"><span class="sk"></span></div>
            <div class="bt"></div>
            <div class="row"><span class="ch2"></span><span class="ch2"></span><span class="ch2"></span></div>
            <span class="sk" style="width:88%"></span><span class="sk" style="width:62%"></span>
          </div></div>
        )}
        {t.id === 'f' && (
          <div class="mock fm cd tl"><div class="pg">
            <div style="display:flex;gap:6px;align-items:center"><span class="sk" style="width:46px;height:8px"></span><span class="sk" style="width:30px;margin-left:auto"></span><span class="sk" style="width:30px"></span></div>
            <div class="hero-ph"><span class="sk" style="width:60%;height:8px"></span><span class="sk" style="width:38%"></span></div>
            <div class="g3"><div></div><div></div><div></div></div>
            <span class="sk" style="width:80%"></span><span class="sk" style="width:55%"></span>
            <div class="wd r" style="--s:14;--w:12">
              <div class="ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6A.6.6 0 0 1 4.8 19V16A2.5 2.5 0 0 1 4 14z"/></svg></div>
              <div class="in"><div class="top"><i></i><span class="sk"></span></div>
                <div class="bd">
                  <div class="ms me r" style="--s:28;--w:6"><span class="sk" style="width:62px"></span><span class="sk" style="width:38px"></span></div>
                  <div class="ms ag r" style="--s:46;--w:6;min-height:34px"><span class="sk" style="width:84px"></span><span class="sk" style="width:60px"></span></div>
                  <div class="ms me r" style="--s:58;--w:6"><span class="sk" style="width:44px"></span></div>
                </div>
                <div class="dts"><i></i><i></i><i></i></div>
              </div>
            </div>
          </div></div>
        )}
        {t.id === 'g' && (
          <div class="mock gm cd tl">
            <div class="gb"><i></i><i></i><i></i><span class="sk"></span></div>
            <div class="gr">
              <span class="tag gc gc-from r" style="--s:14;--w:18" data-pt="20+ separadores">20+ tabs</span>
              <span class="tag gc gc-to r" style="--s:36;--w:10">1 app</span>
              {tabs.map((x) => (
                <div class="gt r" style={`left:${x.left}px;top:${x.top}px;--s:${x.s};--w:22;--dx:${x.dx};--dy:${x.dy};--th:${x.th}`}><i></i><span class="sk"></span></div>
              ))}
              <div class="gi">
                {inbox.map((r) => (
                  <div class="r" style={`--s:${r.s};--w:10;--th:${r.h}`}><i></i><span class="sk"></span><span class="sk"></span>{r.i < 2 && <b></b>}</div>
                ))}
              </div>
            </div>
          </div>
        )}
        {t.id === 'h' && (
          <div class="mock hm tl">
            <span class="tag hc r" style="--s:24;--w:30"></span>
            <div class="hcol">
              {steps.map((s) => (
                <div class={`hr r ${s.k ? 'k' : ''}`} style={`--i:${s.i};--s:${s.s};--w:24;--dy:${s.dy}`}><i></i><b style={`width:${s.w}%`}></b></div>
              ))}
            </div>
            <div class="hcard cd r" style="--s:44;--w:14"><strong data-pt="Configurar política">Configure policy</strong><span class="sk" style="width:90%"></span><span class="sk" style="width:62%"></span><span class="tag" style="justify-self:start" data-pt="1 passo">1 step</span></div>
          </div>
        )}
      </div>

      <div class="cap">
        <span class="cap-title"><span class="c">{t.company} · </span><b data-pt={t.titlePt}>{t.title}</b></span>
        <span class="cap-tags">
          {t.href && (
            <span class="priv">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg><span data-pt="Privado">Private</span>
            </span>
          )}
          <span class="pill" data-pt={t.href ? 'Decisão' : 'A escrever'}>{t.href ? 'Decision' : 'Writing it up'}</span>
        </span>
      </div>

      <div class="ov">
        <span class="mono" data-pt="A decisão por trás">The decision behind it</span>
        <p class="dec" data-pt={t.decisionPt}>{t.decision}</p>
        <p class="res"><b data-pt={t.resultLabelPt}>{t.resultLabel}</b><span data-pt={t.resultPt}>{t.result}</span></p>
        {t.href && (
          <a class="rd" href={t.href} data-umami-event="home-wall-tile" data-umami-event-tile={t.id}>
            <span data-pt="Ler o caso">Read the case</span>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
        )}
      </div>
    </article>
  ))}
</div>

<p class="wall-access reveal"><span data-pt="Os casos de estudo completos são privados.">The full case studies are private.</span> <button type="button" class="work-ask" data-umami-event="home-ask-access" onclick="jjComposeWith(window.jjLang && window.jjLang() === 'pt' ? 'Olá João, podes enviar-me a palavra-passe dos casos de estudo?' : 'Hi João, could you send me the password for the case studies?')" data-pt="Pedir acesso">Ask me for access</button></p>

<script>
  const wall = document.getElementById('wall') as HTMLElement | null;
  if (wall) {
    const tiles = Array.from(wall.querySelectorAll<HTMLElement>('.tile'));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.wall-chip'));
    const pause = document.querySelector<HTMLButtonElement>('.wall-pause');

    /* Pause previews: on by default for reduced motion. */
    const setPaused = (v: boolean) => {
      wall.classList.toggle('is-paused', v);
      pause?.setAttribute('aria-pressed', String(v));
    };
    setPaused(matchMedia('(prefers-reduced-motion: reduce)').matches);
    pause?.addEventListener('click', () => setPaused(!wall.classList.contains('is-paused')));

    /* Filters */
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      const f = c.dataset.f;
      tiles.forEach((t) => {
        const show = f === 'all' || t.dataset.cat === f;
        /* Filtered-out tiles stay as ghosts so the wall keeps its shape. */
        t.classList.toggle('ghost', !show);
        t.classList.remove('open');
        if (show) { t.removeAttribute('aria-hidden'); t.tabIndex = 0; }
        else { t.setAttribute('aria-hidden', 'true'); t.tabIndex = -1; }
      });
    }));

    /* Tap to reveal on touch; links inside still navigate. */
    tiles.forEach((t) => t.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('a') && matchMedia('(hover: none)').matches) t.classList.toggle('open');
    }));

    /* Previews pause while offscreen. */
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('off', !e.isIntersecting)));
      tiles.forEach((t) => io.observe(t));
    }
  }
</script>
