  /* ===== Multi-column blocks ===== */
  .rwc-columns {
    display: grid;
    gap: var(--dimension-space-32);
    margin-top: var(--dimension-space-24);
    margin-bottom: var(--dimension-space-32);
  }
  .rwc-columns.cols-3 { grid-template-columns: repeat(3, 1fr); }
  .rwc-columns.cols-5 { grid-template-columns: repeat(5, 1fr); }
  .rwc-columns h3 {
