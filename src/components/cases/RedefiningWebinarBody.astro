  }

  /* ===== Breakpoint showcase ===== */
  .rwc-breakpoints {
    margin: var(--dimension-space-32) 0;
    display: grid;
    gap: var(--dimension-space-20);
  }
  .rwc-breakpoint-tag {
    font-family: var(--font-family-mono, monospace);
    font-size: var(--font-size-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--font-letter-spacing-wider);
    margin-bottom: var(--dimension-space-8);
  }

  /* ===== Stats ===== */
  .rwc-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--dimension-space-40);
    margin: var(--dimension-space-32) 0;
