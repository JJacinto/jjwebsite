    grid-template-columns: 1fr 1fr;
    gap: var(--dimension-space-32);
    margin-top: var(--dimension-space-24);
  }
  .rwc-option-tag {
    font-size: var(--font-size-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--font-letter-spacing-wider);
    margin-bottom: var(--dimension-space-8);
  }
  .rwc-option h3 { margin-top: 0 !important; margin-bottom: var(--dimension-space-16) !important; }
  .rwc-option .case-img-ph { margin-bottom: var(--dimension-space-16); }

  /* ===== Bullets ===== */
  .rwc-bullets {
    list-style: none;
    padding: 0;
    margin: var(--dimension-space-12) 0 var(--dimension-space-24);
  }
  .rwc-bullets li {
    font-family: var(--font-family-body);
    font-size: var(--font-size-base);
    color: var(--text-secondary);
    line-height: var(--font-line-height-loose);
    padding-left: var(--dimension-space-20);
    position: relative;
    margin-bottom: var(--dimension-space-6);
  }
  .rwc-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
