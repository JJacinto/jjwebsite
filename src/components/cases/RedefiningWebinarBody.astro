  /* ===== Video placeholder accent ===== */
  .rwc-video-ph {
    min-height: 360px;
    background: linear-gradient(135deg, rgba(120, 80, 200, 0.08), rgba(80, 50, 160, 0.04));
  }

  /* ===== Responsive YouTube embed =====
     16:9 frame that scales to any width. The iframe absolutely fills
     the wrapper so we don't depend on intrinsic iframe sizing. */
  .rwc-video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--dimension-radius-lg, 12px);
    overflow: hidden;
    background: #000;
    margin-top: var(--dimension-space-16);
  }
  .rwc-video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ===== Responsive ===== */
  @media (max-width: 960px) {
    .rwc-hero,
    .rwc-role { grid-template-columns: 1fr; }
    .rwc-role-right { text-align: left; }
    .rwc-columns.cols-3,
    .rwc-columns.cols-5 { grid-template-columns: 1fr 1fr; }
    .rwc-options { grid-template-columns: 1fr; }
    .rwc-stats { grid-template-columns: 1fr; gap: var(--dimension-space-24); }
    .case-img-ph-grid.cols-2 { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .rwc-columns.cols-3,
    .rwc-columns.cols-5 { grid-template-columns: 1fr; }
  }

  /* ===== Lightbox =====
     Visual: 50% black backdrop, image rendered at natural size
     (capped to 95vw/95vh so the X button stays reachable). The
     close button anchors to the viewport's top-right, not the
     image, so it never drifts off-screen on tall portraits. */
  /* Force zoom-in cursor on every body image, even when more
     specific rules (e.g., .case-img-ph.is-filled img) win. The
     lightbox img itself is excluded since it gets zoom-out. */
  .rwc-body img:not(.rwc-lightbox-img) { cursor: zoom-in; }

  .rwc-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--dimension-space-24);
    opacity: 0;
    transition: opacity var(--motion-duration-standard, 220ms) var(--motion-easing-standard, ease);
  }
  .rwc-lightbox[hidden] { display: none; }
  .rwc-lightbox.is-open { opacity: 1; }

  .rwc-lightbox-img {
    max-width: 95vw;
    max-height: 95vh;
    width: auto;
    height: auto;
    display: block;
    border-radius: var(--dimension-radius-md, 8px);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
    cursor: zoom-out;
  }

  .rwc-lightbox-close {
    position: fixed;
    top: var(--dimension-space-20);
    right: var(--dimension-space-20);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background var(--motion-duration-short, 140ms) ease, transform var(--motion-duration-short, 140ms) ease;
  }
  .rwc-lightbox-close:hover,
  .rwc-lightbox-close:focus-visible { background: rgba(0, 0, 0, 0.85); transform: scale(1.06); }
  .rwc-lightbox-close svg { width: 22px; height: 22px; }
</style>

<script is:inline>
  /* Lightbox wiring: any <img> inside .rwc-body opens the overlay
     with that image's source. Closes on backdrop click, X button,
     or Escape. Body scroll is locked while open. */
  (function () {
    function init() {
      var body = document.querySelector('.rwc-body');
      var overlay = document.getElementById('rwcLightbox');
      if (!body || !overlay) return;
      /* Guard against double-init when HMR re-runs the script. */
      if (overlay.dataset.lbReady === '1') return;
      overlay.dataset.lbReady = '1';

      var lbImg = overlay.querySelector('.rwc-lightbox-img');
      var closeBtn = overlay.querySelector('.rwc-lightbox-close');
      var lastFocus = null;

      function openLb(src, alt) {
        lastFocus = document.activeElement;
        lbImg.src = src;
        lbImg.alt = alt || '';
        overlay.hidden = false;
        /* Force a reflow so the opacity transition runs from 0 → 1. */
        void overlay.offsetWidth;
        overlay.classList.add('is-open');
        document.documentElement.style.overflow = 'hidden';
        closeBtn.focus();
      }

      function closeLb() {
        overlay.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        /* Wait for the fade-out before hiding, so we don't snap. */
        setTimeout(function () {
          overlay.hidden = true;
          lbImg.src = '';
          if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
        }, 220);
      }

      /* Click delegation on the case body. Skip the lightbox's own
         image (it would re-open itself) and any nav-card thumbnails
         outside .rwc-body (handler is scoped to body anyway). */
      body.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || t.tagName !== 'IMG') return;
        if (t.classList && t.classList.contains('rwc-lightbox-img')) return;
        e.preventDefault();
        openLb(t.currentSrc || t.src, t.alt);
      });

      /* Close handlers. closest() makes the X button reliable even
         when the click lands on the inner <svg> or <line>. */
      overlay.addEventListener('click', function (e) {
        if (e.target.closest('.rwc-lightbox-close')) { closeLb(); return; }
        if (e.target === overlay || e.target === lbImg) closeLb();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !overlay.hidden) closeLb();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
