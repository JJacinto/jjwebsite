{
  "$schema": "https://design-tokens.github.io/community-group/format/2025.10/schema.json",
  "$description": "DTCG-compliant design tokens for joaojacinto.com. Format Module 2025.10. Three-tier: base (primitives) → reference (semantic) → component (signature visuals).",

  "color": {
    "$type": "color",
    "neutral": {
      "0":   { "$value": "#ffffff", "$description": "Pure white anchor — rarely used directly, parent of pale tints",
               "$extensions": { "com.joaojacinto.oklch": "oklch(1 0 0)" } },
      "10":  { "$value": "#fbf8f4", "$description": "Lightest warm tint",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.978 0.005 80)" } },
      "20":  { "$value": "#f7f5f1", "$description": "Surface — cards on light backgrounds. Maps to legacy --surface",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.964 0.005 80)" } },
      "30":  { "$value": "#f0ede8", "$description": "Text on dark surfaces. Maps to legacy --fg-inverse",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.937 0.005 80)" } },
      "40":  { "$value": "#eceae5", "$description": "Page background. Maps to legacy --bg",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.92 0.005 80)" } },
      "50":  { "$value": "#e4e1db", "$description": "Section variant background. Maps to legacy --bg-alt",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.892 0.006 80)" } },
      "60":  { "$value": "#c0bbb3", "$description": "Mid-light neutral — borders, dividers on light surfaces",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.768 0.009 78)" } },
      "70":  { "$value": "#9b948d", "$description": "Tertiary text. Maps to legacy --fg3",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.638 0.011 75)" } },
      "80":  { "$value": "#6b6560", "$description": "Secondary text. Maps to legacy --fg2",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.477 0.011 70)" } },
      "90":  { "$value": "#262320", "$description": "Dark surface — modal/footer backgrounds. Maps to legacy --dark-surface",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.221 0.006 65)" } },
      "100": { "$value": "#1c1a17", "$description": "Primary text + dark mode anchor. Maps to legacy --dark / --fg1",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.186 0.005 65)" } }
    },
    "primary": {
      "0":   { "$value": "#fafaff", "$description": "Pale violet anchor",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.985 0.005 285)" } },
      "10":  { "$value": "#ecebff", "$description": "Lightest tint. Maps to legacy --accent-subtle (#ECEAFF, ΔE 0.4)",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.945 0.025 285)" } },
      "20":  { "$value": "#d4d0ff", "$description": "Pale interactive surface",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.875 0.06 285)" } },
      "30":  { "$value": "#b6b0f8", "$description": "Mid-light interactive",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.778 0.1 285)" } },
      "40":  { "$value": "#8080f0", "$description": "Light accent. Replaces drift color used on contact-card icons",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.625 0.16 285)" } },
      "50":  { "$value": "#5c5cd4", "$description": "Mid accent — interpolation step",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.514 0.187 285)" } },
      "60":  { "$value": "#3d3db5", "$description": "Brand primary. Maps to legacy --accent",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.42 0.196 285)" } },
      "70":  { "$value": "#3030a0", "$description": "Brand primary pressed. Maps to legacy --accent-dark",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.371 0.187 285)" } },
      "80":  { "$value": "#25287a", "$description": "Dark primary",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.305 0.143 285)" } },
      "90":  { "$value": "#1a1f58", "$description": "Darker primary",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.249 0.106 285)" } },
      "100": { "$value": "#0f1638", "$description": "Darkest primary",
               "$extensions": { "com.joaojacinto.oklch": "oklch(0.187 0.073 285)" } }
    }
  },

  "dimension": {
    "space": {
      "$type": "dimension",
      "$description": "Spacing primitives — used for padding, margin, gap, inset. Even integers only (1px borders excepted, see border-width). Names = pixel values.",
      "0":   { "$value": "0px" },
      "2":   { "$value": "2px" },
      "4":   { "$value": "4px" },
      "6":   { "$value": "6px" },
      "8":   { "$value": "8px" },
      "10":  { "$value": "10px" },
      "12":  { "$value": "12px" },
      "16":  { "$value": "16px" },
      "20":  { "$value": "20px" },
      "24":  { "$value": "24px" },
      "32":  { "$value": "32px" },
      "40":  { "$value": "40px" },
      "48":  { "$value": "48px" },
      "56":  { "$value": "56px" },
      "64":  { "$value": "64px" },
      "80":  { "$value": "80px" },
      "96":  { "$value": "96px" },
      "128": { "$value": "128px" },
      "160": { "$value": "160px" },
      "200": { "$value": "200px" }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fixed widths/heights — icon sizes, fixed-width controls, hero photo, avatar.",
      "16":  { "$value": "16px", "$description": "Small icon" },
      "20":  { "$value": "20px", "$description": "Default icon (button icons, nav)" },
      "24":  { "$value": "24px", "$description": "Medium icon" },
      "32":  { "$value": "32px", "$description": "Large icon, calendar nav button" },
      "40":  { "$value": "40px", "$description": "Avatar small, control height" },
      "48":  { "$value": "48px", "$description": "Avatar medium, button tall" },
      "64":  { "$value": "64px", "$description": "Diamond marker, scroll-indicator" },
      "96":  { "$value": "96px", "$description": "Avatar large (about-cta avatar)" },
      "container-narrow": { "$value": "640px" },
      "container-default": { "$value": "1140px", "$description": "Maps to legacy --container" }
    },
    "radius": {
      "$type": "dimension",
      "none": { "$value": "0px" },
      "xs":   { "$value": "4px" },
      "sm":   { "$value": "8px",   "$description": "Maps to legacy --radius-sm" },
      "md":   { "$value": "12px" },
      "lg":   { "$value": "16px",  "$description": "Maps to legacy --radius-md" },
      "xl":   { "$value": "20px",  "$description": "Maps to legacy --radius-lg" },
      "2xl":  { "$value": "24px" },
      "full": { "$value": "999px", "$description": "Pill / circle. Replaces legacy --radius-full (100px) — 999 is more reliable for arbitrary widths" }
    },
    "border-width": {
      "$type": "dimension",
      "$description": "Stroke widths. Odd-integer rule excepted for 1px (canonical hairline).",
      "0": { "$value": "0px" },
      "1": { "$value": "1px",   "$description": "Canonical hairline. Used for nearly all borders." },
      "2": { "$value": "2px",   "$description": "Emphasis border (avatar ring, focus ring)" },
      "4": { "$value": "4px",   "$description": "Heavy outline (rare)" }
    }
  },

  "opacity": {
    "$type": "number",
    "$description": "Standard opacity stops as a percentage scale (0..100). Most rgba alpha values in components use color-mix() against these or stay raw in component tier.",
    "0":   { "$value": 0 },
    "5":   { "$value": 0.05 },
    "10":  { "$value": 0.1 },
    "20":  { "$value": 0.2 },
    "30":  { "$value": 0.3 },
    "40":  { "$value": 0.4 },
    "50":  { "$value": 0.5 },
    "60":  { "$value": 0.6 },
    "70":  { "$value": 0.7 },
    "80":  { "$value": 0.8 },
    "90":  { "$value": 0.9 },
    "95":  { "$value": 0.95 },
    "100": { "$value": 1 }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Neutral elevation primitives. Brand-tinted/signature shadows live in component tier.",
    "xs":   { "$value": { "color": "rgba(0,0,0,0.04)", "offsetX": "0px", "offsetY": "1px", "blur":  "2px", "spread": "0px" } },
    "sm":   { "$value": { "color": "rgba(0,0,0,0.04)", "offsetX": "0px", "offsetY": "1px", "blur":  "4px", "spread": "0px" }, "$description": "Maps to legacy --shadow-sm" },
    "md":   { "$value": { "color": "rgba(0,0,0,0.06)", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" }, "$description": "Maps to legacy --shadow-md" },
    "lg":   { "$value": { "color": "rgba(0,0,0,0.08)", "offsetX": "0px", "offsetY": "10px","blur": "32px", "spread": "0px" }, "$description": "Maps to legacy --shadow-lg" },
    "xl":   { "$value": { "color": "rgba(0,0,0,0.12)", "offsetX": "0px", "offsetY": "20px","blur": "48px", "spread": "0px" } },
    "inner":{ "$value": { "color": "rgba(0,0,0,0.06)", "offsetX": "0px", "offsetY": "1px", "blur":  "2px", "spread": "0px", "inset": true } }
  },

  "duration": {
    "$type": "duration",
    "$description": "Motion durations. Maps the 30+ unique values in the audit to a 6-stop ramp.",
    "instant": { "$value": "100ms", "$description": "Snappy feedback (focus rings, color shifts)" },
    "fast":    { "$value": "180ms", "$description": "Dominant short transition (hover, button states). Absorbs the 0.18s ×11 cluster" },
    "base":    { "$value": "240ms", "$description": "Standard motion (most card/element transitions). Absorbs 0.20-0.28s cluster" },
    "slow":    { "$value": "350ms", "$description": "Expressive transitions (card hover, image fade). Absorbs 0.35s ×6 cluster" },
    "slower":  { "$value": "550ms", "$description": "Reveal entry animations" },
    "slowest": { "$value": "650ms", "$description": "Hero reveal full-fold animations. Absorbs 0.65s reveal cluster" }
  },

  "easing": {
    "$type": "cubicBezier",
    "$description": "Easing curves. The 13× cubic-bezier(0.22,1,0.36,1) becomes the canonical `emphasized`. Animation-specific curves (line-refract) stay raw in component CSS.",
    "linear":      { "$value": [0, 0, 1, 1] },
    "in":          { "$value": [0.42, 0, 1, 1], "$description": "CSS ease-in equivalent" },
    "out":         { "$value": [0, 0, 0.58, 1], "$description": "CSS ease-out equivalent" },
    "in-out":      { "$value": [0.42, 0, 0.58, 1] },
    "standard":    { "$value": [0.4, 0, 0.2, 1], "$description": "Material standard. Absorbs the (0.4,0,0.2,1) ×7 cluster" },
    "emphasized":  { "$value": [0.22, 1, 0.36, 1], "$description": "Canonical site easing. Absorbs the (0.22,1,0.36,1) ×13 cluster" },
    "decelerate":  { "$value": [0, 0, 0.2, 1] },
    "accelerate":  { "$value": [0.4, 0, 1, 1] },
    "spring":      { "$value": [0.34, 1.56, 0.64, 1], "$description": "Bouncy elastic. Used for button press/tilt scale" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Hanken Grotesk", "DM Sans", "-apple-system", "system-ui", "sans-serif"], "$description": "Display headings. Maps to legacy --font-display" },
      "body":    { "$value": ["DM Sans", "Mona Sans", "-apple-system", "system-ui", "sans-serif"],     "$description": "Body text. Maps to legacy --font-body" },
      "mono":    { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "bold":     { "$value": 700 },
      "black":    { "$value": 900 }
    },
    "size": {
      "$type": "dimension",
      "$description": "T-shirt scale. Underlying values use clamp() for responsive type — tokens stay decoupled from pixel math.",
      "xs":   { "$value": "0.72rem",                                  "$description": "Eyebrow, smallest meta" },
      "sm":   { "$value": "0.84rem",                                  "$description": "Form labels, secondary meta" },
      "base": { "$value": "0.95rem",                                  "$description": "Default body" },
      "md":   { "$value": "1rem",                                     "$description": "Standard body" },
      "lg":   { "$value": "1.125rem",                                 "$description": "Body-lg, lead paragraphs. Maps to legacy --text-body-lg" },
      "xl":   { "$value": "1.4rem",                                   "$description": "h3. Maps to legacy --text-h3" },
      "2xl":  { "$value": "clamp(1.5rem, 2.2vw, 1.75rem)",            "$description": "Subhead. Maps to legacy --text-subhead" },
      "3xl":  { "$value": "clamp(1.8rem, 3vw, 2.6rem)",               "$description": "h2. Maps to legacy --text-h2" },
      "4xl":  { "$value": "clamp(2.5rem, 5vw, 4rem)",                 "$description": "h1. Maps to legacy --text-h1" },
      "5xl":  { "$value": "clamp(3.5rem, 8vw, 7rem)",                 "$description": "Display. Maps to legacy --text-display" }
    },
    "line-height": {
      "$type": "number",
      "heading":  { "$value": 1.15, "$description": "Display headings (h1, h2, hero)" },
      "tight":    { "$value": 1.2,  "$description": "Tight body, subheads" },
      "snug":     { "$value": 1.3,  "$description": "Card titles, multi-line labels" },
      "normal":   { "$value": 1.5,  "$description": "Default body" },
      "relaxed":  { "$value": 1.6,  "$description": "Long-form body, descriptions" },
      "loose":    { "$value": 1.75, "$description": "Generous body (taglines, hero)" }
    },
    "letter-spacing": {
      "$type": "dimension",
      "$description": "Letter-spacing aliases. Audit found 15 unique values — most are drift. Canonical 5-stop scale.",
      "tighter": { "$value": "-0.04em",  "$description": "Display headings" },
      "tight":   { "$value": "-0.025em", "$description": "h1, h2, large titles" },
      "snug":    { "$value": "-0.01em",  "$description": "Body headings, large text" },
      "normal":  { "$value": "0em" },
      "wide":    { "$value": "0.04em",   "$description": "Small caps, tag labels" },
      "wider":   { "$value": "0.06em",   "$description": "Eyebrows" }
    }
  },

  "z": {
    "$type": "number",
    "$description": "Z-index scale. 7 layers covers all current usage (audit: 0,1,2,99,100,200,9999).",
    "base":     { "$value": 0 },
    "raised":   { "$value": 1,    "$description": "Above local stacking context (canvas overlays, content z-1)" },
    "elevated": { "$value": 2,    "$description": "Above raised content (hero-inner over canvas)" },
    "sticky":   { "$value": 100,  "$description": "Sticky nav. Maps to legacy z-index: 100" },
    "overlay":  { "$value": 200,  "$description": "Modal backdrop (compose-backdrop)" },
    "modal":    { "$value": 300 },
    "toast":    { "$value": 9999, "$description": "Cursor-ball, brands tooltip" }
  },

  "bp": {
    "$type": "dimension",
    "$description": "Breakpoint primitives. Audit found 8 unique max-widths — most are drift. Canonical 4-stop scale; intermediate values (600/640/680/768) round to nearest.",
    "sm": { "$value": "480px",  "$description": "Mobile" },
    "md": { "$value": "720px",  "$description": "Tablet portrait" },
    "lg": { "$value": "900px",  "$description": "Tablet landscape / small desktop" },
    "xl": { "$value": "1024px", "$description": "Desktop" }
  },

  "background": {
    "$type": "color",
    "$description": "Page-level surfaces.",
    "page":            { "$value": "{color.neutral.40}", "$description": "Page bg" },
    "section-default": { "$value": "{color.neutral.40}" },
    "section-muted":   { "$value": "{color.neutral.50}" },
    "section-inverse": { "$value": "{color.neutral.100}", "$description": "Dark sections (footer, contact, error pages)" }
  },

  "surface": {
    "$type": "color",
    "$description": "Cards, panels, sheets — anything elevated above background.",
    "default": { "$value": "{color.neutral.20}", "$description": "Card on light bg" },
    "raised":  { "$value": "{color.neutral.10}" },
    "sunken":  { "$value": "{color.neutral.50}" },
    "overlay": { "$value": "{color.neutral.90}", "$description": "Modal sheet on dark scrim" }
  },

  "fill": {
    "brand": {
      "$type": "color",
      "default": { "$value": "{color.primary.60}" },
      "hover":   { "$value": "{color.primary.50}" },
      "active":  { "$value": "{color.primary.70}" },
      "subtle":  { "$value": "{color.primary.10}" }
    },
    "neutral": {
      "$type": "color",
      "default": { "$value": "{color.neutral.20}" },
      "subtle":  { "$value": "{color.neutral.10}" },
      "muted":   { "$value": "{color.neutral.50}" },
      "inverse": { "$value": "{color.neutral.90}" }
    }
  },

  "text": {
    "$type": "color",
    "primary":   { "$value": "{color.neutral.100}", "$description": "Highest-emphasis body text. Maps to --fg1" },
    "secondary": { "$value": "{color.neutral.80}",  "$description": "Maps to --fg2" },
    "tertiary":  { "$value": "{color.neutral.70}",  "$description": "Maps to --fg3" },
    "disabled":  { "$value": "{color.neutral.60}" },
    "brand":     { "$value": "{color.primary.60}" },
    "on-brand":  { "$value": "{color.neutral.10}", "$description": "Text on brand fills" },
    "inverse":   { "$value": "{color.neutral.30}", "$description": "Text on dark surfaces. Maps to --fg-inverse" },
    "inverse-muted": { "$value": "{color.neutral.30}", "$description": "Lower-emphasis text on dark — paired with opacity.65 in components" }
  },

  "border": {
    "$type": "color",
    "subtle":  { "$value": "{color.neutral.50}" },
    "default": { "$value": "{color.neutral.60}",  "$description": "Default visible border" },
    "strong":  { "$value": "{color.neutral.80}" },
    "focus":   { "$value": "{color.primary.60}" },
    "inverse": { "$value": "{color.neutral.30}", "$description": "Border on dark surfaces" }
  },

  "icon": {
    "$type": "color",
    "primary":   { "$value": "{color.neutral.100}" },
    "secondary": { "$value": "{color.neutral.80}" },
    "tertiary":  { "$value": "{color.neutral.70}" },
    "brand":     { "$value": "{color.primary.60}" },
    "on-brand":  { "$value": "{color.neutral.10}" }
  },

  "elevation": {
    "$type": "shadow",
    "0": { "$value": { "color": "rgba(0,0,0,0)", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" }, "$description": "No shadow" },
    "1": { "$value": "{shadow.xs}" },
    "2": { "$value": "{shadow.sm}" },
    "3": { "$value": "{shadow.md}" },
    "4": { "$value": "{shadow.lg}" },
    "5": { "$value": "{shadow.xl}" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "micro":      { "$value": "{duration.instant}", "$description": "Color/opacity feedback" },
      "short":      { "$value": "{duration.fast}",    "$description": "Hover, focus" },
      "standard":   { "$value": "{duration.base}",    "$description": "Default UI motion" },
      "expressive": { "$value": "{duration.slow}",    "$description": "Card transitions, image fade" },
      "reveal":     { "$value": "{duration.slowest}", "$description": "Section reveal entry" }
    },
    "easing": {
      "$type": "cubicBezier",
      "enter":     { "$value": "{easing.decelerate}" },
      "exit":      { "$value": "{easing.accelerate}" },
      "standard":  { "$value": "{easing.standard}" },
      "emphasized":{ "$value": "{easing.emphasized}" },
      "spring":    { "$value": "{easing.spring}" }
    }
  },

  "spacing": {
    "inset": {
      "$type": "dimension",
      "$description": "Padding inside components.",
      "xs": { "$value": "{dimension.space.6}" },
      "sm": { "$value": "{dimension.space.10}" },
      "md": { "$value": "{dimension.space.16}" },
      "lg": { "$value": "{dimension.space.24}" },
      "xl": { "$value": "{dimension.space.32}" }
    },
    "stack": {
      "$type": "dimension",
      "$description": "Vertical gap between siblings.",
      "xs": { "$value": "{dimension.space.4}" },
      "sm": { "$value": "{dimension.space.8}" },
      "md": { "$value": "{dimension.space.16}" },
      "lg": { "$value": "{dimension.space.24}" },
      "xl": { "$value": "{dimension.space.40}" }
    },
    "inline": {
      "$type": "dimension",
      "$description": "Horizontal gap between siblings.",
      "xs": { "$value": "{dimension.space.4}" },
      "sm": { "$value": "{dimension.space.8}" },
      "md": { "$value": "{dimension.space.12}" },
      "lg": { "$value": "{dimension.space.20}" },
      "xl": { "$value": "{dimension.space.32}" }
    },
    "section-gap": { "$type": "dimension", "$value": "clamp(80px, 10vw, 120px)", "$description": "Inter-section gap. Maps to legacy --section-gap" },
    "container-pad": { "$type": "dimension", "$value": "clamp(20px, 5vw, 40px)", "$description": "Container side padding. Maps to legacy --pad" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Semantic radius aliases.",
    "control": { "$value": "{dimension.radius.sm}",   "$description": "Buttons, inputs" },
    "card":    { "$value": "{dimension.radius.lg}" },
    "card-lg": { "$value": "{dimension.radius.2xl}", "$description": "Large feature cards (testimonial, case-card)" },
    "pill":    { "$value": "{dimension.radius.full}" },
    "media":   { "$value": "{dimension.radius.md}",  "$description": "Images, thumbnails" }
  },

  "typography": {
    "display": {
      "5xl": {
        "$type": "typography",
        "$value": {
          "fontFamily":    "{font.family.display}",
          "fontSize":      "{font.size.5xl}",
          "fontWeight":    "{font.weight.black}",
          "lineHeight":    "{font.line-height.heading}",
          "letterSpacing": "{font.letter-spacing.tighter}"
        }
      },
      "4xl": {
        "$type": "typography",
        "$value": {
          "fontFamily":    "{font.family.display}",
          "fontSize":      "{font.size.4xl}",
          "fontWeight":    "{font.weight.black}",
          "lineHeight":    "{font.line-height.heading}",
          "letterSpacing": "{font.letter-spacing.tight}"
        }
      }
    },
    "heading": {
      "3xl": {
        "$type": "typography",
        "$value": {
          "fontFamily":    "{font.family.display}",
          "fontSize":      "{font.size.3xl}",
          "fontWeight":    "{font.weight.black}",
          "lineHeight":    "{font.line-height.tight}",
          "letterSpacing": "{font.letter-spacing.tight}"
        }
      },
      "2xl": {
        "$type": "typography",
        "$value": {
          "fontFamily":    "{font.family.display}",
          "fontSize":      "{font.size.2xl}",
          "fontWeight":    "{font.weight.black}",
          "lineHeight":    "{font.line-height.tight}",
          "letterSpacing": "{font.letter-spacing.snug}"
        }
      },
      "xl": {
